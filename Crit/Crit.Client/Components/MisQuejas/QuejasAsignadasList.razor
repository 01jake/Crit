
@if (Quejas.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <h4 class="mt-3">@EmptyTitle</h4>
            <p class="text-muted">@EmptyMessage</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var queja in Quejas)
        {
            <div class="col-md-6 col-lg-4">
                <QuejaAsignadaCard Queja="@queja"
                                   IsProcessing="@IsProcessing"
                                   OnVerDetalle="@OnVerDetalle"
                                   OnCambiarEstatus="@OnCambiarEstatus" />
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<Queja> Quejas { get; set; } = new();
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No hay quejas asignadas";
    [Parameter] public string EmptyMessage { get; set; } = "Aún no tienes quejas asignadas para resolver";
    [Parameter] public EventCallback<Queja> OnVerDetalle { get; set; }
    [Parameter] public EventCallback<(int Id, EstatusQueja Estatus)> OnCambiarEstatus { get; set; }
}