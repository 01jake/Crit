@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block complaint-modal-shell" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1">@Title</h5>
                        <p class="text-muted small mb-0">@Description</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="OnClose"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <EditForm Model="Queja" OnValidSubmit="OnSubmit">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                                <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">
                                <i class="bi bi-check-circle me-2"></i>@SuccessMessage
                            </div>
                        }

                        <div class="p-3 mb-4 rounded-3 section-soft">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="complaint-label">Título *</label>
                                    <InputText class="form-control complaint-input" @bind-Value="Queja.Titulo" placeholder="Describe brevemente el problema" />
                                    <ValidationMessage For="@(() => Queja.Titulo)" class="complaint-validation" />
                                </div>

                                <div class="col-md-6">
                                    <label class="complaint-label">Categoría *</label>
                                    <InputSelect class="form-select complaint-input" @bind-Value="Queja.Categoria">
                                        <option value="">Selecciona una categoría</option>
                                        @foreach (var categoria in Categorias)
                                        {
                                            <option value="@categoria">@categoria</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => Queja.Categoria)" class="complaint-validation" />
                                </div>

                                <div class="col-md-6">
                                    <label class="complaint-label">Nombre del Cliente *</label>
                                    <InputText class="form-control complaint-input" @bind-Value="Queja.NombreCliente" placeholder="Tu nombre completo" />
                                    <ValidationMessage For="@(() => Queja.NombreCliente)" class="complaint-validation" />
                                </div>

                                <div class="col-md-6">
                                    <label class="complaint-label">Correo Electrónico *</label>
                                    <InputText class="form-control complaint-input" @bind-Value="Queja.Correo" type="email" placeholder="tu@correo.com" />
                                    <ValidationMessage For="@(() => Queja.Correo)" class="complaint-validation" />
                                </div>

                                <div class="col-md-6">
                                    <label class="complaint-label">Número de Afiliación</label>
                                    <InputText class="form-control complaint-input" @bind-Value="Queja.NumeroAfiliacion" placeholder="Opcional" />
                                </div>

                                <div class="col-md-6">
                                    <label class="complaint-label">Prioridad</label>
                                    <InputSelect class="form-select complaint-input" @bind-Value="Queja.Prioridad">
                                        <option value="@PrioridadQueja.Media">Media</option>
                                        <option value="@PrioridadQueja.Baja">Baja</option>
                                        <option value="@PrioridadQueja.Alta">Alta</option>
                                    </InputSelect>
                                </div>

                                <div class="col-12">
                                    <label class="complaint-label">Descripción *</label>
                                    <InputTextArea class="form-control complaint-input complaint-textarea"
                                                   rows="4"
                                                   @bind-Value="Queja.DescripcionQueja"
                                                   placeholder="Describe detalladamente el problema o sugerencia" />
                                    <ValidationMessage For="@(() => Queja.DescripcionQueja)" class="complaint-validation" />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn complaint-submit-btn py-3" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @SubmitButtonText
                            </button>

                            <button type="button" class="btn btn-light border text-muted fw-semibold" @onclick="OnClose">
                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .complaint-modal-shell {
        background-color: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(2px);
    }

    .section-soft {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .complaint-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 700;
        color: #475569;
        margin-bottom: 0.45rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .complaint-input {
        min-height: 48px;
        border-radius: 0.85rem;
        border: 1px solid #dbe2ea;
        background: #ffffff;
        padding: 0.8rem 1rem;
        box-shadow: none !important;
    }

        .complaint-input:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 0.22rem rgba(37,99,235,0.08) !important;
        }

    .complaint-textarea {
        min-height: 120px;
        resize: vertical;
    }

    .complaint-submit-btn {
        background: #1F2A44;
        color: #fff;
        border: none;
        border-radius: 0.95rem;
        font-weight: 700;
    }

        .complaint-submit-btn:hover,
        .complaint-submit-btn:focus,
        .complaint-submit-btn:active {
            background: #2a3a5e;
            color: #fff;
        }

    .complaint-validation {
        color: #dc2626;
        font-size: 0.82rem;
        margin-top: 0.35rem;
        display: block;
    }
</style>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Queja Queja { get; set; } = new();
    [Parameter] public string[] Categorias { get; set; } = Array.Empty<string>();
    [Parameter] public string Title { get; set; } = "Nueva Queja";
    [Parameter] public string Description { get; set; } = "Describe tu problema o sugerencia";
    [Parameter] public string SubmitButtonText { get; set; } = "Enviar Queja";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public string SuccessMessage { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
