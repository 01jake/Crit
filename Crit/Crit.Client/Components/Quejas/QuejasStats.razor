<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 stats-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">Pendientes</p>
                        <h3 class="fw-bold text-warning mb-1">@PendingCount</h3>
                        <small class="text-muted">Quejas por revisar</small>
                    </div>
                    <div class="stats-icon bg-warning-subtle text-warning">
                        <i class="bi bi-clock"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 stats-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">En Proceso</p>
                        <h3 class="fw-bold text-primary mb-1">@InProgressCount</h3>
                        <small class="text-muted">Quejas en seguimiento</small>
                    </div>
                    <div class="stats-icon bg-primary-subtle text-primary">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 stats-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">Resueltas</p>
                        <h3 class="fw-bold text-success mb-1">@ResolvedCount</h3>
                        <small class="text-muted">Casos cerrados</small>
                    </div>
                    <div class="stats-icon bg-success-subtle text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stats-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stats-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
    }

    .stats-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }
</style>

@code {
    [Parameter] public int PendingCount { get; set; }
    [Parameter] public int InProgressCount { get; set; }
    [Parameter] public int ResolvedCount { get; set; }
}
