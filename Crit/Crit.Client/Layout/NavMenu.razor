@using Crit.Client.Components
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject Crit.Client.Services.SesionHttpService SesionHttpService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="app-mobile-topbar d-lg-none">
    <a href="Dash" class="app-mobile-brand">
        <div class="app-mobile-logo-shell">
            <img src="images/polynex.png" alt="Polynex" class="app-mobile-logo" />
        </div>

        <div class="app-mobile-brand-copy">
            <span class="app-mobile-brand-title">Polynex</span>
            <span class="app-mobile-brand-subtitle">Panel de gestión</span>
        </div>
    </a>

    <button class="app-mobile-toggle"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#mobileMenu"
            aria-controls="mobileMenu"
            aria-label="Abrir menú">
        <i class="bi bi-list"></i>
    </button>
</div>

<aside class="nav-sidebar d-none d-lg-flex" aria-label="Navegación principal">
    @SidebarContent
</aside>

<div class="offcanvas offcanvas-start nav-mobile-offcanvas d-lg-none"
     tabindex="-1"
     id="mobileMenu"
     aria-labelledby="mobileMenuLabel">
    <div class="offcanvas-header nav-mobile-offcanvas-header">
        <div class="nav-mobile-offcanvas-brand" id="mobileMenuLabel">
            <div class="nav-mobile-offcanvas-logo-shell">
                <img src="images/polynex.png" alt="Polynex" class="nav-mobile-offcanvas-logo" />
            </div>

            <div class="nav-mobile-offcanvas-copy">
                <span class="nav-mobile-offcanvas-title">Polynex</span>
                <span class="nav-mobile-offcanvas-subtitle">Panel de gestión</span>
            </div>
        </div>

        <button type="button"
                class="btn-close shadow-none"
                data-bs-dismiss="offcanvas"
                aria-label="Cerrar">
        </button>
    </div>

    <div class="offcanvas-body nav-mobile-offcanvas-body">
        @SidebarContent
    </div>
</div>

@code {
    private string empresaNombre = "Cargando...";
    private string? currentUrl;

    private RenderFragment SidebarContent => @<div class="nav-shell">
        <div class="nav-header">
            <a href="Dash" class="nav-brand" @onclick="CerrarMenu">
                <div class="nav-brand-logo-shell">
                    <img src="images/polynex.png" alt="Polynex" class="nav-brand-logo" />
                </div>

                <div class="nav-brand-copy">
                    <span class="nav-brand-title">Polynex</span>
                    <span class="nav-brand-subtitle">Panel de gestión</span>
                </div>
            </a>
        </div>

        <div class="nav-scroll">
            <AuthorizeView>
                <Authorized Context="authContext">
                    <nav class="nav-group" aria-label="Principal">
                        <div class="nav-group-title">Principal</div>

                        <AuthorizeView Roles="Admin,Supervisor" Context="dashContext">
                            <NavLink class="nav-link-item" href="Dash" Match="NavLinkMatch.All" @onclick="CerrarMenu">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </NavLink>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin" Context="usersContext">
                            <NavLink class="nav-link-item" href="usuarios" Match="NavLinkMatch.All" @onclick="CerrarMenu">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </NavLink>
                        </AuthorizeView>
                    </nav>

                    <nav class="nav-group" aria-label="Operaciones">
                        <div class="nav-group-title">Operaciones</div>

                        <NavLink class="nav-link-item" href="clientes" @onclick="CerrarMenu">
                            <i class="bi bi-people-fill"></i>
                            <span>Clientes</span>
                        </NavLink>

                        <NavLink class="nav-link-item" href="proveedores" @onclick="CerrarMenu">
                            <i class="bi bi-truck"></i>
                            <span>Proveedores</span>
                        </NavLink>

                        <NavLink class="nav-link-item" href="productos" @onclick="CerrarMenu">
                            <i class="bi bi-box-seam-fill"></i>
                            <span>Productos</span>
                        </NavLink>

                        <NavLink class="nav-link-item" href="ventas" @onclick="CerrarMenu">
                            <i class="bi bi-cart-check-fill"></i>
                            <span>Ventas</span>
                        </NavLink>

                        <NavLink class="nav-link-item" href="cuentas-por-cobrar" @onclick="CerrarMenu">
                            <i class="bi bi-cash-coin"></i>
                            <span>CxC</span>
                        </NavLink>

                        <NavLink class="nav-link-item" href="inventario-por-almacen" @onclick="CerrarMenu">
                            <i class="bi bi-box-seam"></i>
                            <span>Almacén</span>
                        </NavLink>

                        <NavLink class="nav-link-item" href="kardex" @onclick="CerrarMenu">
                            <i class="bi bi-clipboard-data"></i>
                            <span>Kardex</span>
                        </NavLink>

                        <AuthorizeView Roles="Admin,Supervisor" Context="opsContext">
                            <NavLink class="nav-link-item" href="compras" @onclick="CerrarMenu">
                                <i class="bi bi-bag-fill"></i>
                                <span>Compras</span>
                            </NavLink>

                            <NavLink class="nav-link-item" href="cuentas-por-pagar" @onclick="CerrarMenu">
                                <i class="bi bi-wallet2"></i>
                                <span>CxP</span>
                            </NavLink>

                            <NavLink class="nav-link-item" href="caja" @onclick="CerrarMenu">
                                <i class="bi bi-safe2-fill"></i>
                                <span>Caja</span>
                            </NavLink>

                            <NavLink class="nav-link-item" href="traspasos" @onclick="CerrarMenu">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Traspaso</span>
                            </NavLink>

                            <NavLink class="nav-link-item" href="reabastecimiento" @onclick="CerrarMenu">
                                <i class="bi bi-box-arrow-in-down"></i>
                                <span>Reabastecimiento</span>
                            </NavLink>

                            <NavLink class="nav-link-item" href="gastos" @onclick="CerrarMenu">
                                <i class="bi bi-receipt-cutoff"></i>
                                <span>Gastos</span>
                            </NavLink>
                        </AuthorizeView>
                    </nav>

                    <nav class="nav-group" aria-label="Soporte">
                        <div class="nav-group-title">Soporte</div>

                        <NavLink class="nav-link-item" href="quejas" @onclick="CerrarMenu">
                            <i class="bi bi-chat-left-dots-fill"></i>
                            <span>Quejas</span>
                        </NavLink>
                    </nav>
                </Authorized>

                <NotAuthorized>
                    <div class="d-flex flex-column h-100 px-2">
                        <div class="saas-nav-group-title mt-2">Portal de Acceso</div>

                        <div class="saas-welcome-box p-2 mb-2 border rounded-2 bg-white shadow-sm">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-lock-fill text-primary" style="font-size: 1.1rem;"></i>
                                <div>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.75rem;">¿Listo?</h6>
                                    <p class="text-muted mb-0" style="font-size: 0.65rem;">Inicia sesión para gestionar.</p>
                                </div>
                            </div>
                        </div>

                        <NavLink class="saas-nav-link py-1 mb-1" href="Account/Login" @onclick="CerrarMenu">
                            <i class="bi bi-box-arrow-in-right" style="font-size: 0.9rem;"></i>
                            <span style="font-size: 0.8rem;">Ingresar</span>
                        </NavLink>

                        <NavLink class="saas-nav-link py-1" href="Account/Register" @onclick="CerrarMenu">
                            <i class="bi bi-person-plus" style="font-size: 0.9rem;"></i>
                            <span style="font-size: 0.8rem;">Crear cuenta administradora</span>
                        </NavLink>

                        <div class="mt-auto pb-2">
                            <div class="p-2 rounded-2 bg-light border border-dashed" style="font-size: 0.65rem;">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <i class="bi bi-question-circle text-secondary"></i>
                                    <span class="fw-bold">Ayuda</span>
                                </div>
                                <p class="text-muted mb-0">Contacta a soporte si tienes problemas.</p>
                            </div>
                            <div class="text-center mt-2" style="opacity: 0.5;">
                                <span style="font-size: 0.55rem; letter-spacing: 0.5px;">V 1.0.4 • Polynex</span>
                            </div>
                        </div>
                    </div>
                </NotAuthorized>

            </AuthorizeView>
        </div>

        <AuthorizeView>
            <Authorized Context="footerContext">
                <div class="nav-footer">
                    <div class="nav-footer-title">Cuenta activa</div>

                    <div class="nav-account-card">
                        <div class="nav-company-row">
                            <div class="nav-company-icon">
                                <i class="bi bi-building"></i>
                            </div>

                            <div class="overflow-hidden">
                                <div class="nav-company-name text-truncate">@empresaNombre</div>
                                <div class="nav-company-caption">Empresa actual</div>
                            </div>
                        </div>

                        <div class="nav-user-row">
                            <div class="nav-user-avatar">
                                @GetInitials(footerContext.User.Identity?.Name)
                            </div>

                            <div class="nav-user-copy">
                                <div class="nav-user-name text-truncate">@GetDisplayName(footerContext.User.Identity?.Name)</div>
                                <div class="nav-user-email text-truncate">@footerContext.User.Identity?.Name</div>
                            </div>

                            <div class="nav-user-actions">
                                <NavLink href="Account/Manage" class="nav-icon-button" title="Ajustes" @onclick="CerrarMenu">
                                    <i class="bi bi-gear"></i>
                                </NavLink>

                                <form action="Account/Logout" method="post" class="nav-logout-form">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                    <button type="submit" class="nav-icon-button nav-icon-button-danger" title="Salir">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChangedHandler;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sesion = await SesionHttpService.GetEmpresaActualAsync();

            empresaNombre = sesion is not null && !string.IsNullOrWhiteSpace(sesion.EmpresaNombre)
                ? sesion.EmpresaNombre
                : "Sin empresa";
        }
        catch
        {
            empresaNombre = "Sin empresa";
        }
    }

    private void OnLocationChangedHandler(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private string GetDisplayName(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "Usuario";

        return fullName.Split('@')[0];
    }

    private string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "US";

        var name = value.Split('@')[0];
        var parts = name.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";

        if (name.Length >= 2)
            return name[..2].ToUpperInvariant();

        return name.ToUpperInvariant();
    }

    private async Task CerrarMenu()
    {
        await JSRuntime.InvokeVoidAsync(
            "eval",
            "bootstrap.Offcanvas.getInstance(document.getElementById('mobileMenu'))?.hide();");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChangedHandler;
    }
}
