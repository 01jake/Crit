@page "/ventas"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor,Usuario")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ClienteHttpService ClienteHttpService
@inject VentaHttpService VentaHttpService
@inject ProductoHttpService ProductoHttpService
@inject PdfHttpService PdfHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Punto de Venta</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0">Punto de Venta</h2>
            <p class="text-muted small mb-0">Registra ventas y consulta operaciones recientes</p>
        </div>

        <div class="search-box-container sales-search-box">
            <i class="bi bi-search"></i>
            <input class="form-control" placeholder="Buscar por codigo o nombre..."
                   @bind="busquedaProducto" @bind:event="oninput" @onkeyup="BuscarProducto" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Catalogo de Productos</h6>
                        <small class="text-muted">Selecciona productos para agregarlos al ticket</small>
                    </div>
                    <span class="badge bg-light text-dark border">@productosFiltrados.Count producto(s)</span>
                </div>

                <div class="card-body pt-0">
                    <div class="row g-3">
                        @foreach (var p in productosFiltrados.Take(20))
                        {
                            <div class="col-12 col-sm-6 col-xl-4">
                                <button type="button" class="card border-0 shadow-sm w-100 text-start product-card h-100" @onclick="() => AgregarAlCarrito(p)">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="product-icon">
                                                <i class="bi bi-box-seam"></i>
                                            </div>
                                            <span class="stock-pill @(p.Stock > p.StockMinimo ? "stock-ok" : "stock-low")">
                                                Stock: @p.Stock
                                            </span>
                                        </div>

                                        <h6 class="fw-bold text-dark mb-1 text-truncate">@p.Nombre</h6>
                                        <div class="extra-small text-muted mb-3">@p.Codigo</div>

                                        <div class="d-flex justify-content-between align-items-end">
                                            <div>
                                                <div class="extra-small text-muted">Precio</div>
                                                <div class="fw-bold text-success">@p.PrecioVenta.ToString("C")</div>
                                            </div>
                                            <div class="extra-small text-muted">@p.Categoria</div>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-none d-lg-block card shadow-sm border-0 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">Ventas Recientes</h6>
                    <div class="search-box-container search-box-sm">
                        <i class="bi bi-search"></i>
                        <input class="form-control" placeholder="Folio o cliente..."
                               @bind="busquedaVenta" @bind:event="oninput" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f8fafc;">
                            <tr>
                                <th class="ps-4">Folio</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th class="text-center">Detalle</th>
                                <th class="text-center pe-4">PDF</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venta in VentasFiltradas)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">
                                        <a href="/ventas/@venta.Id" class="text-decoration-none text-dark">#@venta.NumeroVenta</a>
                                    </td>
                                    <td>@(venta.Cliente?.Nombre ?? "Publico General")</td>
                                    <td class="fw-bold text-success">@venta.Total.ToString("C")</td>
                                    <td class="text-center">
                                        <a class="btn btn-white btn-sm" href="/ventas/@venta.Id">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>
                                    </td>
                                    <td class="text-center pe-4">
                                        <button type="button" class="btn btn-white btn-sm" @onclick="() => DescargarPdfVenta(venta.Id)">
                                            <i class="bi bi-file-earmark-pdf text-danger"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-lg-none">
                @foreach (var venta in VentasFiltradas.Take(10))
                {
                    <div class="card shadow-sm border-0 mb-3 sales-mobile-card">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold text-dark">#@venta.NumeroVenta</div>
                                    <div class="small text-muted">@(venta.Cliente?.Nombre ?? "Publico General")</div>
                                </div>
                                <div class="fw-bold text-success">@venta.Total.ToString("C")</div>
                            </div>

                            <div class="d-flex gap-2 border-top pt-3">
                                <a class="btn btn-light-primary btn-sm flex-fill text-center" href="/ventas/@venta.Id">
                                    <i class="bi bi-eye me-1"></i>Detalle
                                </a>
                                <button type="button" class="btn btn-light-danger btn-sm flex-fill" @onclick="() => DescargarPdfVenta(venta.Id)">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 sticky-top sales-ticket-card">
                <div class="card-header text-white border-0 py-3 px-4" style="background-color: #1F2A44;">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-cart-check me-2"></i>Venta Actual
                        </h6>
                        <span class="badge bg-primary">@ventaActual.Detalles.Count SKU</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="saas-label">TIPO DE VENTA</label>
                            <select class="form-select saas-input" value="@tipoVenta" @onchange="OnTipoVentaChanged">
                                <option value="Contado">Contado</option>
                                <option value="Credito" disabled="@EsPublicoGeneralSeleccionado()">Credito</option>
                            </select>
                        </div>

                        @if (ventaActual.EsCredito)
                        {
                            <div class="col-12">
                                <label class="saas-label">DIAS DE CREDITO</label>
                                <input type="number" min="1" class="form-control saas-input" @bind="ventaActual.DiasCredito" />
                            </div>
                        }

                        <div class="col-12">
                            <label class="saas-label">CLIENTE</label>
                            <select class="form-select saas-input" value="@ventaActual.ClienteId" @onchange="OnClienteChanged">
                                <option value="0">Publico General</option>
                                @foreach (var c in clientes)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                            @if (EsPublicoGeneralSeleccionado())
                            {
                                <div class="extra-small text-muted mt-2">
                                    Publico General solo puede venderse de contado.
                                </div>
                            }
                        </div>
                    </div>

                    <div class="ticket-items-list mb-4">
                        @if (!ventaActual.Detalles.Any())
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-basket3 fs-1 text-muted"></i>
                                <p class="text-muted small mt-2 mb-0">El ticket esta vacio</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var d in ventaActual.Detalles)
                            {
                                <div class="ticket-item">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fw-semibold text-dark text-truncate me-2">@GetProductoNombre(d.ProductoId)</div>
                                        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-danger" @onclick="() => EliminarDelCarrito(d)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-0" @onclick="() => DisminuirCantidad(d)">-</button>
                                            <span class="fw-bold">@d.Cantidad</span>
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-0" @onclick="() => AumentarCantidad(d)">+</button>
                                        </div>
                                        <div class="fw-bold text-success">@d.Subtotal.ToString("C")</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="ticket-summary">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>@subtotal.ToString("C")</span>
                        </div>
                        <div class="summary-row">
                            <span>IVA (16%)</span>
                            <span>@iva.ToString("C")</span>
                        </div>
                        <div class="summary-total">
                            <span>Total</span>
                            <span>@total.ToString("C")</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn saas-btn-primary py-3 fw-bold" @onclick="ProcesarVenta"
                                disabled="@(!ventaActual.Detalles.Any() || procesando)">
                            <i class="bi bi-check2-circle me-2"></i>Consolidar Venta
                        </button>

                        <button class="btn btn-light border text-muted fw-semibold" @onclick="LimpiarCarrito">
                            Descartar venta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --polynex-navy: #1F2A44;
    }

    .saas-btn-primary {
        background-color: var(--polynex-navy);
        color: white;
        border: none;
        transition: all 0.2s;
    }

        .saas-btn-primary:hover {
            background-color: #2a3a5e;
            color: white;
            transform: translateY(-1px);
        }

    .search-box-container {
        position: relative;
    }

        .search-box-container i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 2;
        }

        .search-box-container .form-control {
            padding-left: 2.5rem;
            border-radius: 0.75rem;
        }

    .sales-search-box {
        width: 100%;
        max-width: 380px;
    }

    .search-box-sm {
        width: 240px;
    }

    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        background: #fff;
        border-radius: 1rem;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,.08) !important;
        }

    .product-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stock-pill {
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
    }

    .stock-ok {
        background: #dcfce7;
        color: #166534;
    }

    .stock-low {
        background: #fef3c7;
        color: #92400e;
    }

    .sales-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
    }

    .btn-light-primary {
        background: #eff6ff;
        color: #2563eb;
        border: none;
    }

        .btn-light-primary:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .btn-light-danger {
        background: #fef2f2;
        color: #dc2626;
        border: none;
    }

        .btn-light-danger:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    .btn-white {
        background: #fff;
        border: 1px solid #e2e8f0;
    }

        .btn-white:hover {
            background: #f8fafc;
        }

    .sales-ticket-card {
        top: 1rem;
    }

    .ticket-items-list {
        max-height: 320px;
        overflow-y: auto;
    }

    .ticket-item {
        padding: 0.85rem 0;
        border-bottom: 1px solid #eef2f7;
    }

    .ticket-summary {
        border-top: 1px solid #e5e7eb;
        padding-top: 1rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        color: #64748b;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px dashed #cbd5e1;
        font-size: 1.1rem;
        color: #0f172a;
    }

    .saas-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 0.35rem;
        display: block;
        text-transform: uppercase;
    }

    .saas-input {
