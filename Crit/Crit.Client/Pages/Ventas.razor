@page "/ventas"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ClienteHttpService ClienteHttpService
@inject VentaHttpService VentaHttpService
@inject ProductoHttpService ProductoHttpService
@inject PdfHttpService PdfHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Punto de Venta</PageTitle>

<div class="pos-container">
    @* --- ENCABEZADO --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <h2 class="page-title mb-0">Punto de Venta</h2>
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" placeholder="Buscar producto (F4)..."
                   @ref="searchBar" @bind="busquedaProducto" @bind:event="oninput" @onkeyup="BuscarProducto" />
        </div>
    </div>

    <div class="row g-4">

        @* 1. SECCIÓN PRODUCTOS (Arriba en Celular, Izquierda en PC) *@
        <div class="col-12 col-lg-8 order-1">
            <div class="products-grid-container">
                <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                    @foreach (var producto in productosFiltrados.Take(20))
                    {
                        <div class="col">
                            <div class="card h-100 producto-card" @onclick="() => AgregarAlCarrito(producto)">
                                <div class="card-body p-2 p-md-3">
                                    <div class="producto-icon d-none d-md-flex">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <h6 class="producto-nombre text-truncate">@producto.Nombre</h6>
                                    <span class="producto-codigo small text-muted">@producto.Codigo</span>
                                    <div class="d-flex justify-content-between align-items-end mt-2">
                                        <span class="producto-precio fw-bold text-primary">$@producto.PrecioVenta.ToString("N2")</span>
                                        <span class="badge-stock @(producto.Stock > producto.StockMinimo ? "stock-ok" : "stock-low")">
                                            @producto.Stock
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* 2. SECCIÓN CARRITO (Medio en Celular, Derecha en PC) *@
        @* En PC (lg), ocupa 4 columnas. En celular, ocupa las 12 *@
        <div class="col-12 col-lg-4 order-2 order-lg-2">
            <div class="carrito-sticky">
                <div class="card carrito-card shadow-lg border-0">
                    <div class="card-header text-white d-flex justify-content-between align-items-center bg-dark">
                        <h5 class="mb-0"><i class="bi bi-cart3 me-2"></i>Carrito</h5>
                        <span class="badge bg-white text-dark">@ventaActual.Detalles.Count</span>
                    </div>
                    <div class="card-body d-flex flex-column" style="min-height: 400px;">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Cliente</label>
                            <select class="form-select form-select-sm" @bind="ventaActual.ClienteId">
                                <option value="0">Cliente General</option>
                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.Id">@cliente.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="carrito-items-list flex-grow-1 overflow-auto" style="max-height: 350px;">
                            @if (!ventaActual.Detalles.Any())
                            {
                                <div class="empty-cart text-center py-4 text-muted">
                                    <i class="bi bi-cart-x fs-1"></i>
                                    <p>Carrito vacío</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var detalle in ventaActual.Detalles)
                                {
                                    <div class="item-fila border-bottom py-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="item-name small fw-bold text-truncate" style="max-width: 150px;">@GetProductoNombre(detalle.ProductoId)</span>
                                            <span class="small text-primary fw-bold">$@detalle.Subtotal.ToString("N2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <div class="item-controls">
                                                <button class="btn btn-sm btn-light border" @onclick="() => DisminuirCantidad(detalle)">-</button>
                                                <span class="mx-2 small">@detalle.Cantidad</span>
                                                <button class="btn btn-sm btn-light border" @onclick="() => AumentarCantidad(detalle)">+</button>
                                            </div>
                                            <button class="btn btn-sm text-danger border-0" @onclick="() => EliminarDelCarrito(detalle)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="ticket-summary mt-3 p-3 bg-light rounded">
                            <div class="d-flex justify-content-between small">
                                <span>Subtotal:</span> <span>$@subtotal.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center my-1 small">
                                <span>Desc:</span>
                                <input type="number" class="form-control form-control-sm w-25 text-end" @bind="ventaActual.Descuento" @bind:event="oninput" @onchange="RecalcularTotales" />
                            </div>
                            <div class="d-flex justify-content-between fw-bold border-top pt-2 mt-2">
                                <span>TOTAL:</span> <span class="text-primary">$@total.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button class="btn btn-primary btn-lg" @onclick="ProcesarVenta"
                                    disabled="@(procesando || !ventaActual.Detalles.Any())">
                                @(procesando ? "PROCESANDO..." : "CONSOLIDAR VENTA")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 3. TABLA DE VENTAS RECIENTES (Abajo en Celular, Izquierda en PC) *@
        <div class="col-12 col-lg-8 order-3 order-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <h5 class="mb-0 fw-bold text-dark">Ventas Recientes</h5>
                    <div class="input-group input-group-sm w-100" style="max-width: 300px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-filter"></i></span>
                        <input type="text" class="form-control border-start-0 bg-light"
                               placeholder="Folio o cliente..." @bind="busquedaVenta" @bind:event="oninput" />
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Folio</th>
                                    <th>Cliente</th>
                                    <th>Total</th>
                                    <th class="text-center">PDF</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var venta in VentasFiltradas)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">#@venta.NumeroVenta</td>
                                        <td><div class="text-truncate" style="max-width: 120px;">@(venta.Cliente?.Nombre ?? "Público General")</div></td>
                                        <td class="fw-bold text-primary">$@venta.Total.ToString("N2")</td>
                                        <td class="text-center">
                                            <button class="btn btn-link text-danger p-0" @onclick="() => DescargarPdfVenta(venta.Id)">
                                                <i class="bi bi-file-earmark-pdf fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@code {
    private List<Cliente> clientes = new();
    private List<Producto> productos = new();
    private List<Producto> productosFiltrados = new();
    private List<Venta> ventasRecientes = new();
    private Venta ventaActual = new();
    private ElementReference searchBar;

    private string busquedaProducto = "";
    private string busquedaVenta = ""; // Variable para el buscador de folios
    private bool procesando = false;
    private decimal tasaIva = 0.16m;

    // Propiedades calculadas
    private decimal subtotal => ventaActual.Detalles.Sum(d => d.Subtotal);
    private decimal iva => (subtotal - ventaActual.Descuento) * tasaIva;
    private decimal total => subtotal - ventaActual.Descuento + iva;

    // Lógica de filtrado de la tabla inferior (Folio o Nombre Cliente)
    private IEnumerable<Venta> VentasFiltradas =>
        string.IsNullOrWhiteSpace(busquedaVenta)
            ? ventasRecientes
            : ventasRecientes.Where(v =>
                v.NumeroVenta.ToString().Contains(busquedaVenta) ||
                (v.Cliente?.Nombre?.Contains(busquedaVenta, StringComparison.OrdinalIgnoreCase) ?? false)
            );

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        InicializarVenta();
    }

    private async Task CargarDatos()
    {
        clientes = (await ClienteHttpService.GetClientesActivosAsync()).ToList();
        productos = (await ProductoHttpService.GetProductosActivosAsync()).ToList();
        productosFiltrados = productos;
        ventasRecientes = (await VentaHttpService.GetVentasRecientesAsync(20)).ToList();
    }

    private void InicializarVenta()
    {
        ventaActual = new Venta
        {
            Fecha = DateTime.Now,
            Estado = "Completada",
            Detalles = new List<DetalleVenta>(),
            Descuento = 0
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await searchBar.FocusAsync();
    }

    private void BuscarProducto()
    {
        if (string.IsNullOrWhiteSpace(busquedaProducto))
        {
            productosFiltrados = productos;
        }
        else
        {
            productosFiltrados = productos.Where(p =>
                p.Nombre.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase) ||
                p.Codigo.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private void AgregarAlCarrito(Producto producto)
    {
        if (producto.Stock <= 0) return;

        var detalleExistente = ventaActual.Detalles.FirstOrDefault(d => d.ProductoId == producto.Id);
        if (detalleExistente != null)
        {
            if (detalleExistente.Cantidad < producto.Stock)
            {
                detalleExistente.Cantidad++;
                detalleExistente.Subtotal = detalleExistente.Cantidad * detalleExistente.PrecioUnitario;
            }
        }
        else
        {
            ventaActual.Detalles.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                Producto = producto,
                Cantidad = 1,
                PrecioUnitario = producto.PrecioVenta,
                Subtotal = producto.PrecioVenta
            });
        }
        RecalcularTotales();
    }

    private void AumentarCantidad(DetalleVenta detalle)
    {
        var producto = productos.FirstOrDefault(p => p.Id == detalle.ProductoId);
        if (producto != null && detalle.Cantidad < producto.Stock)
        {
            detalle.Cantidad++;
            detalle.Subtotal = detalle.Cantidad * detalle.PrecioUnitario;
            RecalcularTotales();
        }
    }

    private void DisminuirCantidad(DetalleVenta detalle)
    {
        if (detalle.Cantidad > 1)
        {
            detalle.Cantidad--;
            detalle.Subtotal = detalle.Cantidad * detalle.PrecioUnitario;
        }
        else
        {
            ventaActual.Detalles.Remove(detalle);
        }
        RecalcularTotales();
    }

    private void EliminarDelCarrito(DetalleVenta detalle)
    {
        ventaActual.Detalles.Remove(detalle);
        RecalcularTotales();
    }

    private async Task DescargarPdfVenta(int ventaId)
    {
        try { await PdfHttpService.DescargarVentaPdfAsync(ventaId); }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"Error PDF: {ex.Message}"); }
    }

    private void RecalcularTotales()
    {
        ventaActual.Subtotal = subtotal;
        ventaActual.IVA = iva;
        ventaActual.Total = total;
        StateHasChanged();
    }

    private async Task ProcesarVenta()
    {
        try
        {
            if (!ventaActual.Detalles.Any()) return;

            procesando = true;
            ventaActual.Subtotal = subtotal;
            ventaActual.IVA = iva;
            ventaActual.Total = total;
            ventaActual.Fecha = DateTime.Now;

            var result = await VentaHttpService.CreateVentaAsync(ventaActual);
            if (result != null)
            {
                await CargarDatos();
                InicializarVenta();
                busquedaProducto = "";
                await searchBar.FocusAsync();
            }
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}"); }
        finally { procesando = false; }
    }

    private void LimpiarCarrito() => InicializarVenta();

    private string GetProductoNombre(int productoId) =>
        productos.FirstOrDefault(p => p.Id == productoId)?.Nombre ?? "Producto";
}