@page "/ventas"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ClienteHttpService ClienteHttpService
@inject VentaHttpService VentaHttpService
@inject ProductoHttpService ProductoHttpService
@inject PdfHttpService PdfHttpService
@inject AlmacenHttpService AlmacenHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Punto de Venta</PageTitle>

<div class="pos-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Punto de Venta</h2>
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" placeholder="Buscar producto (F4)..."
                   @ref="searchBar" @bind="busquedaProducto" @bind:event="oninput" @onkeyup="BuscarProducto" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="products-grid-container">
                <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3">
                    @foreach (var p in productosFiltrados.Take(20))
                    {
                        <div class="col">
                            <div class="card h-100 producto-card" @onclick="() => AgregarAlCarrito(p)">
                                <div class="card-body">
                                    <div class="producto-icon bg-soft-primary">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <h6 class="producto-nombre">@p.Nombre</h6>
                                    <span class="producto-codigo">@p.Codigo</span>
                                    <div class="d-flex justify-content-between align-items-end mt-3">
                                        <span class="producto-precio text-dark">$@p.PrecioVenta.ToString("N2")</span>
                                        <span class="badge-stock @(p.Stock > p.StockMinimo ? "stock-ok" : "stock-low")">
                                            Stock: @p.Stock
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <h5 class="mb-0 fw-bold text-dark">Ventas Recientes</h5>
                    <div class="input-group input-group-sm w-100" style="max-width: 300px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-filter"></i></span>
                        <input type="text" class="form-control border-start-0 bg-light"
                               placeholder="Folio o cliente..." @bind="busquedaVenta" @bind:event="oninput" />
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Folio</th>
                                    <th>Cliente</th>
                                    <th>Total</th>
                                    <th class="text-center">Detalle</th>
                                    <th class="text-center">PDF</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var venta in VentasFiltradas)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">
                                            <a href="/ventas/@venta.Id" class="text-decoration-none text-dark">
                                                #@venta.NumeroVenta
                                            </a>
                                        </td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 120px;">
                                                @(venta.Cliente?.Nombre ?? "Público General")
                                            </div>
                                        </td>
                                        <td class="fw-bold text-primary">$@venta.Total.ToString("N2")</td>
                                        <td class="text-center">
                                            <a class="btn btn-sm btn-outline-primary" href="/ventas/@venta.Id" title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-link text-danger p-0" @onclick="() => DescargarPdfVenta(venta.Id)">
                                                <i class="bi bi-file-earmark-pdf fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card carrito-card shadow-lg border-0">
                <div class="card-header text-white d-flex justify-content-between align-items-center bg-dark">
                    <h5 class="mb-0"><i class="bi bi-cart-check me-2"></i>Venta Actual</h5>
                    <span class="badge bg-primary">@ventaActual.Detalles.Count SKU</span>
                </div>
                <div class="card-body d-flex flex-column" style="min-height: 550px;">

                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">TIPO DE VENTA</label>
                            <select class="form-select form-select-sm" value="@tipoVenta" @onchange="OnTipoVentaChanged">
                                <option value="Contado">Contado</option>
                                <option value="Credito">Crédito</option>
                            </select>
                        </div>

                        @if (ventaActual.EsCredito)
                        {
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">DÍAS DE CRÉDITO</label>
                                <input type="number" min="1" class="form-control form-control-sm" @bind="ventaActual.DiasCredito" />
                            </div>
                        }

                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">ALMACÉN</label>
                            <select class="form-select border-primary-subtle" @bind="ventaActual.AlmacenId">
                                <option value="">Seleccionar Almacén...</option>
                                @foreach (var a in almacenes)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">CLIENTE</label>
                            <select class="form-select border-primary-subtle" @bind="ventaActual.ClienteId">
                                <option value="0">Público General</option>
                                @foreach (var c in clientes)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="carrito-items-list flex-grow-1">
                        @if (!ventaActual.Detalles.Any())
                        {
                            <div class="empty-cart text-center p-4">
                                <i class="bi bi-basket3 fs-1 text-muted"></i>
                                <p class="text-muted mt-2">El ticket está vacío</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var d in ventaActual.Detalles)
                            {
                                <div class="item-compra-fila">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="item-name fw-bold">@GetProductoNombre(d.ProductoId)</span>
                                        <button class="btn-delete-item text-danger border-0 bg-transparent" @onclick="() => EliminarDelCarrito(d)"><i class="bi bi-x fs-5"></i></button>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => DisminuirCantidad(d)">-</button>
                                            <span class="fw-bold">@d.Cantidad</span>
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => AumentarCantidad(d)">+</button>
                                        </div>
                                        <span class="fw-bold text-primary">$@d.Subtotal.ToString("N2")</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="ticket-summary mt-3 border-top pt-3">
                        <div class="summary-row d-flex justify-content-between mb-1">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold">$@subtotal.ToString("N2")</span>
                        </div>
                        <div class="summary-row d-flex justify-content-between mb-1">
                            <span class="text-muted">IVA (16%)</span>
                            <span class="fw-bold">$@iva.ToString("N2")</span>
                        </div>
                        <div class="summary-total mt-2 d-flex justify-content-between fw-bolder fs-5 text-dark">
                            <span>TOTAL</span>
                            <span>$@total.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-primary btn-lg shadow-sm" @onclick="ProcesarVenta"
                                disabled="@(!ventaActual.Detalles.Any() || procesando)">
                            <i class="bi bi-check2-circle me-2"></i>CONSOLIDAR VENTA
                        </button>
                        <button class="btn btn-link btn-sm text-muted text-decoration-none" @onclick="LimpiarCarrito">
                            Descartar venta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Cliente> clientes = new();
    private List<Producto> productos = new();
    private List<Producto> productosFiltrados = new();
    private List<Venta> ventasRecientes = new();
    private Venta ventaActual = new();
    private ElementReference searchBar;
    private string tipoVenta = "Contado";
    private string busquedaProducto = "";
    private string busquedaVenta = ""; 
    private bool procesando = false;
    private decimal tasaIva = 0.16m;
    private List<Almacen> almacenes = new();
    // Propiedades calculadas
    private decimal subtotal => ventaActual.Detalles.Sum(d => d.Subtotal);
    private decimal iva => (subtotal - ventaActual.Descuento) * tasaIva;
    private decimal total => subtotal - ventaActual.Descuento + iva;

    // Lógica de filtrado de la tabla inferior (Folio o Nombre Cliente)
    private IEnumerable<Venta> VentasFiltradas =>
        string.IsNullOrWhiteSpace(busquedaVenta)
            ? ventasRecientes
            : ventasRecientes.Where(v =>
                v.NumeroVenta.ToString().Contains(busquedaVenta) ||
                (v.Cliente?.Nombre?.Contains(busquedaVenta, StringComparison.OrdinalIgnoreCase) ?? false)
            );
    private async Task CargarDatos()
    {
        clientes = (await ClienteHttpService.GetClientesActivosAsync()).ToList();
        productos = (await ProductoHttpService.GetProductosActivosAsync()).ToList();
        productosFiltrados = productos;
        ventasRecientes = (await VentaHttpService.GetVentasRecientesAsync(20)).ToList();
        almacenes = (await AlmacenHttpService.GetActivosAsync()).ToList();
    }
    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        InicializarVenta();
    }


    private void InicializarVenta()
    {
       tipoVenta = "Contado";

    ventaActual = new Venta
    {
        Fecha = DateTime.Now,
        Estado = "Completada",
        AlmacenId = almacenes.Any() ? almacenes.First().Id : null,
        Detalles = new List<DetalleVenta>(),
        Descuento = 0,
        EsCredito = false,
        DiasCredito = null,
        MetodoPago = "PUE - Pago en una sola exhibición",
        FormaPago = "03 - Transferencia electrónica",
        UsoCFDI = "G03 - Gastos en general",
        Notas = string.Empty
    };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await searchBar.FocusAsync();
    }

    private void BuscarProducto()
    {
        if (string.IsNullOrWhiteSpace(busquedaProducto))
        {
            productosFiltrados = productos;
        }
        else
        {
            productosFiltrados = productos.Where(p =>
                p.Nombre.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase) ||
                p.Codigo.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private void AgregarAlCarrito(Producto producto)
    {
        if (producto.Stock <= 0) return;

        var detalleExistente = ventaActual.Detalles.FirstOrDefault(d => d.ProductoId == producto.Id);
        if (detalleExistente != null)
        {
            if (detalleExistente.Cantidad < producto.Stock)
            {
                detalleExistente.Cantidad++;
                detalleExistente.Subtotal = detalleExistente.Cantidad * detalleExistente.PrecioUnitario;
            }
        }
        else
        {
            ventaActual.Detalles.Add(new DetalleVenta
            {
                ProductoId = producto.Id,
                Producto = producto,
                Cantidad = 1,
                PrecioUnitario = producto.PrecioVenta,
                Subtotal = producto.PrecioVenta
            });
        }
        RecalcularTotales();
    }
    
    private void OnTipoVentaChanged(ChangeEventArgs e)
    {
        tipoVenta = e.Value?.ToString() ?? "Contado";
        ventaActual.EsCredito = tipoVenta == "Credito";

        if (!ventaActual.EsCredito)
        {
            ventaActual.DiasCredito = null;
        }
        else if (!ventaActual.DiasCredito.HasValue || ventaActual.DiasCredito <= 0)
        {
            ventaActual.DiasCredito = 30;
        }
    }
    private void AumentarCantidad(DetalleVenta detalle)
    {
        var producto = productos.FirstOrDefault(p => p.Id == detalle.ProductoId);
        if (producto != null && detalle.Cantidad < producto.Stock)
        {
            detalle.Cantidad++;
            detalle.Subtotal = detalle.Cantidad * detalle.PrecioUnitario;
            RecalcularTotales();
        }
    }

    private void DisminuirCantidad(DetalleVenta detalle)
    {
        if (detalle.Cantidad > 1)
        {
            detalle.Cantidad--;
            detalle.Subtotal = detalle.Cantidad * detalle.PrecioUnitario;
        }
        else
        {
            ventaActual.Detalles.Remove(detalle);
        }
        RecalcularTotales();
    }

    private void EliminarDelCarrito(DetalleVenta detalle)
    {
        ventaActual.Detalles.Remove(detalle);
        RecalcularTotales();
    }

    private async Task DescargarPdfVenta(int ventaId)
    {
        try { await PdfHttpService.DescargarVentaPdfAsync(ventaId); }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"Error PDF: {ex.Message}"); }
    }

    private void RecalcularTotales()
    {
        ventaActual.Subtotal = subtotal;
        ventaActual.IVA = iva;
        ventaActual.Total = total;
        StateHasChanged();
    }

    private async Task ProcesarVenta()
    {
        try
        {
            if (!ventaActual.Detalles.Any())
                return;

            if (ventaActual.EsCredito)
            {
                if (!ventaActual.AlmacenId.HasValue || ventaActual.AlmacenId <= 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un almacén para la venta.");
                    return;
                }
                if (ventaActual.ClienteId == 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un cliente para una venta a crédito.");
                    return;
                }

                if (!ventaActual.DiasCredito.HasValue || ventaActual.DiasCredito <= 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes indicar los días de crédito.");
                    return;
                }
            }

            procesando = true;
            ventaActual.Subtotal = subtotal;
            ventaActual.IVA = iva;
            ventaActual.Total = total;
            ventaActual.Fecha = DateTime.Now;

            var result = await VentaHttpService.CreateVentaAsync(ventaActual);

            if (result != null)
            {
                await CargarDatos();
                InicializarVenta();
                busquedaProducto = "";
                await searchBar.FocusAsync();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            procesando = false;
        }
    }


    private void LimpiarCarrito() => InicializarVenta();

    private string GetProductoNombre(int productoId) =>
        productos.FirstOrDefault(p => p.Id == productoId)?.Nombre ?? "Producto";
}