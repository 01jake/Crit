@page "/caja"
@using Crit.Client.Services
@using Crit.Shared.DTOs
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor,Usuario")]
@inject CajaHttpService CajaHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Control de Caja</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0" style="color: #1F2A44;">Control de Caja</h2>
            <p class="text-muted small mb-0">Monitorea apertura, cierre y flujo de efectivo diario</p>
        </div>

        <button class="btn saas-btn-primary shadow-sm px-4 py-2" @onclick="CargarDatos">
            <i class="bi bi-arrow-clockwise me-2"></i><span>Actualizar Panel</span>
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon @(resumen.CajaAbierta ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") me-3">
                            <i class="bi @(resumen.CajaAbierta ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Estado Actual</span>
                    </div>
                    <h3 class="fw-bold mb-0 @(resumen.CajaAbierta ? "text-success" : "text-danger")">
                        @(resumen.CajaAbierta ? "Abierta" : "Cerrada")
                    </h3>
                    <p class="text-muted small mb-0 mt-1">Turno del día</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-primary-subtle text-primary me-3">
                            <i class="bi bi-cash"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Monto Inicial</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-dark">@resumen.MontoInicial.ToString("C")</h3>
                    <p class="text-muted small mb-0 mt-1">Fondo fijo asignado</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-success-subtle text-success me-3">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Ingresos</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-success">@resumen.IngresosHoy.ToString("C")</h3>
                    <p class="text-muted small mb-0 mt-1">Entradas del turno</p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-danger-subtle text-danger me-3">
                            <i class="bi bi-graph-down-arrow"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Egresos</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-danger">@resumen.EgresosHoy.ToString("C")</h3>
                    <p class="text-muted small mb-0 mt-1">Salidas del turno</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-bottom-0 py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-3 d-flex align-items-center justify-content-center @(resumen.CajaAbierta ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success")" style="width: 38px; height: 38px;">
                    <i class="bi @(resumen.CajaAbierta ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">@(resumen.CajaAbierta ? "Panel de Cierre" : "Panel de Apertura")</h6>
                    <small class="text-muted">@(resumen.CajaAbierta ? "Realiza el corte y cierra el turno actual" : "Inicia un nuevo turno con fondo inicial")</small>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            @if (!resumen.CajaAbierta)
            {
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="saas-label">MONTO INICIAL</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">$</span>
                            <input type="number" class="form-control saas-input" placeholder="0.00" @bind="apertura.MontoInicial" />
                        </div>
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="saas-label">OBSERVACIONES</label>
                        <input class="form-control saas-input" placeholder="Ej. Fondo para cambio..." @bind="apertura.Observaciones" />
                    </div>

                    <div class="col-12 col-md-3 d-grid">
                        <button class="btn btn-success py-3 fw-bold shadow-sm" @onclick="AbrirCaja">
                            <i class="bi bi-unlock-fill me-2"></i>Abrir Caja
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="saas-label">MONTO FINAL</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">$</span>
                            <input type="number" class="form-control saas-input" placeholder="0.00" @bind="cierre.MontoFinal" />
                        </div>
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="saas-label">OBSERVACIONES DE ARQUEO</label>
                        <input class="form-control saas-input" placeholder="Ej. Diferencia por redondeo..." @bind="cierre.Observaciones" />
                    </div>

                    <div class="col-12 col-md-3 d-grid">
                        <button class="btn btn-danger py-3 fw-bold shadow-sm" @onclick="CerrarCaja">
                            <i class="bi bi-lock-fill me-2"></i>Cerrar Caja
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-0 text-dark">Movimientos del Turno</h6>
                <small class="text-muted">Entradas y salidas registradas en caja</small>
            </div>
            <div class="text-muted small">Actualizado: @DateTime.Now.ToString("HH:mm")</div>
        </div>

        @if (movimientos == null || !movimientos.Any())
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-cash-stack fs-1 text-muted mb-3"></i>
                <h5 class="fw-bold text-dark">Sin movimientos</h5>
                <p class="text-muted mb-0">No hay movimientos registrados en el turno actual.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th class="ps-4">Fecha / Hora</th>
                            <th>Tipo</th>
                            <th>Origen</th>
                            <th>Concepto</th>
                            <th class="text-end">Monto</th>
                            <th class="text-end pe-4">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mov in movimientos)
                        {
                            <tr>
                                <td class="ps-4 small text-dark">
                                    @mov.Fecha.ToString("dd/MM/yyyy") <span class="text-muted ms-1">@mov.Fecha.ToString("HH:mm")</span>
                                </td>
                                <td>
                                    <span class="status-badge @(mov.Tipo == "Ingreso" ? "status-active" : "status-danger")">
                                        @mov.Tipo
                                    </span>
                                </td>
                                <td class="small fw-medium text-dark">@mov.Origen</td>
                                <td class="small text-muted" style="max-width: 280px;">@mov.Concepto</td>
                                <td class="text-end fw-bold @(mov.Tipo == "Ingreso" ? "text-success" : "text-danger")">
                                    @(mov.Tipo == "Ingreso" ? "+" : "-")@mov.Monto.ToString("N2")
                                </td>
                                <td class="text-end pe-4 fw-bold text-dark">@mov.SaldoPosterior.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="d-lg-none">
        @if (movimientos == null || !movimientos.Any())
        {
            <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                <i class="bi bi-cash-stack fs-1 text-muted mb-3"></i>
                <h5 class="fw-bold text-dark">Sin movimientos</h5>
                <p class="text-muted mb-0">No hay movimientos registrados en el turno actual.</p>
            </div>
        }
        else
        {
            @foreach (var mov in movimientos)
            {
                <div class="card shadow-sm border-0 mb-3 cash-mobile-card">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-bold text-dark">@mov.Origen</div>
                                <div class="extra-small text-muted">@mov.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <span class="status-badge @(mov.Tipo == "Ingreso" ? "status-active" : "status-danger")">
                                @mov.Tipo
                            </span>
                        </div>

                        <div class="small text-muted mb-3">@mov.Concepto</div>

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="text-muted extra-small">Monto</div>
                                <div class="fw-bold @(mov.Tipo == "Ingreso" ? "text-success" : "text-danger")">
                                    @(mov.Tipo == "Ingreso" ? "+" : "-")@mov.Monto.ToString("N2")
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-muted extra-small">Saldo</div>
                                <div class="fw-bold text-dark">@mov.SaldoPosterior.ToString("C")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    :root {
        --polynex-navy: #1F2A44;
    }

    .saas-btn-primary {
        background-color: var(--polynex-navy);
        color: white;
        border: none;
        transition: all 0.2s;
    }

    .saas-btn-primary:hover {
        background-color: #2a3a5e;
        color: white;
        transform: translateY(-1px);
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.4rem;
    }

    .stat-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
    }

    .saas-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 0.35rem;
        display: block;
        text-transform: uppercase;
    }

    .saas-input {
        border-radius: 0.75rem;
    }

    .status-badge {
        padding: 0.25rem 0.6rem;
        border-radius: 50rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-danger {
        background-color: #fee2e2;
        color: #b91c1c;
    }

    .cash-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
        transition: transform 0.2s;
    }

    .cash-mobile-card:active {
        transform: scale(0.98);
    }

    .extra-small {
        font-size: 0.75rem;
    }

    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }

    .table thead th {
        font-weight: 600;
        border-top: none;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .input-group-text {
        border-right: none;
    }
</style>

@code {
    private CajaResumenDto resumen = new();
    private List<CajaMovimiento> movimientos = new();
    private AperturaCajaDto apertura = new();
    private CierreCajaDto cierre = new();

    protected override async Task LoadDataAsync()
    {
        await CargarDatos();
    }

    protected override bool ShouldRetryInitialLoad()
        => resumen is null || (!resumen.CajaAbierta && movimientos.Count == 0);

    private async Task CargarDatos()
    {
        try
        {
            resumen = await CajaHttpService.GetResumenAsync();
            movimientos = await CajaHttpService.GetMovimientosAsync();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al cargar datos: {ex.Message}");
        }
    }

    private async Task AbrirCaja()
    {
        if (apertura.MontoInicial <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "El monto inicial debe ser mayor a cero.");
            return;
        }

        var ok = await CajaHttpService.AbrirCajaAsync(apertura);

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo abrir caja.");
            return;
        }

        apertura = new AperturaCajaDto();
        await CargarDatos();
    }

    private async Task CerrarCaja()
    {
        if (cierre.MontoFinal < 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "El monto final no puede ser negativo.");
            return;
        }

        var ok = await CajaHttpService.CerrarCajaAsync(cierre);

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo cerrar caja.");
            return;
        }

        cierre = new CierreCajaDto();
        await CargarDatos();
    }
}
