@page "/usuarios"
@using System.ComponentModel.DataAnnotations
@using Crit.Client.Services
@using Crit.Shared.Models
@inject UsuariosHttpService UsuariosHttpService
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject IJSRuntime JSRuntime

<PageTitle>Usuarios - Polynex</PageTitle>

<div class="container-fluid py-4 saas-page-container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1e293b;">Gestión de Usuarios</h2>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Administra los accesos y roles del equipo de trabajo.</p>
        </div>
        <button class="btn saas-btn-primary px-4 shadow-sm" @onclick="AbrirModalCrear">
            <i class="bi bi-plus-lg me-2"></i>Nuevo Usuario
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "saas-alert-error" : "saas-alert-success") shadow-sm mb-4" role="alert">
            <i class="bi @(esError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i> @mensaje
        </div>
    }

    <div class="card saas-card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 saas-table">
                    <thead>
                        <tr>
                            <th class="ps-4">NOMBRE Y CORREO</th>
                            <th>ROL</th>
                            <th>ESTADO</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    Cargando directorio...
                                </td>
                            </tr>
                        }
                        else if (!usuarios.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-2 d-block mb-2 text-black-50"></i>
                                    No hay usuarios registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var usuario in usuarios)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle bg-light text-secondary fw-bold rounded-circle d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                                @(ObtenerIniciales(usuario.NombreCompleto))
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@usuario.NombreCompleto</div>
                                                <div class="text-muted small">@usuario.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge saas-badge-role">@usuario.Rol</span>
                                    </td>
                                    <td>
                                        <span class="badge @(usuario.Activo ? "saas-badge-success" : "saas-badge-danger")">
                                            <i class="bi @(usuario.Activo ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                            @(usuario.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2 align-items-center">
                                            <select class="form-select form-select-sm saas-select-sm shadow-none" style="width: 130px;"
                                                    value="@usuario.Rol"
                                                    @onchange="async e => await CambiarRol(usuario, e.Value?.ToString())">
                                                <option value="Admin">Admin</option>
                                                <option value="Supervisor">Supervisor</option>
                                                <option value="Usuario">Usuario</option>
                                            </select>

                                            @if (usuario.Activo)
                                            {
                                                <button class="btn btn-sm saas-btn-outline-danger" title="Desactivar" @onclick="() => Desactivar(usuario)">
                                                    <i class="bi bi-power"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm saas-btn-outline-success" title="Activar" @onclick="() => Activar(usuario)">
                                                    <i class="bi bi-power"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (mostrarModalCrear)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block saas-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1">
                            <i class=" bi-person-plus"></i>
                            Registrar Nuevo Usuario
                            </h5>
                        <p class="text-muted small mb-0">Ingresa los datos para dar acceso al sistema.</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CerrarModalCrear"></button>
                </div>
                <div class="modal-body px-4 py-4">

                <EditForm Model="nuevoUsuario" OnValidSubmit="GuardarUsuario" FormName="crear-usuario">
                    <DataAnnotationsValidator />
                    <div class="p-3 mb-4 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="saas-label">NOMBRE COMPLETO</label>
                                <InputText class="form-control saas-input" @bind-Value="nuevoUsuario.NombreCompleto" placeholder="Ej. Juan Pérez" />
                                <ValidationMessage For="() => nuevoUsuario.NombreCompleto" class="saas-validation-message" />
                            </div>

                            <div class="col-12">
                                <label class="saas-label">CORREO ELECTRÓNICO</label>
                                <InputText class="form-control saas-input" @bind-Value="nuevoUsuario.Email" placeholder="correo@empresa.com" />
                                <ValidationMessage For="() => nuevoUsuario.Email" class="saas-validation-message" />
                            </div>

                            <div class="col-12">
                                <label class="saas-label">CONTRASEÑA</label>
                                <InputText type="password" class="form-control saas-input" @bind-Value="nuevoUsuario.Password" placeholder="••••••••" />
                                <ValidationMessage For="() => nuevoUsuario.Password" class="saas-validation-message" />
                            </div>

                            <div class="col-12">
                                <label class="saas-label">ROL DE ACCESO</label>
                                <InputSelect class="form-select saas-input" @bind-Value="nuevoUsuario.Rol">
                                    <option value="Usuario">Usuario (Acceso Básico)</option>
                                    <option value="Supervisor">Supervisor (Control Operativo)</option>
                                    <option value="Admin">Administrador (Acceso Total)</option>
                                </InputSelect>
                                <ValidationMessage For="() => nuevoUsuario.Rol" class="saas-validation-message" />
                            </div>
                        </div>
                    </div>
                        <div class="row g-3">
                        <button type="button" class="btn btn-light text-muted fw-semibold shadow-sm px-4" @onclick="CerrarModalCrear">Cancelar</button>
                        <button type="submit" class="btn saas-btn-primary px-4 shadow-sm" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Procesando...</span>
                            }
                            else
                            {
                                <span><i class="bi bi-check-lg me-2"></i>Crear Cuenta</span>
                            }
                        </button>
                    </div>
                 </EditForm>
                </div>

            </div>
        </div>
    </div>
}
