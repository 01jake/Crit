@code {
    private List<UsuarioEmpresaDto> usuarios = new();
    private CrearUsuarioFormModel nuevoUsuario = new();
    private bool cargando = true;
    private bool guardando;
    private bool mostrarModalCrear;
    private string? mensaje;
    private bool esError;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        try
        {
            cargando = true;
            usuarios = await UsuariosHttpService.GetUsuariosAsync();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar usuarios: {ex.Message}";
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalCrear()
    {
        nuevoUsuario = new CrearUsuarioFormModel
        {
            Rol = "Usuario"
        };
        mostrarModalCrear = true;
        mensaje = null;
    }

    private void CerrarModalCrear()
    {
        mostrarModalCrear = false;
    }

    private async Task GuardarUsuario()
    {
        try
        {
            guardando = true;
            mensaje = null;

            await UsuariosHttpService.CrearUsuarioAsync(new CrearUsuarioDto
            {
                NombreCompleto = nuevoUsuario.NombreCompleto,
                Email = nuevoUsuario.Email,
                Password = nuevoUsuario.Password,
                Rol = nuevoUsuario.Rol
            });

            mostrarModalCrear = false;
            mensaje = "Usuario creado correctamente.";
            esError = false;

            await CargarUsuarios();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al crear usuario: {ex.Message}";
            esError = true;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarRol(UsuarioEmpresaDto usuario, string? rol)
    {
        if (string.IsNullOrWhiteSpace(rol) || rol == usuario.Rol)
            return;

        try
        {
            await UsuariosHttpService.CambiarRolAsync(usuario.Id, new CambiarRolUsuarioDto
            {
                Rol = rol
            });

            mensaje = "Rol actualizado correctamente.";
            esError = false;

            await CargarUsuarios();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cambiar rol: {ex.Message}";
            esError = true;
        }
    }

    private async Task Desactivar(UsuarioEmpresaDto usuario)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Desactivar a {usuario.NombreCompleto}?");
        if (!confirmado)
            return;

        try
        {
            await UsuariosHttpService.DesactivarUsuarioAsync(usuario.Id);
            mensaje = "Usuario desactivado correctamente.";
            esError = false;

            await CargarUsuarios();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al desactivar usuario: {ex.Message}";
            esError = true;
        }
    }

    private async Task Activar(UsuarioEmpresaDto usuario)
    {
        try
        {
            await UsuariosHttpService.ActivarUsuarioAsync(usuario.Id);
            mensaje = "Usuario activado correctamente.";
            esError = false;

            await CargarUsuarios();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al activar usuario: {ex.Message}";
            esError = true;
        }
    }
    private static string ObtenerIniciales(string? nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto))
            return "--";

        var partes = nombreCompleto
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 0)
            return "--";

        if (partes.Length == 1)
            return partes[0].Length >= 2
                ? partes[0].Substring(0, 2).ToUpper()
                : partes[0].ToUpper();

        var primera = partes[0].Length > 0 ? partes[0][0].ToString() : "";
        var segunda = partes[1].Length > 0 ? partes[1][0].ToString() : "";

        var iniciales = (primera + segunda).ToUpper();

        return string.IsNullOrWhiteSpace(iniciales) ? "--" : iniciales;
    }


    private sealed class CrearUsuarioFormModel
    {
        [Required(ErrorMessage = "El nombre completo es obligatorio.")]
        public string NombreCompleto { get; set; } = string.Empty;

        [Required(ErrorMessage = "El correo es obligatorio.")]
        [EmailAddress(ErrorMessage = "Correo inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "El rol es obligatorio.")]
        public string Rol { get; set; } = "Usuario";
    }
}
