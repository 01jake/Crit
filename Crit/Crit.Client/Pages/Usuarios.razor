@page "/usuarios"
@using System.ComponentModel.DataAnnotations
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject UsuariosHttpService UsuariosHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Usuarios - Polynex</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="page-title mb-1" style="color: #1F2A44;">Gestión de Usuarios</h2>
            <p class="text-muted mb-0">Administra accesos, roles y estado operativo del equipo.</p>
        </div>

        <button class="btn saas-btn-primary px-4 shadow-sm" @onclick="AbrirModalCrear">
            <i class="bi bi-plus-lg me-2"></i>Nuevo Usuario
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "saas-alert-error" : "saas-alert-success") shadow-sm mb-4" role="alert">
            <i class="bi @(esError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>@mensaje
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom-0 py-3 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Directorio de Usuarios</h6>
                    <small class="text-muted">Control de accesos por rol dentro de la empresa</small>
                </div>
                <span class="badge bg-light text-dark border">@usuarios.Count usuario(s)</span>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                Cargando directorio...
            </div>
        }
        else if (!usuarios.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-2 d-block mb-2 text-black-50"></i>
                No hay usuarios registrados en el sistema.
            </div>
        }
        else
        {
            <div class="d-none d-lg-block">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 saas-table">
                        <thead style="background-color: #f8fafc;">
                            <tr>
                                <th class="ps-4">Nombre y Correo</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in usuarios)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle">
                                                @(ObtenerIniciales(usuario.NombreCompleto))
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@usuario.NombreCompleto</div>
                                                <div class="text-muted small">@usuario.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge saas-badge-role">@usuario.Rol</span>
                                    </td>
                                    <td>
                                        <span class="badge @(usuario.Activo ? "saas-badge-success" : "saas-badge-danger")">
                                            <i class="bi @(usuario.Activo ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                            @(usuario.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2 align-items-center">
                                            <select class="form-select form-select-sm saas-select-sm shadow-none"
                                                    style="width: 140px;"
                                                    value="@usuario.Rol"
                                                    @onchange="async e => await CambiarRol(usuario, e.Value?.ToString())">
                                                <option value="Admin">Admin</option>
                                                <option value="Supervisor">Supervisor</option>
                                                <option value="Usuario">Usuario</option>
                                            </select>

                                            @if (usuario.Activo)
                                            {
                                                <button class="btn btn-sm saas-btn-outline-danger" title="Desactivar" @onclick="() => Desactivar(usuario)">
                                                    <i class="bi bi-power"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm saas-btn-outline-success" title="Activar" @onclick="() => Activar(usuario)">
                                                    <i class="bi bi-power"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-lg-none p-3 pt-0">
                @foreach (var usuario in usuarios)
                {
                    <div class="card shadow-sm border-0 mb-3 user-mobile-card">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-3" style="max-width: 72%;">
                                    <div class="avatar-circle">
                                        @(ObtenerIniciales(usuario.NombreCompleto))
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark text-break">@usuario.NombreCompleto</h6>
                                        <div class="small text-muted text-break">@usuario.Email</div>
                                    </div>
                                </div>

                                <span class="badge @(usuario.Activo ? "saas-badge-success" : "saas-badge-danger")">
                                    @(usuario.Activo ? "Activo" : "Inactivo")
                                </span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="text-muted extra-small">Rol actual</div>
                                    <div class="small fw-semibold">@usuario.Rol</div>
                                </div>
                                <div class="col-6 text-end">
                                    <div class="text-muted extra-small">Acceso</div>
                                    <div class="small">@((usuario.Activo) ? "Habilitado" : "Bloqueado")</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="saas-label mb-1">Cambiar rol</label>
                                <select class="form-select saas-input"
                                        value="@usuario.Rol"
                                        @onchange="async e => await CambiarRol(usuario, e.Value?.ToString())">
                                    <option value="Admin">Admin</option>
                                    <option value="Supervisor">Supervisor</option>
                                    <option value="Usuario">Usuario</option>
                                </select>
                            </div>

                            <div class="d-flex gap-2 border-top pt-3">
                                @if (usuario.Activo)
                                {
                                    <button class="btn btn-light-danger btn-sm flex-fill" @onclick="() => Desactivar(usuario)">
                                        <i class="bi bi-power me-1"></i>Desactivar
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-light-success btn-sm flex-fill" @onclick="() => Activar(usuario)">
                                        <i class="bi bi-power me-1"></i>Activar
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (mostrarModalCrear)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block saas-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1">
                            <i class="bi bi-person-plus me-2 text-primary"></i>Registrar Nuevo Usuario
                        </h5>
                        <p class="text-muted small mb-0">Ingresa los datos para dar acceso al sistema.</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CerrarModalCrear"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <EditForm Model="nuevoUsuario" OnValidSubmit="GuardarUsuario" FormName="crear-usuario">
                        <DataAnnotationsValidator />

                        <div class="p-3 mb-4 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="saas-label">Nombre Completo</label>
                                    <InputText class="form-control saas-input" @bind-Value="nuevoUsuario.NombreCompleto" placeholder="Ej. Juan Pérez" />
                                    <ValidationMessage For="() => nuevoUsuario.NombreCompleto" class="saas-validation-message" />
                                </div>

                                <div class="col-12">
                                    <label class="saas-label">Correo Electrónico</label>
                                    <InputText class="form-control saas-input" @bind-Value="nuevoUsuario.Email" placeholder="correo@empresa.com" />
                                    <ValidationMessage For="() => nuevoUsuario.Email" class="saas-validation-message" />
                                </div>

                                <div class="col-12">
                                    <label class="saas-label">Contraseña</label>
                                    <InputText type="password" class="form-control saas-input" @bind-Value="nuevoUsuario.Password" placeholder="••••••••" />
                                    <ValidationMessage For="() => nuevoUsuario.Password" class="saas-validation-message" />
                                </div>

                                <div class="col-12">
                                    <label class="saas-label">Rol de Acceso</label>
                                    <InputSelect class="form-select saas-input" @bind-Value="nuevoUsuario.Rol">
                                        <option value="Usuario">Usuario (Acceso Básico)</option>
                                        <option value="Supervisor">Supervisor (Control Operativo)</option>
                                        <option value="Admin">Administrador (Acceso Total)</option>
                                    </InputSelect>
                                    <ValidationMessage For="() => nuevoUsuario.Rol" class="saas-validation-message" />
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn saas-btn-primary py-3 shadow-sm" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Procesando...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-check-lg me-2"></i>Crear Cuenta</span>
                                }
                            </button>

                            <button type="button" class="btn btn-light border text-muted fw-semibold" @onclick="CerrarModalCrear">
                                Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

