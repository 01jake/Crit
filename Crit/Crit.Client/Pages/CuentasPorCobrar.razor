@page "/cuentas-por-cobrar"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Crit.Shared.DTOs
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject Dashboardhttpservice Dashboardhttpservice
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject CuentaPorCobrarHttpService CuentaPorCobrarHttpService

<PageTitle>Cuentas por Cobrar</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0" style="color: #1F2A44;">Cuentas por Cobrar</h2>
            <p class="text-muted small mb-0">Gestión de créditos y saldos pendientes de clientes</p>
        </div>

        <button class="btn saas-btn-primary shadow-sm px-4 py-2" @onclick="CargarDatos">
            <i class="bi bi-arrow-clockwise me-2"></i><span>Actualizar Datos</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-primary-subtle text-primary me-3">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Total por Cobrar</span>
                    </div>
                    <h3 class="fw-bold mb-0">@totalPorCobrar.ToString("C")</h3>
                    <div class="text-muted extra-small mt-1">@pendientesCount factura(s) pendientes</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-danger-subtle text-danger me-3">
                            <i class="bi bi-exclamation-octagon"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Cartera Vencida</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-danger">@carteraVencida.ToString("C")</h3>
                    <div class="text-danger extra-small mt-1">@vencidasCount factura(s) fuera de plazo</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-success-subtle text-success me-3">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Cobrado este Mes</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-success">
                        @(clienteId.HasValue? cobradoEsteMesFiltrado.ToString("C") : resumenFinanzas.TotalCobradoMes.ToString("C"))
                    </h3>
                    <div class="text-muted extra-small mt-1">
                        @(clienteId.HasValue ? "Abonos del cliente en el mes" : $"{resumenFinanzas.CuentasPorCobrarPendientes} cuenta(s) activas")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-warning-subtle text-warning me-3">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Días Promedio Cobro</span>
                    </div>
                    <h3 class="fw-bold mb-0 text-warning">15 d</h3>
                    <div class="text-muted extra-small mt-1">Eficiencia de cobranza</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="search-box-container">
                        <i class="bi bi-search"></i>
                        <input class="form-control"
                               placeholder="Buscar cliente o folio..."
                               @bind="busqueda"
                               @bind:event="oninput" />
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <select class="form-select border-light-subtle" @bind="filtroEstado">
                        <option value="">Todos los estados</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Parcial">Parcial</option>
                        <option value="Pagada">Pagada</option>
                        <option value="Vencida">Vencida</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <select class="form-select border-light-subtle" @bind="filtroVencimiento">
                        <option value="">Todas las fechas</option>
                        <option value="vigentes">Solo Vigentes</option>
                        <option value="vencidas">Solo Vencidas</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 text-md-end text-muted small">
                    Mostrando: <strong>@CuentasFiltradas.Count()</strong> cuenta(s)
                </div>
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!CuentasFiltradas.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5 rounded-4">
            <i class="bi bi-clipboard-x fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold text-dark">Sin resultados</h5>
            <p class="text-muted mb-0">No se encontraron registros con los filtros aplicados.</p>
        </div>
    }
    else
    {
        <div class="d-none d-lg-block card shadow-sm border-0 overflow-hidden rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th class="ps-4">Cliente</th>
                            <th>Folio</th>
                            <th>Emisión</th>
                            <th>Vencimiento</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Abonado</th>
                            <th class="text-end">Saldo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center pe-4">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cuenta in CuentasFiltradas)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@cuenta.Cliente?.Nombre</div>
                                    <div class="extra-small text-muted">ID: @cuenta.ClienteId</div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-hash me-1"></i>
                                        @(string.IsNullOrWhiteSpace(cuenta.Folio) ? "S/F" : cuenta.Folio)
                                    </span>
                                </td>

                                <td class="small">@cuenta.FechaEmision.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (cuenta.FechaVencimiento.HasValue)
                                    {
                                        <span class="small @(cuenta.EstaVencida ? "text-danger fw-bold" : "")">
                                            @cuenta.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                        </span>

                                        @if (cuenta.EstaVencida)
                                        {
                                            <div class="extra-small text-danger">(@cuenta.DiasVencidos días)</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>

                                <td class="text-end fw-semibold">@cuenta.Total.ToString("C")</td>
                                <td class="text-end text-success">@cuenta.TotalPagado.ToString("C")</td>
                                <td class="text-end">
                                    <span class="fw-bold text-primary">@cuenta.Saldo.ToString("C")</span>
                                </td>

                                <td class="text-center">
                                    <span class="@ObtenerBadgeEstado(cuenta.Estado) py-2 px-3">
                                        @cuenta.Estado
                                    </span>
                                </td>

                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a class="btn btn-white btn-sm"
                                           href="/cuentas-por-cobrar/@cuenta.Id"
                                           title="Registrar abono">
                                            <i class="bi bi-plus-circle text-success"></i>
                                        </a>

                                        <a class="btn btn-white btn-sm"
                                           href="/cuentas-por-cobrar/@cuenta.Id"
                                           title="Ver detalle">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>

                                        <button class="btn btn-white btn-sm"
                                                title="Ver comprobante del último abono"
                                                @onclick="@(() => VerUltimoComprobante(cuenta))"
                                                disabled="@(cuenta.TotalPagado <= 0)">
                                            <i class="bi bi-file-earmark-text text-secondary"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-lg-none">
            @foreach (var cuenta in CuentasFiltradas)
            {
                <div class="card shadow-sm border-0 mb-3 receivable-mobile-card">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div style="max-width: 70%;">
                                <h6 class="fw-bold mb-0 text-dark text-break">@cuenta.Cliente?.Nombre</h6>
                                <span class="extra-small text-muted text-uppercase">
                                    @(string.IsNullOrWhiteSpace(cuenta.Folio) ? "S/F" : cuenta.Folio)
                                </span>
                            </div>
                            <span class="@ObtenerBadgeEstado(cuenta.Estado) py-2 px-3">
                                @cuenta.Estado
                            </span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="text-muted extra-small">Emisión</div>
                                <div class="small text-dark">@cuenta.FechaEmision.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-muted extra-small">Vencimiento</div>
                                @if (cuenta.FechaVencimiento.HasValue)
                                {
                                    <div class="small @(cuenta.EstaVencida ? "text-danger fw-bold" : "text-dark")">
                                        @cuenta.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted">-</div>
                                }
                            </div>

                            <div class="col-4">
                                <div class="text-muted extra-small">Total</div>
                                <div class="small fw-semibold text-dark">@cuenta.Total.ToString("C")</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="text-muted extra-small">Abonado</div>
                                <div class="small fw-semibold text-success">@cuenta.TotalPagado.ToString("C")</div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="text-muted extra-small">Saldo</div>
                                <div class="small fw-bold text-primary">@cuenta.Saldo.ToString("C")</div>
                            </div>
                        </div>

                        @if (cuenta.EstaVencida)
                        {
                            <div class="extra-small text-danger fw-bold mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>@cuenta.DiasVencidos días vencida
                            </div>
                        }

                        <div class="d-flex gap-2 border-top pt-3">
                            <a class="btn btn-light-primary btn-sm flex-fill text-center"
                               href="/cuentas-por-cobrar/@cuenta.Id">
                                <i class="bi bi-cash-coin me-1"></i>Pagar
                            </a>

                            <a class="btn btn-light-info btn-sm flex-fill text-center"
                               href="/cuentas-por-cobrar/@cuenta.Id">
                                <i class="bi bi-eye me-1"></i>Detalle
                            </a>

                            <button class="btn btn-light-secondary btn-sm px-3"
                                    @onclick="@(() => VerUltimoComprobante(cuenta))"
                                    disabled="@(cuenta.TotalPagado <= 0)">
                                <i class="bi bi-file-earmark-text"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    :root {
        --polynex-navy: #1F2A44;
    }

    .saas-btn-primary {
        background-color: var(--polynex-navy);
        color: white;
        border: none;
        transition: all 0.2s;
    }

        .saas-btn-primary:hover {
            background-color: #2a3a5e;
            color: white;
            transform: translateY(-1px);
        }

    .search-box-container {
        position: relative;
    }

        .search-box-container i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 2;
        }

        .search-box-container .form-control {
            padding-left: 2.5rem;
            border-radius: 0.75rem;
        }

    .stat-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 1.2rem;
    }

    .extra-small {
        font-size: 0.75rem;
    }

    .stat-card {
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .receivable-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
        transition: transform 0.2s;
        border-radius: 1rem;
    }

        .receivable-mobile-card:active {
            transform: scale(0.98);
        }

    .btn-light-primary {
        background: #eff6ff;
        color: #2563eb;
        border: none;
    }

        .btn-light-primary:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .btn-light-info {
        background: #ecfeff;
        color: #0891b2;
        border: none;
    }

        .btn-light-info:hover {
            background: #cffafe;
            color: #0e7490;
        }

    .btn-light-secondary {
        background: #f8fafc;
        color: #475569;
        border: none;
    }

        .btn-light-secondary:hover {
            background: #e2e8f0;
            color: #334155;
        }

    .btn-white {
        background: #fff;
        border: 1px solid #e2e8f0;
    }

        .btn-white:hover {
            background: #f8fafc;
        }

    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }
</style>

@code {
    private List<CuentaPorCobrar> cuentas = new();
    private bool cargando = true;
    private string? error;
    private FinanzasResumenDto resumenFinanzas = new();

    [SupplyParameterFromQuery]
    public int? clienteId { get; set; }

    private string busqueda = string.Empty;
    private string filtroEstado = string.Empty;
    private string filtroVencimiento = string.Empty;
    private decimal totalPorCobrar;
    private decimal carteraVencida;
    private int pendientesCount;
    private int vencidasCount;
    private decimal cobradoEsteMesFiltrado;

    protected override async Task LoadDataAsync()
    {
        await CargarDatos();
    }

    protected override bool ShouldRetryInitialLoad() => false;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsLoading)
        {
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        error = null;

        try
        {
            cuentas = await CuentaPorCobrarHttpService.GetAsync();
            resumenFinanzas = await Dashboardhttpservice.GetFinanzasResumenAsync();

            if (clienteId.HasValue && clienteId.Value > 0)
            {
                cuentas = cuentas.Where(x => x.ClienteId == clienteId.Value).ToList();
            }

            ActualizarResumen();
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void ActualizarResumen()
    {
        totalPorCobrar = cuentas.Where(x => x.Activa && x.Saldo > 0).Sum(x => x.Saldo);
        carteraVencida = cuentas.Where(x => x.Activa && x.EstaVencida && x.Saldo > 0).Sum(x => x.Saldo);
        pendientesCount = cuentas.Count(x => x.Activa && x.Saldo > 0);
        vencidasCount = cuentas.Count(x => x.Activa && x.EstaVencida && x.Saldo > 0);

        var inicioMes = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        cobradoEsteMesFiltrado = cuentas
            .SelectMany(x => x.Pagos ?? Enumerable.Empty<PagoCliente>())
            .Where(p => p.Activo && p.FechaPago >= inicioMes)
            .Sum(p => p.Monto);
    }

    private IEnumerable<CuentaPorCobrar> CuentasFiltradas =>
        cuentas
            .Where(x => string.IsNullOrWhiteSpace(busqueda) ||
                   (x.Cliente?.Nombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                   (x.Folio?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(x => string.IsNullOrWhiteSpace(filtroEstado) || x.Estado.Equals(filtroEstado, StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrWhiteSpace(filtroVencimiento) ||
                   (filtroVencimiento == "vigentes" && !x.EstaVencida) ||
                   (filtroVencimiento == "vencidas" && x.EstaVencida))
            .OrderByDescending(x => x.FechaEmision);

    private static string ObtenerBadgeEstado(string? estado) => estado switch
    {
        "Pagada" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "Parcial" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        "Vencida" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        "Cancelada" => "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary",
        _ => "badge rounded-pill text-bg-primary-subtle text-primary border border-primary"
    };

    private async Task VerUltimoComprobante(CuentaPorCobrar cuenta)
    {
        var ultimoPago = cuenta.Pagos?
            .Where(p => p.Activo)
            .OrderByDescending(p => p.FechaPago)
            .FirstOrDefault();

        if (ultimoPago != null)
        {
            var url = $"/api/CuentasPorCobrar/{cuenta.Id}/pagos/{ultimoPago.Id}/comprobante";
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Esta cuenta aún no tiene abonos registrados.");
        }
    }
}
