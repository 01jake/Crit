@page "/mis-quejas-asignadas"
@using Crit.Client.Components.MisQuejas
@using Crit.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject QuejaService QuejaService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Mis Quejas Asignadas</PageTitle>

<div class="min-vh-100 bg-light">
    <div class="container-fluid px-4 py-4">
        <!-- Header -->
        <div class="mb-4">
            <h1 class="h3 fw-bold text-dark mb-1">Quejas Asignadas a Mi</h1>
            <p class="text-muted">Gestiona y resuelve las quejas que te han sido asignadas</p>
        </div>

        <!-- Componente de Estadísticas -->
        <QuejasAsignadasStats 
            TotalCount="@quejasAsignadas.Count"
            EnProcesoCount="@enProcesoCount"
            ResueltasCount="@resueltasCount" />

        <!-- Alerta de Quejas Pendientes -->
        @if (pendientesCount > 0)
        {
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                <div>
                    <strong>¡Atención!</strong> Tienes <strong>@pendientesCount</strong> queja@(pendientesCount == 1 ? "" : "s") pendiente@(pendientesCount == 1 ? "" : "s") por iniciar.
                </div>
            </div>
        }

        <!-- Componente de Filtros -->
        <QuejasAsignadasFilters 
            SearchTerm="@searchTerm"
            FilterStatus="@filterStatus"
            OnSearchTermChanged="@HandleSearchChanged"
            OnFilterStatusChanged="@HandleFilterChanged" />

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-3 text-muted">Cargando quejas asignadas...</p>
            </div>
        }
        else
        {
            <!-- Componente de Lista -->
            <QuejasAsignadasList 
                Quejas="@quejasFiltradas"
                IsProcessing="@actualizando"
                EmptyTitle="@GetEmptyTitle()"
                EmptyMessage="@GetEmptyMessage()"
                OnVerDetalle="@VerDetalle"
                OnCambiarEstatus="@CambiarEstatus" />
        }

        <!-- Componente de Modal de Detalle -->
        <QuejaAsignadaDetalle 
            IsVisible="@mostrarDetalle"
            Queja="@quejaDetalle"
            IsProcessing="@actualizando"
            OnClose="@CerrarDetalle"
            OnCambiarEstatus="@CambiarEstatus" />
    </div>
</div>

@code {
    private List<Queja> quejasAsignadas = new();
    private List<Queja> quejasFiltradas = new();
    private Queja? quejaDetalle = null;
    
    private bool isLoading = true;
    private bool mostrarDetalle = false;
    private bool actualizando = false;
    private string searchTerm = string.Empty;
    private string filterStatus = "all";

    private int pendientesCount => quejasAsignadas.Count(q => q.Estatus == EstatusQueja.Pendiente);
    private int enProcesoCount => quejasAsignadas.Count(q => q.Estatus == EstatusQueja.Atendida);
    private int resueltasCount => quejasAsignadas.Count(q => q.Estatus == EstatusQueja.Cerrada);

    protected override async Task OnInitializedAsync()
    {
        await CargarQuejas();
    }

    private async Task CargarQuejas()
    {
        isLoading = true;
        quejasAsignadas = await QuejaService.GetMisQuejasAsignadasAsync();
        FiltrarQuejas();
        isLoading = false;
    }

    private void FiltrarQuejas()
    {
        quejasFiltradas = quejasAsignadas.Where(q =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchTerm) ||
                q.Titulo.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                q.DescripcionQueja.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                q.Categoria.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                q.NombreCliente.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);

            var matchesStatus = filterStatus == "all" ||
                GetEstatusText(q.Estatus).Equals(filterStatus, StringComparison.OrdinalIgnoreCase);

            return matchesSearch && matchesStatus;
        }).OrderBy(q => q.Estatus)
          .ThenByDescending(q => q.Prioridad)
          .ThenByDescending(q => q.Fecha)
          .ToList();
    }

    private async Task HandleSearchChanged(string newSearchTerm)
    {
        searchTerm = newSearchTerm;
        FiltrarQuejas();
        await Task.CompletedTask;
    }

    private async Task HandleFilterChanged(string newFilterStatus)
    {
        filterStatus = newFilterStatus;
        FiltrarQuejas();
        await Task.CompletedTask;
    }

    private void VerDetalle(Queja queja)
    {
        quejaDetalle = queja;
        mostrarDetalle = true;
    }

    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        quejaDetalle = null;
    }

    private async Task CambiarEstatus((int Id, EstatusQueja Estatus) data)
    {
        string mensajeConfirmacion = data.Estatus switch
        {
            EstatusQueja.Atendida => "¿Deseas iniciar el trabajo en esta queja?",
            EstatusQueja.Cerrada => "¿Estás seguro de marcar esta queja como resuelta?",
            _ => "¿Deseas cambiar el estado de esta queja?"
        };

        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm", mensajeConfirmacion);
        
        if (!confirmar) return;

        actualizando = true;

        bool exito = await QuejaService.UpdateQuejaStatusAsync(data.Id, data.Estatus);

        if (exito)
        {
            string mensajeExito = data.Estatus switch
            {
                EstatusQueja.Atendida => "Has iniciado el trabajo en esta queja",
                EstatusQueja.Cerrada => "Queja marcada como resuelta exitosamente",
                _ => "Estado actualizado exitosamente"
            };
            
            await JSRuntime.InvokeVoidAsync("alert", mensajeExito);
            CerrarDetalle();
            await CargarQuejas();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error al actualizar el estatus de la queja");
        }

        actualizando = false;
    }

    private string GetEmptyTitle()
    {
        return quejasFiltradas.Count == 0 && (searchTerm != string.Empty || filterStatus != "all")
            ? "No se encontraron resultados"
            : "No hay quejas asignadas";
    }

    private string GetEmptyMessage()
    {
        return quejasFiltradas.Count == 0 && (searchTerm != string.Empty || filterStatus != "all")
            ? "Intenta ajustar los filtros de búsqueda"
            : "Aún no tienes quejas asignadas para resolver";
    }

    private string GetEstatusText(EstatusQueja estatus) => estatus switch
    {
        EstatusQueja.Pendiente => "Pendiente",
        EstatusQueja.Atendida => "En Proceso",
        EstatusQueja.Cerrada => "Resuelta",
        _ => "Desconocido"
    };
}