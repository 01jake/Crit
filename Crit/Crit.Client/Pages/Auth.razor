@page "/auth"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

<PageTitle>Autenticación - Polynex</PageTitle>

<div class="auth-wrapper d-flex justify-content-center align-items-center vh-100">
    <div class="card auth-card shadow-lg border-0">
        <div class="card-body p-5 text-center">

            <AuthorizeView>
                <Authorized>
                    <div class="success-icon-container mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-2" style="color: #1F2A44;">Acceso Autorizado</h2>
                    <p class="text-muted mb-4">Tu identidad ha sido validada en el sistema</p>

                    <div class="user-badge p-3 mb-4 rounded-3" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                        <p class="mb-1 text-uppercase fw-bold x-small text-muted">Usuario Actual</p>
                        <h5 class="mb-0 text-dark">@context.User.Identity?.Name</h5>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="/Dash" class="btn btn-primary py-2 fw-bold shadow-sm">
                            Ir al Dashboard
                        </a>
                        <a href="/logout" class="btn btn-outline-danger btn-sm border-0 mt-2">
                            Cerrar Sesión
                        </a>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="fw-bold mb-2" style="color: #1F2A44;">Sesión Requerida</h2>
                    <p class="text-muted mb-4">No tienes los permisos necesarios para ver esta sección.</p>

                    <div class="d-grid shadow-sm">
                        <a href="/login" class="btn btn-primary py-2 fw-bold">
                            Iniciar Sesión
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
        <div class="card-footer bg-transparent border-0 pb-4 text-center">
            <small class="text-muted font-monospace">SISTEMA DE GESTIÓN V2.0</small>
        </div>
    </div>
</div>
