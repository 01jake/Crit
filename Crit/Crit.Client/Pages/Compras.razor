@page "/compras"
@using Crit.Client.Services
@using Crit.Shared.Models
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject ProveedorHttpService ProveedorService
@inject ProductoHttpService ProductoService
@inject CompraHttpService CompraService
@inject AlmacenHttpService AlmacenHttpService
@inject ReabastecimientoHttpService ReabastecimientoHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Órdenes de Compra | Gestión</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0">Órdenes de Compra</h2>
            <p class="text-muted small mb-0">Registra entradas de mercancía y consulta el historial reciente</p>
        </div>

        <div class="search-box-container purchase-search-box">
            <i class="bi bi-search"></i>
            <input type="text"
                   class="form-control"
                   placeholder="Buscar producto (F4)..."
                   @ref="searchBar"
                   @bind="busquedaProducto"
                   @bind:event="oninput"
                   @onkeyup="BuscarProducto" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Catálogo de Productos</h6>
                        <small class="text-muted">Selecciona productos para agregarlos a la orden</small>
                    </div>
                    <span class="badge bg-light text-dark border">@productosFiltrados.Count producto(s)</span>
                </div>

                <div class="card-body pt-0">
                    <div class="row g-3">
                        @foreach (var p in productosFiltrados.Take(20))
                        {
                            <div class="col-12 col-sm-6 col-xl-4">
                                <button type="button"
                                        class="card border-0 shadow-sm w-100 text-start product-card h-100"
                                        @onclick="@(() => AgregarProducto(p))">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="product-icon">
                                                <i class="bi bi-box-arrow-in-down"></i>
                                            </div>
                                            <span class="stock-pill @(p.Stock > p.StockMinimo ? "stock-ok" : "stock-low")">
                                                Stock: @p.Stock
                                            </span>
                                        </div>

                                        <h6 class="fw-bold text-dark mb-1 text-truncate">@p.Nombre</h6>
                                        <div class="extra-small text-muted mb-1">@p.Codigo</div>
                                        <div class="extra-small text-muted mb-3">@(string.IsNullOrWhiteSpace(p.Proveedor?.Nombre) ? "Sin proveedor" : p.Proveedor.Nombre)</div>

                                        <div class="d-flex justify-content-between align-items-end">
                                            <div>
                                                <div class="extra-small text-muted">Referencia</div>
                                                <div class="fw-bold text-dark">@p.PrecioCompra.ToString("C")</div>
                                            </div>
                                            <div class="extra-small text-muted text-truncate ms-2">@p.Categoria</div>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-none d-lg-block card shadow-sm border-0 overflow-hidden">
                <div class="card-header bg-white py-3 px-4">
                    <h6 class="fw-bold mb-0 text-dark">Historial de Compras</h6>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #f8fafc;">
                            <tr>
                                <th class="ps-4">Proveedor</th>
                                <th>Factura</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th class="text-center pe-4">Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in historial)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@c.Proveedor?.Nombre</div>
                                    </td>
                                    <td>
                                        <a href="/compras/@c.Id" class="text-decoration-none">
                                            <span class="badge-status">@c.SerieFactura-@c.FolioFactura</span>
                                        </a>
                                    </td>
                                    <td class="text-muted small">@c.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-primary">@c.Total.ToString("C")</td>
                                    <td class="text-center pe-4">
                                        <a class="btn btn-white btn-sm" href="/compras/@c.Id" title="Ver detalle">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-lg-none">
                @foreach (var c in historial.Take(10))
                {
                    <div class="card shadow-sm border-0 mb-3 purchase-mobile-card">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div style="max-width: 70%;">
                                    <h6 class="fw-bold mb-0 text-dark text-truncate">@(c.Proveedor?.Nombre ?? "Proveedor")</h6>
                                    <span class="extra-small text-muted text-uppercase">@c.SerieFactura-@c.FolioFactura</span>
                                </div>
                                <div class="fw-bold text-primary">@c.Total.ToString("C")</div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="text-muted extra-small">Fecha</div>
                                    <div class="small text-dark">@c.Fecha.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6 text-end">
                                    <div class="text-muted extra-small">Estado</div>
                                    <div class="small text-dark">@(string.IsNullOrWhiteSpace(c.Estado) ? "Registrada" : c.Estado)</div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 border-top pt-3">
                                <a class="btn btn-light-primary btn-sm flex-fill text-center" href="/compras/@c.Id">
                                    <i class="bi bi-eye me-1"></i>Detalle
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 sticky-top purchase-ticket-card">
                <div class="card-header text-white border-0 py-3 px-4" style="background-color: #1F2A44;">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-journal-plus me-2"></i>Nueva Orden
                        </h6>
                        <span class="badge bg-primary">@compraActual.Detalles.Count SKU</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="saas-label">TIPO DE COMPRA</label>
                            <select class="form-select saas-input" value="@tipoCompra" @onchange="OnTipoCompraChanged">
                                <option value="Contado">Contado</option>
                                <option value="Credito">Crédito</option>
                            </select>
                        </div>

                        @if (compraActual.EsCredito)
                        {
                            <div class="col-12">
                                <label class="saas-label">DÍAS DE CRÉDITO</label>
                                <input type="number" min="1" class="form-control saas-input" @bind="compraActual.DiasCredito" />
                            </div>
                        }

                        <div class="col-12">
                            <label class="saas-label">ALMACÉN</label>
                            <select class="form-select saas-input" @bind="compraActual.AlmacenId">
                                <option value="">Seleccionar almacén...</option>
                                @foreach (var a in almacenes)
                                {
                                    <option value="@a.Id">@a.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="saas-label">PROVEEDOR</label>
                            <input class="form-control saas-input"
                                   value="@GetProveedorActualNombre()"
                                   readonly />
                        </div>

                        <div class="col-6">
                            <label class="saas-label">SERIE</label>
                            <input class="form-control saas-input" @bind="compraActual.SerieFactura" readonly />
                        </div>

                        <div class="col-6">
                            <label class="saas-label">FOLIO</label>
                            <input class="form-control saas-input" @bind="compraActual.FolioFactura" readonly />
                        </div>

                        <div class="col-6">
                            <label class="saas-label">RFC PROVEEDOR</label>
                            <input class="form-control saas-input"
                                   value="@compraActual.RFCProveedor"
                                   readonly />
                        </div>

                        <div class="col-6">
                            <label class="saas-label">FECHA FACTURA</label>
                            <input type="date" class="form-control saas-input" @bind="compraActual.FechaFactura" />
                        </div>
                    </div>

                    <div class="ticket-items-list mb-4">
                        @if (!compraActual.Detalles.Any())
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-truck fs-1 text-muted"></i>
                                <p class="text-muted small mt-2 mb-0">No hay productos en la orden</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var d in compraActual.Detalles)
                            {
                                <div class="ticket-item">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fw-semibold text-dark text-truncate me-2">@GetProductoNombre(d.ProductoId)</div>
                                        <button type="button"
                                                class="btn btn-sm p-0 border-0 bg-transparent text-danger"
                                                @onclick="() => Eliminar(d)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="extra-small text-muted mb-1 d-block">Cantidad</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">Cant.</span>
                                                <input type="number"
                                                       class="form-control"
                                                       value="@d.Cantidad"
                                                       @oninput="e => OnCantidadChanged(d, e)" />
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <label class="extra-small text-muted mb-1 d-block">Costo</label>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">$</span>
                                                <input type="number"
                                                       class="form-control"
                                                       value="@d.PrecioUnitario"
                                                       @oninput="e => OnPrecioChanged(d, e)" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-end mt-2">
                                        <small class="text-muted">Subtotal: <strong>@d.Subtotal.ToString("C")</strong></small>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="ticket-summary">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>@subtotal.ToString("C")</span>
                        </div>
                        <div class="summary-row">
                            <span>IVA (16%)</span>
                            <span>@iva.ToString("C")</span>
                        </div>
                        <div class="summary-total">
                            <span>Total compra</span>
                            <span>@total.ToString("C")</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn saas-btn-primary py-3 fw-bold"
                                @onclick="GuardarCompra"
                                disabled="@(!PuedeGuardar)">
                            <i class="bi bi-cloud-arrow-up me-2"></i>Procesar entrada
                        </button>

                        <button class="btn btn-light border text-muted fw-semibold" @onclick="Limpiar">
                            Descartar orden
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
