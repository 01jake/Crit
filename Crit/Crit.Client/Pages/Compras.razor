@code {
    private List<Proveedor> proveedores = new();
    private List<Producto> productos = new();
    private List<Producto> productosFiltrados = new();
    private List<Compra> historial = new();
    private ElementReference searchBar;
    private string tipoCompra = "Contado";
    private Compra compraActual = new();
    private string busquedaProducto = "";
    private bool procesando = false;
    private List<Almacen> almacenes = new();
    private decimal subtotal => compraActual.Detalles.Sum(x => x.Subtotal);
    private decimal iva => subtotal * 0.16m;
    private decimal total => subtotal + iva;

    [SupplyParameterFromQuery] public int? productoId { get; set; }
    [SupplyParameterFromQuery] public int? almacenId { get; set; }
    [SupplyParameterFromQuery] public decimal? cantidad { get; set; }
    [SupplyParameterFromQuery] public int? ordenReabastecimientoId { get; set; }

    private bool PuedeGuardar =>
        compraActual.ProveedorId > 0 &&
        compraActual.Detalles.Any() &&
        !procesando;

    private async Task CargarDatos()
    {
        proveedores = await ProveedorService.GetAsync();
        productos = await ProductoService.GetProductosAsync();
        historial = await CompraService.GetHistorialAsync();
        almacenes = await AlmacenHttpService.GetActivosAsync();
        productosFiltrados = productos;
    }

    private void OnCantidadChanged(DetalleCompra d, ChangeEventArgs e)
    {
        var valString = e.Value?.ToString();
        if (int.TryParse(valString, out var val))
        {
            d.Cantidad = val;
            Recalcular();
        }
    }

    private void OnPrecioChanged(DetalleCompra d, ChangeEventArgs e)
    {
        var valString = e.Value?.ToString();
        if (decimal.TryParse(valString, NumberStyles.Any, CultureInfo.InvariantCulture, out var val))
        {
            d.PrecioUnitario = val;
            Recalcular();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await searchBar.FocusAsync();
        }
    }

    protected override async Task LoadDataAsync()
    {
        await CargarDatos();
        Inicializar();
        AplicarParametrosReabastecimiento();
    }

    protected override bool ShouldRetryInitialLoad()
        => !proveedores.Any() || !productos.Any() || !almacenes.Any();

    private void Inicializar()
    {
        tipoCompra = "Contado";
        compraActual = new Compra
        {
            Fecha = DateTime.Now,
            FechaFactura = DateTime.Today,
            AlmacenId = almacenes.Any() ? almacenes.First().Id : null,
            Detalles = new List<DetalleCompra>(),
            EsCredito = false,
            DiasCredito = null,
            ProveedorId = 0,
            RFCProveedor = string.Empty,
            SerieFactura = GenerarSerieFactura(),
            FolioFactura = GenerarFolioFactura()
        };
    }

    private void BuscarProducto()
    {
        if (string.IsNullOrWhiteSpace(busquedaProducto))
        {
            productosFiltrados = productos;
            return;
        }

        productosFiltrados = productos.Where(p =>
            p.Nombre.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase) ||
            p.Codigo.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private async Task AgregarProducto(Producto p)
    {
        if (!p.ProveedorId.HasValue || p.ProveedorId.Value <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "Este producto no tiene proveedor asignado. Asigna un proveedor antes de crear la compra.");
            return;
        }

        if (compraActual.ProveedorId <= 0)
        {
            compraActual.ProveedorId = p.ProveedorId.Value;

            var proveedor = proveedores.FirstOrDefault(x => x.Id == p.ProveedorId.Value);
            if (proveedor is not null)
            {
                compraActual.RFCProveedor = proveedor.RFC;
            }
        }
        else if (compraActual.ProveedorId != p.ProveedorId.Value)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "No puedes mezclar productos de distintos proveedores en la misma orden.");
            return;
        }

        var existente = compraActual.Detalles.FirstOrDefault(x => x.ProductoId == p.Id);

        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            compraActual.Detalles.Add(new DetalleCompra
            {
                ProductoId = p.Id,
                Cantidad = 1,
                PrecioUnitario = p.PrecioCompra,
                Subtotal = p.PrecioCompra
            });
        }

        Recalcular();
    }

    private void Eliminar(DetalleCompra d)
    {
        compraActual.Detalles.Remove(d);

        if (!compraActual.Detalles.Any())
        {
            compraActual.ProveedorId = 0;
            compraActual.RFCProveedor = string.Empty;
        }

        Recalcular();
    }

    private void Recalcular()
    {
        foreach (var d in compraActual.Detalles)
            d.Subtotal = d.Cantidad * d.PrecioUnitario;
    }

    private async Task GuardarCompra()
    {
        try
        {
            procesando = true;

            compraActual.Subtotal = subtotal;
            compraActual.IVA = iva;
            compraActual.Total = total;

            if (compraActual.EsCredito)
            {
                if (compraActual.ProveedorId <= 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes agregar productos con proveedor asignado para una compra a crédito.");
                    return;
                }

                if (!compraActual.DiasCredito.HasValue || compraActual.DiasCredito <= 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes indicar los días de crédito.");
                    return;
                }
            }

            var compraCreada = await CompraService.CrearAsync(compraActual);

            if (compraCreada is null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "No se pudo guardar la compra.");
                return;
            }

            if (ordenReabastecimientoId.HasValue && ordenReabastecimientoId.Value > 0)
            {
                var completada = await ReabastecimientoHttpService
                    .CompletarDesdeCompraAsync(ordenReabastecimientoId.Value, compraCreada.Id);

                if (!completada)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "La compra se guardó, pero no se pudo completar la orden de reabastecimiento.");
                }
            }

            await JSRuntime.InvokeVoidAsync("alert", "Compra guardada");
            busquedaProducto = "";
            await CargarDatos();
            Inicializar();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private void AplicarParametrosReabastecimiento()
    {
        if (almacenId.HasValue && almacenId > 0)
        {
            compraActual.AlmacenId = almacenId.Value;
        }

        if (productoId.HasValue && productoId > 0)
        {
            var producto = productos.FirstOrDefault(p => p.Id == productoId.Value);
            if (producto != null && !compraActual.Detalles.Any(x => x.ProductoId == producto.Id))
            {
                if (producto.ProveedorId.HasValue && producto.ProveedorId.Value > 0)
                {
                    compraActual.ProveedorId = producto.ProveedorId.Value;
                    var proveedor = proveedores.FirstOrDefault(x => x.Id == producto.ProveedorId.Value);
                    compraActual.RFCProveedor = proveedor?.RFC ?? string.Empty;
                }

                var cantidadFinal = cantidad.HasValue && cantidad.Value > 0
                    ? cantidad.Value
                    : 1;

                compraActual.Detalles.Add(new DetalleCompra
                {
                    ProductoId = producto.Id,
                    Cantidad = (int)cantidadFinal,
                    PrecioUnitario = producto.PrecioCompra,
                    Subtotal = cantidadFinal * producto.PrecioCompra
                });

                Recalcular();
            }
        }
    }

    private void OnTipoCompraChanged(ChangeEventArgs e)
    {
        tipoCompra = e.Value?.ToString() ?? "Contado";
        compraActual.EsCredito = tipoCompra == "Credito";

        if (!compraActual.EsCredito)
        {
            compraActual.DiasCredito = null;
        }
        else if (!compraActual.DiasCredito.HasValue || compraActual.DiasCredito <= 0)
        {
            compraActual.DiasCredito = 30;
        }
    }

    private void Limpiar()
    {
        Inicializar();
    }

    private string GetProductoNombre(int id)
    {
        return productos.FirstOrDefault(p => p.Id == id)?.Nombre ?? "";
    }

    private string GetProveedorActualNombre()
    {
        if (compraActual.ProveedorId <= 0)
            return "Se asignará al agregar el primer producto";

        return proveedores.FirstOrDefault(p => p.Id == compraActual.ProveedorId)?.Nombre
            ?? "Proveedor no encontrado";
    }

    private string GenerarSerieFactura() => "OC";

    private string GenerarFolioFactura() => $"OC-{DateTime.Now:yyyyMMddHHmmss}";
}
