@page "/compras"
@using Crit.Client.Services
@using Crit.Shared.Models
@using System.Globalization
@inject ProveedorHttpService ProveedorService
@inject ProductoHttpService ProductoService
@inject CompraHttpService CompraService
@inject IJSRuntime JSRuntime

<PageTitle>Órdenes de Compra | Gestión</PageTitle>

<div class="pos-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Órdenes de Compra</h2>
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control" placeholder="Buscar producto (F4)..."
                   @ref="searchBar" @bind="busquedaProducto" @bind:event="oninput" @onkeyup="BuscarProducto" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="products-grid-container">
                <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3">
                    @foreach (var p in productosFiltrados.Take(20))
                    {
                        <div class="col">
                            <div class="card h-100 producto-card" @onclick="() => AgregarProducto(p)">
                                <div class="card-body">
                                    <div class="producto-icon bg-soft-primary">
                                        <i class="bi bi-box-arrow-in-down"></i>
                                    </div>
                                    <h6 class="producto-nombre">@p.Nombre</h6>
                                    <span class="producto-codigo">@p.Codigo</span>
                                    <div class="d-flex justify-content-between align-items-end mt-3">
                                        <span class="producto-precio text-dark">Ref: $@p.PrecioCompra.ToString("N2")</span>
                                        <span class="badge-stock @(p.Stock > p.StockMinimo ? "stock-ok" : "stock-low")">
                                            Stock: @p.Stock
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Historial de Compras</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Proveedor</th>
                                    <th>Factura</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                    <th class="text-center">Detalle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in historial)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold">@c.Proveedor?.Nombre</td>

                                        <td>
                                            <a href="/compras/@c.Id" class="text-decoration-none">
                                                <span class="badge-status">@c.SerieFactura-@c.FolioFactura</span>
                                            </a>
                                        </td>

                                        <td>@c.Fecha.ToString("dd/MM/yyyy")</td>

                                        <td class="fw-bold text-primary">$@c.Total.ToString("N2")</td>

                                        <td class="text-center">
                                            <a class="btn btn-sm btn-outline-primary" href="/compras/@c.Id" title="Ver detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card carrito-card shadow-lg border-0">
                <div class="card-header text-white d-flex justify-content-between align-items-center bg-dark">
                    <h5 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Nueva Orden</h5>
                    <span class="badge bg-primary">@compraActual.Detalles.Count SKU</span>
                </div>
                <div class="card-body d-flex flex-column" style="min-height: 550px;">
                    
                    <div class="row g-2 mb-3">
                                                    <div class="col-12">
                                <label class="form-label small fw-bold text-muted">TIPO DE COMPRA</label>
                            <select class="form-select form-select-sm" value="@tipoCompra" @onchange="OnTipoCompraChanged">
                                <option value="Contado">Contado</option>
                                    <option value="Credito">Crédito</option>
                                </select>
                            </div>

                            @if (compraActual.EsCredito)
                            {
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-muted">DÍAS DE CRÉDITO</label>
                                    <input type="number" min="1" class="form-control form-control-sm" @bind="compraActual.DiasCredito" />
                                </div>
                            }
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">PROVEEDOR</label>
                            <select class="form-select border-primary-subtle" value="@compraActual.ProveedorId" @onchange="OnProveedorChanged">
                                <option value="0">Seleccionar Proveedor...</option>
                                @foreach (var p in proveedores)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <input class="form-control form-control-sm" placeholder="Serie" @bind="compraActual.SerieFactura" />
                        </div>
                        <div class="col-6">
                            <input class="form-control form-control-sm" placeholder="Folio" @bind="compraActual.FolioFactura" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">RFC PROVEEDOR</label>
                            <input class="form-control form-control-sm" @bind="compraActual.RFCProveedor" placeholder="RFC proveedor" />
                        </div>

                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">FECHA FACTURA</label>
                            <input type="date" class="form-control form-control-sm" @bind="compraActual.FechaFactura" />
                        </div>
                    </div>

                    <div class="carrito-items-list flex-grow-1">
                        @if (!compraActual.Detalles.Any())
                        {
                            <div class="empty-cart">
                                <i class="bi bi-truck"></i>
                                <p>No hay productos en la orden</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var d in compraActual.Detalles)
                            {
                                <div class="item-compra-fila">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="item-name">@GetProductoNombre(d.ProductoId)</span>
                                        <button class="btn-delete-item" @onclick="() => Eliminar(d)"><i class="bi bi-x"></i></button>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">Cant.</span>
                                            <input type="number" class="form-control" value="@d.Cantidad" 
                                                   @oninput="e => OnCantidadChanged(d, e)" />
                                        </div>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number" class="form-control" value="@d.PrecioUnitario" 
                                                   @oninput="e => OnPrecioChanged(d, e)" />
                                        </div>
                                    </div>
                                    <div class="text-end mt-1">
                                        <small class="text-muted">Subtotal: <strong>$@d.Subtotal.ToString("N2")</strong></small>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="ticket-summary mt-3">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>$@subtotal.ToString("N2")</span>
                        </div>
                        <div class="summary-row">
                            <span>IVA (16%)</span>
                            <span>$@iva.ToString("N2")</span>
                        </div>
                        <div class="summary-total mt-2">
                            <span>TOTAL COMPRA</span>
                            <span>$@total.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-primary btn-lg shadow-sm" @onclick="GuardarCompra"
                                disabled="@(!PuedeGuardar)">
                            <i class="bi bi-cloud-arrow-up me-2"></i>PROCESAR ENTRADA
                        </button>
                        <button class="btn btn-link btn-sm text-muted" @onclick="Limpiar">
                            Descartar orden
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    private List<Proveedor> proveedores = new();
    private List<Producto> productos = new();
    private List<Producto> productosFiltrados = new();
    private List<Compra> historial = new();
    private ElementReference searchBar;
    private string tipoCompra = "Contado";
    private Compra compraActual = new();
    private string busquedaProducto = "";
    private bool procesando = false;

    private decimal subtotal => compraActual.Detalles.Sum(x => x.Subtotal);
    private decimal iva => subtotal * 0.16m;
    private decimal total => subtotal + iva;

    private bool PuedeGuardar =>
        compraActual.ProveedorId > 0 &&
        compraActual.Detalles.Any() &&
        !procesando;

    private void OnCantidadChanged(DetalleCompra d, ChangeEventArgs e)
    {
        // Limpiamos el valor para evitar errores de parseo
        var valString = e.Value?.ToString();
        if (int.TryParse(valString, out var val))
        {
            d.Cantidad = val;
            Recalcular();
        }
    }
    private void OnProveedorChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var proveedorId))
        {
            compraActual.ProveedorId = proveedorId;

            var proveedor = proveedores.FirstOrDefault(p => p.Id == proveedorId);
            if (proveedor is not null)
            {
                compraActual.RFCProveedor = proveedor.RFC;
            }
        }
    }


    private void OnPrecioChanged(DetalleCompra d, ChangeEventArgs e)
    {
        var valString = e.Value?.ToString();
        if (decimal.TryParse(valString, NumberStyles.Any, CultureInfo.InvariantCulture, out var val))
        {
            d.PrecioUnitario = val;
            Recalcular();
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await searchBar.FocusAsync();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        Inicializar();
    }

    private async Task CargarDatos()
    {
        proveedores = await ProveedorService.GetAsync();
        productos = await ProductoService.GetProductosAsync();
        historial = await CompraService.GetHistorialAsync();

        productosFiltrados = productos;
    }

    private void Inicializar()
    {
        tipoCompra = "Contado";

        compraActual = new Compra
        {
            Fecha = DateTime.Now,
            FechaFactura = DateTime.Today,
            Detalles = new List<DetalleCompra>(),
            EsCredito = false,
            DiasCredito = null
        };
    }

    private void BuscarProducto()
    {
        productosFiltrados = productos.Where(p =>
            p.Nombre.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private void AgregarProducto(Producto p)
    {
        var existente = compraActual.Detalles.FirstOrDefault(x => x.ProductoId == p.Id);

        if (existente != null)
            existente.Cantidad++;
        else
            compraActual.Detalles.Add(new DetalleCompra
            {
                ProductoId = p.Id,
                Cantidad = 1,
                PrecioUnitario = p.PrecioCompra
            });

        Recalcular();
    }

    private void Eliminar(DetalleCompra d)
    {
        compraActual.Detalles.Remove(d);
        Recalcular();
    }

    private void Recalcular()
    {
        foreach (var d in compraActual.Detalles)
            d.Subtotal = d.Cantidad * d.PrecioUnitario;
    }

    private async Task GuardarCompra()
    {
        try
        {
            procesando = true;

            compraActual.Subtotal = subtotal;
            compraActual.IVA = iva;
            compraActual.Total = total;

            if (compraActual.EsCredito)
            {
                if (compraActual.ProveedorId <= 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un proveedor para una compra a crédito.");
                    return;
                }

                if (!compraActual.DiasCredito.HasValue || compraActual.DiasCredito <= 0)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Debes indicar los días de crédito.");
                    return;
                }
            }
            await CompraService.CrearAsync(compraActual);

            await JSRuntime.InvokeVoidAsync("alert", "Compra guardada");

            await CargarDatos();
            Inicializar();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }
    private void OnTipoCompraChanged(ChangeEventArgs e)
    {
        tipoCompra = e.Value?.ToString() ?? "Contado";
        compraActual.EsCredito = tipoCompra == "Credito";

        if (!compraActual.EsCredito)
        {
            compraActual.DiasCredito = null;
        }
        else if (!compraActual.DiasCredito.HasValue || compraActual.DiasCredito <= 0)
        {
            compraActual.DiasCredito = 30;
        }
    }

    private void Limpiar()
    {
        Inicializar();
    }

    private string GetProductoNombre(int id)
    {
        return productos.FirstOrDefault(p => p.Id == id)?.Nombre ?? "";
    }
}