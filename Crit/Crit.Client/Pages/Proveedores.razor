@page "/proveedores"
@using Crit.Client.Services
@using Crit.Shared.Models
@inject ProveedorHttpService ProveedorHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Directorio de Proveedores</PageTitle>

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-0">Gestión de Proveedores</h2>
            <p class="text-muted small">Administra tu red de suministro y datos fiscales</p>
        </div>

        <button class="btn btn-primary shadow-sm px-4" @onclick="MostrarModalNuevo">
            <i class="bi bi-plus-lg me-2"></i> Nuevo Proveedor
        </button>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="search-box-container">
                        <i class="bi bi-search"></i>
                        <input class="form-control" placeholder="Buscar por nombre, RFC o contacto..."
                               @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-light-subtle" @bind="filtroEstado">
                        <option value="todos">Todos los estados</option>
                        <option value="activos">Solo Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>
                <div class="col-md-3 text-end text-muted small">
                    Mostrando: <strong>@ProveedoresFiltrados.Count()</strong> proveedores
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-custom"></div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Proveedor / Razón Social</th>
                            <th>RFC</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th>Registro</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ProveedoresFiltrados)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@p.Nombre</div>
                                    <div class="text-muted extra-small">@p.RazonSocial</div>
                                </td>
                                <td><code class="text-primary fw-bold">@p.RFC</code></td>
                                <td>
                                    <div class="small"><i class="bi bi-envelope me-1"></i> @p.Email</div>
                                    <div class="small"><i class="bi bi-telephone me-1"></i> @p.Telefono</div>
                                </td>
                                <td>
                                    <span class="status-badge @(p.Activo ? "status-active" : "status-inactive")">
                                        @(p.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-muted small">@p.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <button class="btn btn-white btn-sm" title="Editar" @onclick="() => Editar(p)">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                        <button class="btn btn-white btn-sm" title="Eliminar" @onclick="() => Eliminar(p.Id)">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(proveedorActual.Id == 0 ? "bi-person-plus" : "bi-person-gear") me-2"></i>
                        @(proveedorActual.Id == 0 ? "Registrar Nuevo Proveedor" : "Actualizar Información")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
                </div>

                <div class="modal-body p-4">
                    <EditForm Model="proveedorActual" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <h6 class="section-title"><i class="bi bi-info-circle me-2"></i>Identificación</h6>
                                <div class="mb-3">
                                    <label class="form-label">Nombre Comercial *</label>
                                    <InputText class="form-control custom-input" @bind-Value="proveedorActual.Nombre" placeholder="Ej. Materiales del Norte" />
                                    <ValidationMessage For="@(() => proveedorActual.Nombre)" class="text-danger small" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Razón Social</label>
                                    <InputText class="form-control custom-input" @bind-Value="proveedorActual.RazonSocial" />
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">RFC</label>
                                        <InputText class="form-control custom-input text-uppercase" @bind-Value="proveedorActual.RFC" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Régimen Fiscal</label>
                                        <InputText class="form-control custom-input" @bind-Value="proveedorActual.RegimenFiscal" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="section-title"><i class="bi bi-person-lines-fill me-2"></i>Contacto</h6>
                                <div class="mb-3">
                                    <label class="form-label">Persona de Contacto</label>
                                    <InputText class="form-control custom-input" @bind-Value="proveedorActual.Contacto" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Correo Electrónico</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                        <InputText class="form-control custom-input" @bind-Value="proveedorActual.Email" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Teléfono / WhatsApp</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                        <InputText class="form-control custom-input" @bind-Value="proveedorActual.Telefono" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Dirección Fiscal / Bodega</label>
                                <InputTextArea class="form-control custom-input" @bind-Value="proveedorActual.Direccion" rows="2" />
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch p-2 bg-light rounded ps-5">
                                    <InputCheckbox class="form-check-input ms-0" @bind-Value="proveedorActual.Activo" id="chkActivo" />
                                    <label class="form-check-label ms-2 fw-bold" for="chkActivo">Proveedor Habilitado para Compras</label>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger-custom mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
                            </div>
                        }

                        <div class="modal-footer border-0 px-0 pb-0 mt-4">
                            <button type="button" class="btn btn-light-hover px-4" @onclick="Cerrar">Cancelar</button>
                            <button type="submit" class="btn btn-primary px-5 shadow" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-check-lg me-1"></i> Guardar Proveedor
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private List<Proveedor> proveedores = new();
    private Proveedor proveedorActual = new();

    private bool loading = true;
    private bool mostrarModal = false;
    private bool guardando = false;

    private string terminoBusqueda = "";
    private string filtroEstado = "todos";
    private string mensajeError = "";

    private IEnumerable<Proveedor> ProveedoresFiltrados =>
        proveedores.Where(p =>
            (
                string.IsNullOrEmpty(terminoBusqueda) ||
                p.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                (p.RFC ?? "").Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)
            )
            &&
            (
                filtroEstado == "todos" ||
                (filtroEstado == "activos" && p.Activo) ||
                (filtroEstado == "inactivos" && !p.Activo)
            )
        );

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        loading = false;
    }

    private async Task Cargar()
    {
        try
        {
            proveedores = await ProveedorHttpService.GetAsync();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void MostrarModalNuevo()
    {
        proveedorActual = new Proveedor { Activo = true };
        mensajeError = "";
        mostrarModal = true;
    }

    private void Editar(Proveedor p)
    {

        proveedorActual = new Proveedor
        {
            Id = p.Id,
            Nombre = p.Nombre,
            RazonSocial = p.RazonSocial,
            RFC = p.RFC,
            RegimenFiscal = p.RegimenFiscal, 
            Contacto = p.Contacto,
            Email = p.Email,
            Telefono = p.Telefono,
            Direccion = p.Direccion,
            Activo = p.Activo,
            FechaRegistro = p.FechaRegistro
        };

        mensajeError = "";
        mostrarModal = true;
    }

    private void Cerrar()
    {
        mostrarModal = false;
        proveedorActual = new();
        mensajeError = "";
    }

    private async Task Guardar()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (proveedorActual.Id == 0)
                await ProveedorHttpService.CreateAsync(proveedorActual);
            else
                await ProveedorHttpService.UpdateAsync(proveedorActual);

            await Cargar();
            Cerrar();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Eliminar(int id)
    {
        try
        {
            var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar proveedor?");
            if (!confirm) return;

            await ProveedorHttpService.DeleteAsync(id);
            await Cargar();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }
}