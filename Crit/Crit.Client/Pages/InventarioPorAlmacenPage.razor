@page "/inventario-por-almacen"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject InventarioAlmacenHttpService InventarioAlmacenHttpService
@inject AlmacenHttpService AlmacenHttpService

<PageTitle>Inventario por Almacén | Crit</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0" style="color: #1F2A44;">Inventario por Almacén</h2>
            <p class="text-muted small mb-0">Monitorea existencias y niveles críticos por sucursal</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary shadow-sm px-4 py-2" @onclick="ToggleNuevoAlmacen">
                <i class="bi bi-plus-square me-2"></i>
                <span>@(mostrarNuevoAlmacen ? "Ocultar Formulario" : "Nuevo Almacén")</span>
            </button>

            <button class="btn saas-btn-primary shadow-sm px-4 py-2" @onclick="CargarDatos">
                <i class="bi bi-arrow-clockwise me-2"></i>
                <span>Sincronizar Datos</span>
            </button>
        </div>
    </div>

    @if (mostrarNuevoAlmacen)
    {
        <div class="card shadow-sm border-0 mb-4 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: #1F2A44;">Registrar Nuevo Almacén</h5>
                        <p class="text-muted small mb-0">Agrega una nueva sucursal o ubicación de resguardo.</p>
                    </div>

                    <span class="badge rounded-pill text-bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        <i class="bi bi-building-add me-1"></i> Alta rápida
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeAlmacen))
                {
                    <div class="alert @(esErrorAlmacen ? "alert-danger" : "alert-success") border-0 rounded-4 py-3 mb-3">
                        <i class="bi @(esErrorAlmacen ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>
                        @mensajeAlmacen
                    </div>
                }

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="saas-label">NOMBRE DEL ALMACÉN</label>
                        <input class="form-control"
                               placeholder="Ej. Matriz Norte"
                               @bind="nuevoAlmacen.Nombre" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="saas-label">CLAVE</label>
                        <input class="form-control"
                               placeholder="Ej. ALM-NTE"
                               @bind="nuevoAlmacen.Clave" />
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="saas-label">DIRECCIÓN</label>
                        <input class="form-control"
                               placeholder="Dirección o referencia"
                               @bind="nuevoAlmacen.Direccion" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="saas-label">ESTATUS</label>
                        <div class="form-check form-switch pt-2">
                            <input class="form-check-input" type="checkbox" @bind="nuevoAlmacen.Activo" />
                            <label class="form-check-label small fw-semibold">
                                @(nuevoAlmacen.Activo ? "Activo" : "Inactivo")
                            </label>
                        </div>
                    </div>

                    <div class="col-12 col-md-9 d-flex align-items-end justify-content-md-end gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary px-4" @onclick="LimpiarNuevoAlmacen">
                            <i class="bi bi-eraser me-2"></i>Limpiar
                        </button>

                        <button type="button"
                                class="btn saas-btn-primary px-4"
                                @onclick="GuardarNuevoAlmacen"
                                disabled="@guardandoAlmacen">
                            <i class="bi @(guardandoAlmacen ? "bi-hourglass-split" : "bi-plus-circle") me-2"></i>
                            @(guardandoAlmacen ? "Guardando..." : "Guardar Almacén")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-secondary-subtle text-secondary me-3">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Items en Vista</span>
                    </div>
                    <h3 class="fw-bold mb-0">@inventarioFiltrado.Count</h3>
                    <div class="text-muted extra-small mt-1">Registros visibles</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-primary-subtle text-primary me-3">
                            <i class="bi bi-stack"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Stock Físico Total</span>
                    </div>
                    <h3 class="fw-bold text-primary mb-0">@inventarioFiltrado.Sum(x => x.Stock).ToString("N0")</h3>
                    <div class="text-muted extra-small mt-1">Unidades acumuladas</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-warning-subtle text-warning me-3">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Bajo Mínimo</span>
                    </div>
                    <h3 class="fw-bold text-warning mb-0">@inventarioFiltrado.Count(x => x.Stock <= x.StockMinimo && x.Stock > 0)</h3>
                    <div class="text-muted extra-small mt-1">Productos en alerta</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-danger-subtle text-danger me-3">
                            <i class="bi bi-x-octagon"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Agotados</span>
                    </div>
                    <h3 class="fw-bold text-danger mb-0">@inventarioFiltrado.Count(x => x.Stock <= 0)</h3>
                    <div class="text-muted extra-small mt-1">Sin existencia</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-3">
                    <label class="saas-label">ALMACÉN</label>
                    <select class="form-select border-light-subtle" @bind="almacenSeleccionadoId" @bind:after="AplicarFiltros">
                        <option value="0">Todos los almacenes</option>
                        @foreach (var almacen in almacenes)
                        {
                            <option value="@almacen.Id">@almacen.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-5">
                    <label class="saas-label">BUSCAR PRODUCTO</label>
                    <div class="search-box-container">
                        <i class="bi bi-search"></i>
                        <input class="form-control"
                               placeholder="Nombre o código..."
                               @bind="busqueda"
                               @bind:event="oninput"
                               @bind:after="AplicarFiltros" />
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <label class="saas-label">ESTADO</label>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-sm flex-fill @(soloAlertasTexto == "todos" ? "btn-secondary" : "btn-outline-secondary")"
                                @onclick='() => SetAlertFilter("todos")'>
                            Todos
                        </button>

                        <button type="button"
                                class="btn btn-sm flex-fill @(soloAlertasTexto == "alertas" ? "btn-warning text-dark" : "btn-outline-warning")"
                                @onclick='() => SetAlertFilter("alertas")'>
                            Solo Alertas
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #1F2A44; color: white;">
                    <tr>
                        <th class="ps-4 py-3" style="width: 35%">Información del Producto</th>
                        <th style="width: 15%">Ubicación</th>
                        <th class="text-end" style="width: 10%">Stock</th>
                        <th class="text-end" style="width: 10%">Mínimo</th>
                        <th class="text-end" style="width: 10%">Máximo</th>
                        <th class="text-center pe-4" style="width: 20%">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!inventarioFiltrado.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="py-4">
                                    <i class="bi bi-search fs-1 text-muted opacity-25"></i>
                                    <p class="text-muted mt-2 mb-0">No se encontraron productos con los filtros aplicados.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in inventarioFiltrado)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-3 p-2 me-3 d-none d-sm-block">
                                            <i class="bi bi-box text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.Producto?.Nombre</div>
                                            <div class="text-muted small">Código: @item.Producto?.Codigo</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-white text-dark border fw-semibold">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Almacen?.Nombre
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="fs-6 fw-bold @(item.Stock <= 0 ? "text-danger" : (item.Stock <= item.StockMinimo ? "text-warning" : "text-primary"))">
                                        @item.Stock.ToString("N0")
                                    </span>
                                </td>
                                <td class="text-end text-muted small">@item.StockMinimo.ToString("N0")</td>
                                <td class="text-end text-muted small">@item.StockMaximo.ToString("N0")</td>
                                <td class="text-center pe-4">
                                    <span class="@ObtenerBadgeStock(item) w-100 shadow-sm" style="max-width: 140px; display: inline-block;">
                                        @if (item.Stock <= 0)
                                        {
                                            <i class="bi bi-x-octagon me-1"></i>
                                        }
                                        else if (item.Stock <= item.StockMinimo)
                                        {
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check2-circle me-1"></i>
                                        }
                                        @ObtenerTextoEstado(item)
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 py-3 text-center">
            <small class="text-muted">Mostrando <b>@inventarioFiltrado.Count</b> de <b>@inventario.Count</b> registros.</small>
        </div>
    </div>

    <div class="d-lg-none">
        @if (!inventarioFiltrado.Any())
        {
            <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                <i class="bi bi-search fs-1 text-muted mb-3"></i>
                <h5 class="fw-bold text-dark">Sin resultados</h5>
                <p class="text-muted mb-0">No se encontraron productos con los filtros aplicados.</p>
            </div>
        }
        else
        {
            @foreach (var item in inventarioFiltrado)
            {
                <div class="card shadow-sm border-0 mb-3 inventory-mobile-card">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div style="max-width: 70%;">
                                <h6 class="fw-bold mb-0 text-dark text-truncate">@item.Producto?.Nombre</h6>
                                <span class="extra-small text-muted text-uppercase">Código: @item.Producto?.Codigo</span>
                            </div>
                            <span class="@ObtenerBadgeStock(item) px-3 py-2">
                                @ObtenerTextoEstado(item)
                            </span>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-12">
                                <div class="text-muted extra-small">Almacén</div>
                                <div class="small text-dark">@item.Almacen?.Nombre</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted extra-small">Stock</div>
                                <div class="fw-bold @(item.Stock <= 0 ? "text-danger" : (item.Stock <= item.StockMinimo ? "text-warning" : "text-primary"))">
                                    @item.Stock.ToString("N0")
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="text-muted extra-small">Mínimo</div>
                                <div class="small text-dark">@item.StockMinimo.ToString("N0")</div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="text-muted extra-small">Máximo</div>
                                <div class="small text-dark">@item.StockMaximo.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    :root {
        --polynex-navy: #1F2A44;
    }

    .saas-btn-primary {
        background-color: var(--polynex-navy);
        color: white;
        border: none;
        transition: all 0.2s;
    }

        .saas-btn-primary:hover {
            background-color: #2a3a5e;
            color: white;
            transform: translateY(-1px);
        }

    .search-box-container {
        position: relative;
    }

        .search-box-container i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 2;
        }

        .search-box-container .form-control {
            padding-left: 2.5rem;
            border-radius: 0.75rem;
        }

    .saas-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 0.35rem;
        display: block;
        text-transform: uppercase;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
    }

    .extra-small {
        font-size: 0.72rem;
    }

    .stat-card {
        transition: all 0.2s ease-in-out;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
        }

    .inventory-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
        transition: transform 0.2s;
    }

        .inventory-mobile-card:active {
            transform: scale(0.98);
        }

    .table thead th {
        border: none;
        font-weight: 600;
    }

    .table tbody tr {
        transition: background-color 0.2s;
    }

        .table tbody tr:hover {
            background-color: #fcfcfc;
        }

    .form-select,
    .form-control {
        border-radius: 10px;
        font-size: 0.9rem;
    }

    .badge {
        padding: 0.6em 1em;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }
</style>

@code {
    private List<InventarioPorAlmacen> inventario = new();
    private List<InventarioPorAlmacen> inventarioFiltrado = new();
    private List<Almacen> almacenes = new();

    private int almacenSeleccionadoId = 0;
    private string busqueda = string.Empty;
    private string soloAlertasTexto = "todos";

    private bool mostrarNuevoAlmacen;
    private bool guardandoAlmacen;
    private bool esErrorAlmacen;
    private string? mensajeAlmacen;
    private Almacen nuevoAlmacen = CrearModeloAlmacen();

    protected override async Task LoadDataAsync()
    {
        await CargarDatos();
    }

    protected override bool ShouldRetryInitialLoad()
        => !inventario.Any() && !almacenes.Any();

    private async Task CargarDatos()
    {
        inventario = await InventarioAlmacenHttpService.GetAsync() ?? new();
        almacenes = await AlmacenHttpService.GetActivosAsync() ?? new();
        AplicarFiltros();
    }

    private void ToggleNuevoAlmacen()
    {
        mostrarNuevoAlmacen = !mostrarNuevoAlmacen;
        mensajeAlmacen = null;
        esErrorAlmacen = false;
    }

    private void LimpiarNuevoAlmacen()
    {
        nuevoAlmacen = CrearModeloAlmacen();
        mensajeAlmacen = null;
        esErrorAlmacen = false;
    }

    private async Task GuardarNuevoAlmacen()
    {
        mensajeAlmacen = null;
        esErrorAlmacen = false;

        if (string.IsNullOrWhiteSpace(nuevoAlmacen.Nombre))
        {
            esErrorAlmacen = true;
            mensajeAlmacen = "El nombre del almacén es obligatorio.";
            return;
        }

        guardandoAlmacen = true;

        try
        {
            var almacenCreado = await AlmacenHttpService.CreateAsync(nuevoAlmacen);

            if (almacenCreado is null)
            {
                esErrorAlmacen = true;
                mensajeAlmacen = "No se pudo guardar el almacén. Verifica que el nombre no esté repetido.";
                return;
            }

            mensajeAlmacen = "Almacén creado correctamente.";
            almacenSeleccionadoId = almacenCreado.Id;
            nuevoAlmacen = CrearModeloAlmacen();
            mostrarNuevoAlmacen = false;

            await CargarDatos();
        }
        finally
        {
            guardandoAlmacen = false;
        }
    }

    private void SetAlertFilter(string value)
    {
        soloAlertasTexto = value;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        IEnumerable<InventarioPorAlmacen> query = inventario;

        if (almacenSeleccionadoId > 0)
        {
            query = query.Where(x => x.AlmacenId == almacenSeleccionadoId);
        }

        if (!string.IsNullOrWhiteSpace(busqueda))
        {
            query = query.Where(x =>
                (x.Producto?.Nombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Producto?.Codigo?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (soloAlertasTexto == "alertas")
        {
            query = query.Where(x => x.Stock <= x.StockMinimo);
        }

        inventarioFiltrado = query
            .OrderBy(x => x.Almacen?.Nombre)
            .ThenBy(x => x.Producto?.Nombre)
            .ToList();
    }

    private static Almacen CrearModeloAlmacen() => new()
    {
        Activo = true
    };

    private static string ObtenerTextoEstado(InventarioPorAlmacen item)
    {
        if (item.Stock <= 0) return "AGOTADO";
        if (item.Stock <= item.StockMinimo) return "MÍNIMO";
        return "SALUDABLE";
    }

    private static string ObtenerBadgeStock(InventarioPorAlmacen item)
    {
        if (item.Stock <= 0)
            return "badge rounded-pill text-bg-danger-subtle text-danger border border-danger";

        if (item.Stock <= item.StockMinimo)
            return "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning";

        return "badge rounded-pill text-bg-success-subtle text-success border border-success";
    }
}
