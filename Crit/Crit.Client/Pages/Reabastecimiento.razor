@page "/reabastecimiento"
@using System.Net.Http.Json
@using Crit.Client.Services
@using Crit.Shared.Models
@inject HttpClient Http
@inject ProductoHttpService ProductoHttpService
@inject AlmacenHttpService AlmacenHttpService
@inject ReabastecimientoHttpService ReabastecimientoHttpService
@inject NavigationManager Navigation
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject IJSRuntime JSRuntime

<PageTitle>Reabastecimiento | Control de Stock</PageTitle>

<div class="pos-container px-3 py-4">
    @* --- HEADER DINÁMICO --- *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-warning text-dark rounded-3 p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                <i class="bi bi-box-seam-fill fs-3"></i>
            </div>
            <div>
                <h2 class="page-title mb-0 fw-bold">Reabastecimiento</h2>
                <p class="text-muted small mb-0">Gestión inteligente de niveles mínimos y órdenes de reposición</p>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-white border shadow-sm fw-bold px-3" @onclick="CargarDatos">
                <i class="bi bi-arrow-clockwise me-2 text-primary"></i>Actualizar
            </button>
            <button class="btn btn-warning shadow-sm fw-bold px-3 border-warning" @onclick="GenerarAlertas">
                <i class="bi bi-lightning-charge-fill me-2"></i>Generar Alertas Automáticas
            </button>
        </div>
    </div>

    @* --- KPI CARDS (RESUMEN) --- *@
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100 rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Pendientes</div>
                            <h3 class="fw-bold text-dark mb-0">@ordenes.Count(x => x.Estado == "Pendiente")</h3>
                        </div>
                        <div class="bg-warning-subtle text-warning p-2 rounded-circle">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100 rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Solicitadas</div>
                            <h3 class="fw-bold text-dark mb-0">@ordenes.Count(x => x.Estado == "Solicitada")</h3>
                        </div>
                        <div class="bg-primary-subtle text-primary p-2 rounded-circle">
                            <i class="bi bi-send-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100 rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Completadas</div>
                            <h3 class="fw-bold text-dark mb-0">@ordenes.Count(x => x.Estado == "Completada")</h3>
                        </div>
                        <div class="bg-success-subtle text-success p-2 rounded-circle">
                            <i class="bi bi-check-all fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100 rounded-3">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Canceladas</div>
                            <h3 class="fw-bold text-dark mb-0">@ordenes.Count(x => x.Estado == "Cancelada")</h3>
                        </div>
                        <div class="bg-danger-subtle text-danger p-2 rounded-circle">
                            <i class="bi bi-x-circle-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- FORMULARIO DE ORDEN MANUAL --- *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-dark text-white py-3 px-4 d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i>
            <h5 class="mb-0 fw-bold">Nueva Orden de Reposición Manual</h5>
        </div>
        <div class="card-body p-4 bg-white">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">PRODUCTO</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <select class="form-select border-start-0 ps-0" @bind="nuevaOrden.ProductoId">
                            <option value="0">Buscar producto...</option>
                            @foreach (var producto in productos)
                            {
                                <option value="@producto.Id">@producto.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">ALMACÉN DE DESTINO</label>
                    <select class="form-select" @bind="nuevaOrden.AlmacenId">
                        <option value="0">Seleccionar almacén...</option>
                        @foreach (var almacen in almacenes)
                        {
                            <option value="@almacen.Id">📍 @almacen.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">CANTIDAD A SOLICITAR</label>
                    <input type="number" step="1" min="1" class="form-control fw-bold text-primary fs-5 py-1" @bind="nuevaOrden.CantidadSugerida" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">STOCK HOY</label>
                    <input type="number" class="form-control bg-light" @bind="nuevaOrden.StockActual" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">STOCK MÍNIMO</label>
                    <input type="number" class="form-control bg-light" @bind="nuevaOrden.StockMinimo" />
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">TIPO DE MOVIMIENTO</label>
                    <select class="form-select border-primary-subtle" @bind="nuevaOrden.TipoSugerido">
                        <option value="Compra">💰 Compra a Proveedor</option>
                        <option value="Traspaso">🚛 Traspaso Interno</option>
                        <option value="Ajuste">🛠 Ajuste de Inventario</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">ESTADO INICIAL</label>
                    <select class="form-select" @bind="nuevaOrden.Estado">
                        <option value="Pendiente">Pendiente de Revisión</option>
                        <option value="Solicitada">Solicitada Directamente</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label small fw-bold text-muted">NOTAS ADICIONALES</label>
                    <textarea class="form-control" rows="1" placeholder="Ej. El proveedor avisó de retrasos..." @bind="nuevaOrden.Observaciones"></textarea>
                </div>

                <div class="col-12 text-end mt-3">
                    <button class="btn btn-primary px-5 py-2 shadow-sm fw-bold rounded-pill" @onclick="GuardarOrden">
                        <i class="bi bi-check2-circle me-2"></i>REGISTRAR ORDEN
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* --- TABLA DE ÓRDENES --- *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4">
            <h5 class="mb-0 fw-bold text-dark">Listado de Reposiciones</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Registro</th>
                        <th>Producto</th>
                        <th>Almacén</th>
                        <th class="text-end">Niveles</th>
                        <th class="text-end">A Solicitar</th>
                        <th>Tipo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!ordenes.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted opacity-25 d-block mb-2"></i>
                                <span class="text-muted">No hay órdenes registradas.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ordenes)
                        {
                            <tr class="border-bottom">
                                <td class="ps-4">
                                    <div class="small fw-bold text-dark">@item.Fecha.ToString("dd MMM")</div>
                                    <div class="text-muted x-small">@item.Fecha.ToString("HH:mm")</div>
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">@item.Producto?.Nombre</div>
                                    <div class="badge bg-light text-muted border fw-normal">@item.Producto?.Codigo</div>
                                </td>

                                <td>
                                    <span class="text-secondary">
                                        <i class="bi bi-geo-alt me-1"></i>@item.Almacen?.Nombre
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-column align-items-end">
                                        <span class="@(item.StockActual <= item.StockMinimo ? "text-danger fw-bold" : "text-success") small">
                                            Actual: @item.StockActual.ToString("N0")
                                        </span>
                                        <span class="text-muted x-small">Min: @item.StockMinimo.ToString("N0")</span>
                                    </div>
                                </td>

                                <td class="text-end fw-bold text-primary fs-6">
                                    @item.CantidadSugerida.ToString("N0")
                                </td>

                                <td>
                                    <span class="text-muted small">@item.TipoSugerido</span>
                                </td>

                                <td class="text-center">
                                    <span class="@ObtenerBadgeEstado(item.Estado)">@item.Estado</span>
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1 flex-wrap">
                                        @if (item.Estado == "Pendiente")
                                        {
                                            <button class="btn btn-sm btn-white text-primary border shadow-sm"
                                                    title="Solicitar"
                                                    @onclick='() => CambiarEstado(item.Id, "solicitar")'>
                                                <i class="bi bi-send-fill"></i>
                                            </button>

                                            <button class="btn btn-sm btn-white text-success border shadow-sm"
                                                    title="Ir a compra"
                                                    @onclick='() => IrACompra(item)'>
                                                <i class="bi bi-cart-plus-fill"></i>
                                            </button>

                                            <button class="btn btn-sm btn-white text-info border shadow-sm"
                                                    title="Ir a traspaso"
                                                    @onclick='() => IrATraspaso(item)'>
                                                <i class="bi bi-arrow-left-right"></i>
                                            </button>
                                        }

                                        @if (item.CompraId.HasValue)
                                        {
                                            <a class="btn btn-sm btn-white text-success border shadow-sm"
                                               title="Ver compra relacionada"
                                               href="/compras/@item.CompraId.Value">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                        }

                                        @if (item.TraspasoAlmacenId.HasValue)
                                        {
                                            <a class="btn btn-sm btn-white text-info border shadow-sm"
                                               title="Ver traspaso relacionado"
                                               href="/traspasos">
                                                <i class="bi bi-truck"></i>
                                            </a>
                                        }

                                        @if (item.Estado == "Pendiente" || item.Estado == "Solicitada" || item.Estado == "EnProceso")
                                        {
                                            <button class="btn btn-sm btn-white text-success border shadow-sm"
                                                    title="Completar"
                                                    @onclick='() => CambiarEstado(item.Id, "completar")'>
                                                <i class="bi bi-check-circle-fill"></i>
                                            </button>
                                        }

                                        @if (item.Estado != "Completada" && item.Estado != "Cancelada")
                                        {
                                            <button class="btn btn-sm btn-white text-danger border shadow-sm"
                                                    title="Cancelar"
                                                    @onclick='() => CambiarEstado(item.Id, "cancelar")'>
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    .pos-container {
        min-height: 100vh;
    }

    .x-small {
        font-size: 0.75rem;
    }

    .btn-white {
        background-color: #fff;
        color: #333;
        border: 1px solid #dee2e6;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }

    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .form-control, .form-select {
        border: 1px solid #e0e0e0;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.1);
        }

    /* Badges mejorados */
    .badge {
        padding: 0.5em 0.8em;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .table thead th {
        font-size: 0.75rem;
        background-color: #fafafa;
        border-top: none;
    }
</style>

@code {
    // ... Tu lógica C# se mantiene 100% igual ...
    private List<OrdenReabastecimiento> ordenes = new();
    private List<Producto> productos = new();
    private List<Almacen> almacenes = new();

    private OrdenReabastecimiento nuevaOrden = new()
    {
        Fecha = DateTime.Now,
        Estado = "Pendiente",
        TipoSugerido = "Compra",
        CantidadSugerida = 1
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        ordenes = await Http.GetFromJsonAsync<List<OrdenReabastecimiento>>("api/reabastecimiento")
            ?? new List<OrdenReabastecimiento>();

        productos = await ProductoHttpService.GetProductosAsync();
        almacenes = await AlmacenHttpService.GetActivosAsync();
    }

    private async Task GenerarAlertas()
    {
       var ok = await ReabastecimientoHttpService.GenerarAlertasAsync();

    if (!ok)
    {
        await JSRuntime.InvokeVoidAsync("alert", "No se pudieron generar las alertas.");
        return;
    }

    await CargarDatos();
    }

    private async Task GuardarOrden()
    {
        if (nuevaOrden.ProductoId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un producto.");
            return;
        }

        if (nuevaOrden.AlmacenId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un almacen.");
            return;
        }

        if (nuevaOrden.CantidadSugerida <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "La cantidad sugerida debe ser mayor a cero.");
            return;
        }

        var ok = await ReabastecimientoHttpService.CreateAsync(nuevaOrden);

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo guardar la orden.");
            return;
        }

        nuevaOrden = new OrdenReabastecimiento
        {
            Fecha = DateTime.Now,
            Estado = "Pendiente",
            TipoSugerido = "Compra",
            CantidadSugerida = 1
        };

        await CargarDatos();
    }

    private async Task CambiarEstado(int id, string accion)
    {
        var ok = await ReabastecimientoHttpService.CambiarEstadoAsync(id, accion);

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo actualizar la orden.");
            return;
        }

        await CargarDatos();
    }
    private void IrACompra(OrdenReabastecimiento item)
    {
        Navigation.NavigateTo($"/compras?productoId={item.ProductoId}&almacenId={item.AlmacenId}&cantidad={item.CantidadSugerida}&ordenReabastecimientoId={item.Id}");
    }

    private void IrATraspaso(OrdenReabastecimiento item)
    {
        Navigation.NavigateTo($"/traspasos?productoId={item.ProductoId}&almacenDestinoId={item.AlmacenId}&cantidad={item.CantidadSugerida}&ordenReabastecimientoId={item.Id}");
    }

    private static string ObtenerBadgeEstado(string? estado) => estado switch
    {
        "Pendiente" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        "Solicitada" => "badge rounded-pill text-bg-primary-subtle text-primary border border-primary",
        "EnProceso" => "badge rounded-pill text-bg-info-subtle text-info border border-info",
        "Completada" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "Cancelada" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        _ => "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary"
    };
}