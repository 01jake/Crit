@page "/reabastecimiento"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ProductoHttpService ProductoHttpService
@inject AlmacenHttpService AlmacenHttpService
@inject ReabastecimientoHttpService ReabastecimientoHttpService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Reabastecimiento | Control de Stock</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0" style="color: #1F2A44;">Reabastecimiento</h2>
            <p class="text-muted small mb-0">Gestiona niveles mínimos y órdenes de reposición</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-white shadow-sm px-4 py-2" @onclick="CargarDatos">
                <i class="bi bi-arrow-clockwise me-2 text-primary"></i><span>Actualizar</span>
            </button>

            <button class="btn btn-warning shadow-sm px-4 py-2 border-warning fw-semibold" @onclick="GenerarAlertas">
                <i class="bi bi-lightning-charge-fill me-2"></i><span>Generar Alertas</span>
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-warning-subtle text-warning me-3">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Pendientes</span>
                    </div>
                    <h3 class="fw-bold mb-0">@ordenes.Count(x => x.Estado == "Pendiente")</h3>
                    <div class="text-muted extra-small mt-1">Por revisar</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-primary-subtle text-primary me-3">
                            <i class="bi bi-send-fill"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Solicitadas</span>
                    </div>
                    <h3 class="fw-bold mb-0">@ordenes.Count(x => x.Estado == "Solicitada")</h3>
                    <div class="text-muted extra-small mt-1">En curso</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-success-subtle text-success me-3">
                            <i class="bi bi-check-all"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Completadas</span>
                    </div>
                    <h3 class="fw-bold mb-0">@ordenes.Count(x => x.Estado == "Completada")</h3>
                    <div class="text-muted extra-small mt-1">Órdenes cerradas</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="stat-icon bg-danger-subtle text-danger me-3">
                            <i class="bi bi-x-circle-fill"></i>
                        </div>
                        <span class="text-muted fw-bold small text-uppercase">Canceladas</span>
                    </div>
                    <h3 class="fw-bold mb-0">@ordenes.Count(x => x.Estado == "Cancelada")</h3>
                    <div class="text-muted extra-small mt-1">Sin ejecutar</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-header bg-white border-bottom-0 py-3 px-4">
            <div>
                <h6 class="fw-bold mb-0 text-dark">Nueva Orden de Reposición</h6>
                <small class="text-muted">Crea una orden manual para compra, traspaso o ajuste</small>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="saas-label">PRODUCTO</label>
                    <select class="form-select saas-input" @bind="nuevaOrden.ProductoId">
                        <option value="0">Seleccionar producto...</option>
                        @foreach (var producto in productos)
                        {
                            <option value="@producto.Id">@producto.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="saas-label">ALMACÉN DESTINO</label>
                    <select class="form-select saas-input" @bind="nuevaOrden.AlmacenId">
                        <option value="0">Seleccionar almacén...</option>
                        @foreach (var almacen in almacenes)
                        {
                            <option value="@almacen.Id">@almacen.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="saas-label">CANTIDAD A SOLICITAR</label>
                    <input type="number" step="1" min="1" class="form-control saas-input fw-bold text-primary" @bind="nuevaOrden.CantidadSugerida" />
                </div>

                <div class="col-12 col-md-2">
                    <label class="saas-label">STOCK HOY</label>
                    <input type="number" class="form-control saas-input bg-light" @bind="nuevaOrden.StockActual" />
                </div>

                <div class="col-12 col-md-2">
                    <label class="saas-label">STOCK MÍNIMO</label>
                    <input type="number" class="form-control saas-input bg-light" @bind="nuevaOrden.StockMinimo" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="saas-label">TIPO DE MOVIMIENTO</label>
                    <select class="form-select saas-input" @bind="nuevaOrden.TipoSugerido">
                        <option value="Compra">Compra a Proveedor</option>
                        <option value="Traspaso">Traspaso Interno</option>
                        <option value="Ajuste">Ajuste de Inventario</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="saas-label">ESTADO INICIAL</label>
                    <select class="form-select saas-input" @bind="nuevaOrden.Estado">
                        <option value="Pendiente">Pendiente de Revisión</option>
                        <option value="Solicitada">Solicitada Directamente</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="saas-label">NOTAS ADICIONALES</label>
                    <textarea class="form-control saas-input" rows="2" placeholder="Ej. El proveedor avisó de retrasos..." @bind="nuevaOrden.Observaciones"></textarea>
                </div>

                <div class="col-12 d-grid d-md-flex justify-content-md-end mt-2">
                    <button class="btn saas-btn-primary px-4 py-3 fw-bold shadow-sm" @onclick="GuardarOrden">
                        <i class="bi bi-check2-circle me-2"></i>Registrar Orden
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom-0 py-3 px-4">
            <div>
                <h6 class="fw-bold mb-0 text-dark">Listado de Reposiciones</h6>
                <small class="text-muted">Órdenes registradas y seguimiento operativo</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f8fafc;">
                    <tr>
                        <th class="ps-4 py-3">Registro</th>
                        <th>Producto</th>
                        <th>Almacén</th>
                        <th class="text-end">Niveles</th>
                        <th class="text-end">A Solicitar</th>
                        <th>Tipo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!ordenes.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 text-muted opacity-25 d-block mb-2"></i>
                                <span class="text-muted">No hay órdenes registradas.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ordenes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="small fw-bold text-dark">@item.Fecha.ToString("dd MMM")</div>
                                    <div class="text-muted extra-small">@item.Fecha.ToString("HH:mm")</div>
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">@item.Producto?.Nombre</div>
                                    <div class="badge bg-light text-muted border fw-normal">@item.Producto?.Codigo</div>
                                </td>

                                <td>
                                    <span class="text-secondary">
                                        <i class="bi bi-geo-alt me-1"></i>@item.Almacen?.Nombre
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="d-flex flex-column align-items-end">
                                        <span class="@(item.StockActual <= item.StockMinimo ? "text-danger fw-bold" : "text-success") small">
                                            Actual: @item.StockActual.ToString("N0")
                                        </span>
                                        <span class="text-muted extra-small">Min: @item.StockMinimo.ToString("N0")</span>
                                    </div>
                                </td>

                                <td class="text-end fw-bold text-primary fs-6">
                                    @item.CantidadSugerida.ToString("N0")
                                </td>

                                <td>
                                    <span class="text-muted small">@item.TipoSugerido</span>
                                </td>

                                <td class="text-center">
                                    <span class="@ObtenerBadgeEstado(item.Estado)">@item.Estado</span>
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1 flex-wrap">
                                        @if (item.Estado == "Pendiente")
                                        {
                                            <button class="btn btn-white btn-sm" title="Solicitar" @onclick='() => CambiarEstado(item.Id, "solicitar")'>
                                                <i class="bi bi-send-fill text-primary"></i>
                                            </button>

                                            <button class="btn btn-white btn-sm" title="Ir a compra" @onclick='() => IrACompra(item)'>
                                                <i class="bi bi-cart-plus-fill text-success"></i>
                                            </button>

                                            <button class="btn btn-white btn-sm" title="Ir a traspaso" @onclick='() => IrATraspaso(item)'>
                                                <i class="bi bi-arrow-left-right text-info"></i>
                                            </button>
                                        }

                                        @if (item.CompraId.HasValue)
                                        {
                                            <a class="btn btn-white btn-sm" title="Ver compra relacionada" href="/compras/@item.CompraId.Value">
                                                <i class="bi bi-receipt text-success"></i>
                                            </a>
                                        }

                                        @if (item.TraspasoAlmacenId.HasValue)
                                        {
                                            <a class="btn btn-white btn-sm" title="Ver traspaso relacionado" href="/traspasos">
                                                <i class="bi bi-truck text-info"></i>
                                            </a>
                                        }

                                        @if (item.Estado == "Pendiente" || item.Estado == "Solicitada" || item.Estado == "EnProceso")
                                        {
                                            <button class="btn btn-white btn-sm" title="Completar" @onclick='() => CambiarEstado(item.Id, "completar")'>
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            </button>
                                        }

                                        @if (item.Estado != "Completada" && item.Estado != "Cancelada")
                                        {
                                            <button class="btn btn-white btn-sm" title="Cancelar" @onclick='() => CambiarEstado(item.Id, "cancelar")'>
                                                <i class="bi bi-trash-fill text-danger"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-lg-none">
        @if (!ordenes.Any())
        {
            <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
                <h5 class="fw-bold text-dark">Sin órdenes</h5>
                <p class="text-muted mb-0">No hay órdenes registradas.</p>
            </div>
        }
        else
        {
            @foreach (var item in ordenes)
            {
                <div class="card shadow-sm border-0 mb-3 replenishment-mobile-card">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div style="max-width: 70%;">
                                <h6 class="fw-bold mb-0 text-dark text-truncate">@item.Producto?.Nombre</h6>
                                <span class="extra-small text-muted text-uppercase">@item.Producto?.Codigo</span>
                            </div>
                            <span class="@ObtenerBadgeEstado(item.Estado)">@item.Estado</span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="text-muted extra-small">Almacén</div>
                                <div class="small text-dark">@item.Almacen?.Nombre</div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-muted extra-small">Fecha</div>
                                <div class="small text-dark">@item.Fecha.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted extra-small">Actual</div>
                                <div class="small @(item.StockActual <= item.StockMinimo ? "text-danger fw-bold" : "text-success fw-bold")">
                                    @item.StockActual.ToString("N0")
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="text-muted extra-small">Mínimo</div>
                                <div class="small text-dark">@item.StockMinimo.ToString("N0")</div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="text-muted extra-small">Solicitar</div>
                                <div class="small fw-bold text-primary">@item.CantidadSugerida.ToString("N0")</div>
                            </div>
                            <div class="col-12">
                                <div class="text-muted extra-small">Tipo</div>
                                <div class="small text-dark">@item.TipoSugerido</div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 border-top pt-3 flex-wrap">
                            @if (item.Estado == "Pendiente")
                            {
                                <button class="btn btn-light-primary btn-sm flex-fill" @onclick='() => CambiarEstado(item.Id, "solicitar")'>
                                    <i class="bi bi-send-fill me-1"></i>Solicitar
                                </button>

                                <button class="btn btn-light-success btn-sm flex-fill" @onclick='() => IrACompra(item)'>
                                    <i class="bi bi-cart-plus-fill me-1"></i>Compra
                                </button>

                                <button class="btn btn-light-info btn-sm flex-fill" @onclick='() => IrATraspaso(item)'>
                                    <i class="bi bi-arrow-left-right me-1"></i>Traspaso
                                </button>
                            }

                            @if (item.Estado == "Pendiente" || item.Estado == "Solicitada" || item.Estado == "EnProceso")
                            {
                                <button class="btn btn-light-success btn-sm flex-fill" @onclick='() => CambiarEstado(item.Id, "completar")'>
                                    <i class="bi bi-check-circle-fill me-1"></i>Completar
                                </button>
                            }

                            @if (item.Estado != "Completada" && item.Estado != "Cancelada")
                            {
                                <button class="btn btn-light-danger btn-sm flex-fill" @onclick='() => CambiarEstado(item.Id, "cancelar")'>
                                    <i class="bi bi-trash-fill me-1"></i>Cancelar
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    :root {
        --polynex-navy: #1F2A44;
    }

    .saas-btn-primary {
        background-color: var(--polynex-navy);
        color: white;
        border: none;
        transition: all 0.2s;
    }

        .saas-btn-primary:hover {
            background-color: #2a3a5e;
            color: white;
            transform: translateY(-1px);
        }

    .saas-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 0.35rem;
        display: block;
        text-transform: uppercase;
    }

    .saas-input {
        border-radius: 0.75rem;
    }

    .extra-small {
        font-size: 0.75rem;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
    }

    .stat-card {
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .replenishment-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
        transition: transform 0.2s;
    }

        .replenishment-mobile-card:active {
            transform: scale(0.98);
        }

    .btn-white {
        background-color: #fff;
        color: #333;
        border: 1px solid #dee2e6;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
        }

    .btn-light-primary {
        background: #eff6ff;
        color: #2563eb;
        border: none;
    }

        .btn-light-primary:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .btn-light-success {
        background: #ecfdf5;
        color: #059669;
        border: none;
    }

        .btn-light-success:hover {
            background: #d1fae5;
            color: #047857;
        }

    .btn-light-info {
        background: #ecfeff;
        color: #0891b2;
        border: none;
    }

        .btn-light-info:hover {
            background: #cffafe;
            color: #0e7490;
        }

    .btn-light-danger {
        background: #fef2f2;
        color: #dc2626;
        border: none;
    }

        .btn-light-danger:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .form-control,
    .form-select {
        border: 1px solid #e0e0e0;
        transition: all 0.2s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.1);
        }

    .badge {
        padding: 0.5em 0.8em;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .table thead th {
        font-size: 0.75rem;
        background-color: #fafafa;
        border-top: none;
    }

    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }
</style>

@code {
    private List<OrdenReabastecimiento> ordenes = new();
    private List<Producto> productos = new();
    private List<Almacen> almacenes = new();

    private OrdenReabastecimiento nuevaOrden = new()
    {
        Fecha = DateTime.Now,
        Estado = "Pendiente",
        TipoSugerido = "Compra",
        CantidadSugerida = 1
    };

    protected override async Task LoadDataAsync()
    {
        await CargarDatos();
    }

    protected override bool ShouldRetryInitialLoad()
        => !productos.Any() || !almacenes.Any();

    private async Task CargarDatos()
    {
        try
        {
            ordenes = await ReabastecimientoHttpService.GetAsync();
            productos = await ProductoHttpService.GetProductosActivosAsync();
            almacenes = await AlmacenHttpService.GetActivosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            ordenes = new();
            productos = new();
            almacenes = new();
        }
    }

    private async Task GenerarAlertas()
    {
        var ok = await ReabastecimientoHttpService.GenerarAlertasAsync();

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudieron generar las alertas.");
            return;
        }

        await CargarDatos();
    }

    private async Task GuardarOrden()
    {
        if (nuevaOrden.ProductoId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un producto.");
            return;
        }

        if (nuevaOrden.AlmacenId <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debes seleccionar un almacen.");
            return;
        }

        if (nuevaOrden.CantidadSugerida <= 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "La cantidad sugerida debe ser mayor a cero.");
            return;
        }

        var ok = await ReabastecimientoHttpService.CreateAsync(nuevaOrden);

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo guardar la orden.");
            return;
        }

        nuevaOrden = new OrdenReabastecimiento
        {
            Fecha = DateTime.Now,
            Estado = "Pendiente",
            TipoSugerido = "Compra",
            CantidadSugerida = 1
        };

        await CargarDatos();
    }

    private async Task CambiarEstado(int id, string accion)
    {
        var ok = await ReabastecimientoHttpService.CambiarEstadoAsync(id, accion);

        if (!ok)
        {
            await JSRuntime.InvokeVoidAsync("alert", "No se pudo actualizar la orden.");
            return;
        }

        await CargarDatos();
    }

    private void IrACompra(OrdenReabastecimiento item)
    {
        Navigation.NavigateTo($"/compras?productoId={item.ProductoId}&almacenId={item.AlmacenId}&cantidad={item.CantidadSugerida}&ordenReabastecimientoId={item.Id}");
    }

    private void IrATraspaso(OrdenReabastecimiento item)
    {
        Navigation.NavigateTo($"/traspasos?productoId={item.ProductoId}&almacenDestinoId={item.AlmacenId}&cantidad={item.CantidadSugerida}&ordenReabastecimientoId={item.Id}");
    }

    private static string ObtenerBadgeEstado(string? estado) => estado switch
    {
        "Pendiente" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        "Solicitada" => "badge rounded-pill text-bg-primary-subtle text-primary border border-primary",
        "EnProceso" => "badge rounded-pill text-bg-info-subtle text-info border border-info",
        "Completada" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "Cancelada" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        _ => "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary"
    };
}
