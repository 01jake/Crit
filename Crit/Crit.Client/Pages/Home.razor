@page "/"

<PageTitle>Sistema de Gestión Empresarial</PageTitle>

<div class="min-vh-100 bg-light">

    <!-- HERO -->
    <section class="hero-section position-relative" style="background: linear-gradient(135deg, #0f2027 0%, #2c5364 100%); padding: 100px 0;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 text-white mb-5 mb-lg-0">
                    <h1 class="display-4 fw-bold mb-4">Sistema de Gestión Empresarial</h1>
                    <p class="lead mb-4">
                        Administra tus <strong>clientes, productos, ventas y servicios</strong> en un solo lugar.
                        Control total con reportes, cotizaciones en PDF e historial detallado.
                    </p>

                    <AuthorizeView>
                        <Authorized>
                            <div class="d-flex gap-3 flex-wrap">
                                <a href="/clientes" class="btn btn-light btn-lg px-4">
                                    <i class="bi bi-people me-2"></i>Clientes
                                </a>
                                <a href="/ventas" class="btn btn-outline-light btn-lg px-4">
                                    <i class="bi bi-cash-stack me-2"></i>Ventas
                                </a>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/Account/Login" class="btn btn-light btn-lg px-4">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

                <!-- CARD DERECHA -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-lg">
                        <div class="card-body p-5 text-center">
                            <i class="bi bi-graph-up-arrow text-primary mb-4" style="font-size: 4rem;"></i>

                            <h3 class="fw-bold mb-3">Control Total del Negocio</h3>
                            <p class="text-muted mb-4">
                                Visualiza, gestiona y optimiza todas tus operaciones desde un solo sistema.
                            </p>

                            <div class="row g-3 text-start">
                                <div class="col-6">
                                    <small><i class="bi bi-check-circle-fill text-success me-2"></i>Clientes</small>
                                </div>
                                <div class="col-6">
                                    <small><i class="bi bi-check-circle-fill text-success me-2"></i>Productos</small>
                                </div>
                                <div class="col-6">
                                    <small><i class="bi bi-check-circle-fill text-success me-2"></i>Ventas</small>
                                </div>
                                <div class="col-6">
                                    <small><i class="bi bi-check-circle-fill text-success me-2"></i>Reportes</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ESTADÍSTICAS -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-md-3 col-6">
                    <i class="bi bi-people-fill text-primary mb-3" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold">+500</h3>
                    <p class="text-muted">Clientes</p>
                </div>
                <div class="col-md-3 col-6">
                    <i class="bi bi-box-seam text-success mb-3" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold">+200</h3>
                    <p class="text-muted">Productos</p>
                </div>
                <div class="col-md-3 col-6">
                    <i class="bi bi-cash text-warning mb-3" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold">+1,000</h3>
                    <p class="text-muted">Ventas</p>
                </div>
                <div class="col-md-3 col-6">
                    <i class="bi bi-file-earmark-bar-graph text-info mb-3" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold">Reportes</h3>
                    <p class="text-muted">En tiempo real</p>
                </div>
            </div>
        </div>
    </section>

    <!-- MÓDULOS -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold">Módulos del Sistema</h2>
                <p class="text-muted">Todo lo que necesitas para tu negocio</p>
            </div>

            <div class="row g-4">

                <!-- CLIENTES -->
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 text-center p-4">
                        <i class="bi bi-people text-primary mb-3" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold">Clientes</h5>
                        <p class="text-muted">Registro, historial y seguimiento completo de clientes.</p>
                    </div>
                </div>

                <!-- PRODUCTOS -->
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 text-center p-4">
                        <i class="bi bi-box text-success mb-3" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold">Productos</h5>
                        <p class="text-muted">Control de inventario, precios y categorías.</p>
                    </div>
                </div>

                <!-- SERVICIOS -->
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 text-center p-4">
                        <i class="bi bi-tools text-warning mb-3" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold">Servicios</h5>
                        <p class="text-muted">Gestión de servicios ofrecidos y costos.</p>
                    </div>
                </div>

                <!-- VENTAS -->
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 text-center p-4">
                        <i class="bi bi-cash-stack text-danger mb-3" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold">Ventas</h5>
                        <p class="text-muted">Registro de ventas y facturación.</p>
                    </div>
                </div>

                <!-- COTIZACIONES -->
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 text-center p-4">
                        <i class="bi bi-file-earmark-pdf text-info mb-3" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold">Cotizaciones PDF</h5>
                        <p class="text-muted">Genera cotizaciones profesionales en PDF.</p>
                    </div>
                </div>

                <!-- REPORTES -->
                <div class="col-md-4">
                    <div class="card shadow-sm h-100 text-center p-4">
                        <i class="bi bi-bar-chart text-dark mb-3" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold">Reportes</h5>
                        <p class="text-muted">Análisis de ventas, clientes y productos.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- EXTRA -->
    <section class="py-5 bg-dark text-white">
        <div class="container text-center">
            <h3 class="fw-bold mb-3">Historial y Facturación</h3>
            <p class="text-white-50">
                Consulta historial detallado de movimientos, ventas y facturas en cualquier momento.
            </p>
        </div>
    </section>

</div>