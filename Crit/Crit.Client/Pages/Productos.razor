@page "/productos"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ClienteHttpService ClienteHttpService
@inject ProductoHttpService ProductoHttpService

@inject IJSRuntime JSRuntime


<PageTitle>Inventario de Productos</PageTitle>

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-0">Gestión de Inventario</h2>
            <p class="text-muted small">Control de existencias, precios y categorías</p>
        </div>

        <button class="btn btn-primary shadow-sm px-4" @onclick="MostrarModalNuevo">
            <i class="bi bi-plus-lg me-2"></i> Nuevo Producto
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card p-3 shadow-sm border-0 card">
                <span class="text-muted small fw-bold">TOTAL PRODUCTOS</span>
                <h4 class="mb-0">@productos.Count</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-3 shadow-sm border-0 card border-start border-warning border-4">
                <span class="text-muted small fw-bold text-warning">STOCK BAJO</span>
                <h4 class="mb-0">@productos.Count(p => p.Stock <= p.StockMinimo && p.Stock > 0)</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card p-3 shadow-sm border-0 card border-start border-danger border-4">
                <span class="text-muted small fw-bold text-danger">AGOTADOS</span>
                <h4 class="mb-0">@productos.Count(p => p.Stock == 0)</h4>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="search-box-container">
                        
                        <input class="form-control" placeholder="Buscar por código o nombre..."
                               @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-light-subtle" @bind="filtroCategoria">
                        <option value="todas">Todas las categorías</option>
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select border-light-subtle" @bind="filtroStock">
                        <option value="todos">Existencia</option>
                        <option value="disponible">Disponibles</option>
                        <option value="bajo">Stock Bajo</option>
                        <option value="agotado">Agotados</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <span class="text-muted small">Filtrados: <strong>@ProductosFiltrados.Count()</strong></span>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-custom"></div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Código / Producto</th>
                            <th>Categoría</th>
                            <th>P. Compra</th>
                            <th>P. Venta</th>
                            <th>Existencia</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ProductosFiltrados)
                        {
                            <tr class="@(p.Stock <= p.StockMinimo ? "row-warning" : "")">
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@p.Nombre</div>
                                    <div class="text-muted extra-small">#@p.Codigo</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@p.Categoria</span></td>
                                <td class="small text-muted">$@p.PrecioCompra.ToString("N2")</td>
                                <td class="fw-bold text-primary">$@p.PrecioVenta.ToString("N2")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="status-badge @GetBadgeStock(p) me-2">
                                            @p.Stock @p.Unidad
                                        </span>
                                        @if (p.Stock <= p.StockMinimo && p.Stock > 0)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-warning small" title="Reabastecer pronto"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge @(p.Activo ? "status-active" : "status-inactive")">
                                        @(p.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <button class="btn btn-white btn-sm" title="Editar" @onclick="() => EditarProducto(p)">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                        <button class="btn btn-white btn-sm" title="Eliminar" @onclick="() => EliminarProducto(p.Id)">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(productoActual.Id == 0 ? "bi-box-seam" : "bi-pencil-square") me-2"></i>
                        @(productoActual.Id == 0 ? "Nuevo Producto" : "Editar Producto")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body p-4">
                    <EditForm Model="productoActual" OnValidSubmit="GuardarProducto">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold small">Código de Barras/SKU *</label>
                                <InputText class="form-control custom-input" @bind-Value="productoActual.Codigo" />
                                <ValidationMessage For="@(() => productoActual.Codigo)" class="text-danger small" />
                            </div>

                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold small">Nombre del Producto *</label>
                                <InputText class="form-control custom-input" @bind-Value="productoActual.Nombre" />
                                <ValidationMessage For="@(() => productoActual.Nombre)" class="text-danger small" />
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold small">Descripción Detallada</label>
                                <InputTextArea class="form-control custom-input" @bind-Value="productoActual.Descripcion" rows="2" />
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded shadow-sm h-100">
                                    <h6 class="section-title"><i class="bi bi-tags me-2"></i>Clasificación</h6>
                                    <div class="mb-3">
                                        <label class="form-label small">Categoría</label>
                                        <InputText class="form-control custom-input bg-white" @bind-Value="productoActual.Categoria" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small">Unidad de Medida</label>
                                        <InputText class="form-control custom-input bg-white" @bind-Value="productoActual.Unidad" placeholder="Pieza, Kg, Litro..." />
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded shadow-sm h-100">
                                    <h6 class="section-title"><i class="bi bi-currency-dollar me-2"></i>Precios e Inventario</h6>
                                    <div class="row g-2">
                                        <div class="col-6 mb-2">
                                            <label class="form-label small">Costo Compra</label>
                                            <InputNumber class="form-control custom-input bg-white" @bind-Value="productoActual.PrecioCompra" />
                                        </div>
                                        <div class="col-6 mb-2">
                                            <label class="form-label small">Precio Venta</label>
                                            <InputNumber class="form-control custom-input bg-white" @bind-Value="productoActual.PrecioVenta" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Stock Actual</label>
                                            <InputNumber class="form-control custom-input bg-white fw-bold" @bind-Value="productoActual.Stock" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Stock Mínimo</label>
                                            <InputNumber class="form-control custom-input bg-white" @bind-Value="productoActual.StockMinimo" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-3">
                                <div class="form-check form-switch p-3 bg-light rounded ps-5">
                                    <InputCheckbox class="form-check-input ms-0" @bind-Value="productoActual.Activo" id="chkProductoActivo" />
                                    <label class="form-check-label ms-2 fw-bold" for="chkProductoActivo">Producto disponible para la venta</label>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger-custom mt-3">@mensajeError</div>
                        }

                        <div class="modal-footer border-0 px-0 pb-0 mt-4">
                            <button type="button" class="btn btn-light-hover px-4" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary px-5 shadow" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-check-lg me-1"></i> Guardar Producto
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private List<Producto> productos = new();
    private Producto productoActual = new();
    private bool loading = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroCategoria = "todas";
    private string filtroStock = "todos";
    private string mensajeError = "";
    private List<string> categorias = new();

    private IEnumerable<Producto> ProductosFiltrados
    {
        get
        {
            return productos.Where(p =>
                (string.IsNullOrEmpty(terminoBusqueda) ||
                 p.Codigo.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                 p.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) &&
                (filtroCategoria == "todas" || p.Categoria == filtroCategoria) &&
                (filtroStock == "todos" ||
                 (filtroStock == "disponible" && p.Stock > p.StockMinimo) ||
                 (filtroStock == "bajo" && p.Stock <= p.StockMinimo && p.Stock > 0) ||
                 (filtroStock == "agotado" && p.Stock == 0))
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        loading = false;
    }

    private async Task CargarProductos()
    {
        try
        {
            productos = await ProductoHttpService.GetProductosAsync();
            categorias = productos.Where(p => !string.IsNullOrEmpty(p.Categoria))
                                 .Select(p => p.Categoria!)
                                 .Distinct()
                                 .OrderBy(c => c)
                                 .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
    }

    private void MostrarModalNuevo()
    {
        productoActual = new Producto
        {
            Activo = true,
            StockMinimo = 5,
            Unidad = "Pieza"
        };
        mensajeError = "";
        mostrarModal = true;
    }

    private void EditarProducto(Producto producto)
    {
        productoActual = new Producto
        {
            Id = producto.Id,
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            PrecioCompra = producto.PrecioCompra,
            PrecioVenta = producto.PrecioVenta,
            Stock = producto.Stock,
            StockMinimo = producto.StockMinimo,
            Categoria = producto.Categoria,
            Unidad = producto.Unidad,
            Activo = producto.Activo
        };
        mensajeError = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        productoActual = new();
        mensajeError = "";
    }

    private async Task GuardarProducto()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (productoActual.Id == 0)
            {
                await ProductoHttpService.CreateProductoAsync(productoActual);
            }
            else
            {
                await ProductoHttpService.UpdateProductoAsync(productoActual);
            }

            await CargarProductos();
            CerrarModal();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarProducto(int id)
    {
        try
        {
            var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
                "¿Está seguro de eliminar este producto?");

            if (confirmado)
            {
                await ProductoHttpService.DeleteProductoAsync(id);
                await CargarProductos();
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
    }

    private string GetBadgeStock(Producto producto)
    {
        if (producto.Stock == 0) return "bg-danger";
        if (producto.Stock <= producto.StockMinimo) return "bg-warning text-dark";
        return "bg-success";
    }
}