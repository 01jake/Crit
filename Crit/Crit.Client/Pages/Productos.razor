@page "/productos"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ClienteHttpService ClienteHttpService
@inject ProductoHttpService ProductoHttpService

@inject IJSRuntime JSRuntime


<PageTitle>Productos</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Inventario</h2>
        <button class="btn btn-primary" @onclick="MostrarModalNuevo">
            <i class="bi bi-plus-circle"></i> Nuevo Producto
        </button>
    </div>

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <!-- Buscador y filtros -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control" placeholder="Buscar por código o nombre..."
                               @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" @bind="filtroCategoria">
                            <option value="todas">Todas las categorías</option>
                            @foreach (var categoria in categorias)
                            {
                                <option value="@categoria">@categoria</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" @bind="filtroStock">
                            <option value="todos">Todos</option>
                            <option value="disponible">Disponible</option>
                            <option value="bajo">Stock Bajo</option>
                            <option value="agotado">Agotado</option>
                        </select>
                    </div>
                </div>

                <!-- Tabla -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Precio Compra</th>
                                <th>Precio Venta</th>
                                <th>Stock</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in ProductosFiltrados)
                            {
                                <tr class="@(producto.Stock <= producto.StockMinimo ? "table-warning" : "")">
                                    <td>@producto.Codigo</td>
                                    <td>@producto.Nombre</td>
                                    <td>@producto.Categoria</td>
                                    <td>$@producto.PrecioCompra.ToString("N2")</td>
                                    <td>$@producto.PrecioVenta.ToString("N2")</td>
                                    <td>
                                        <span class="badge @GetBadgeStock(producto)">
                                            @producto.Stock @producto.Unidad
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(producto.Activo ? "bg-success" : "bg-secondary")">
                                            @(producto.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => EditarProducto(producto)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarProducto(producto.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Crear/Editar -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(productoActual.Id == 0 ? "Nuevo Producto" : "Editar Producto")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="productoActual" OnValidSubmit="GuardarProducto">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Código *</label>
                                <InputText class="form-control" @bind-Value="productoActual.Codigo" />
                                <ValidationMessage For="@(() => productoActual.Codigo)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="productoActual.Nombre" />
                                <ValidationMessage For="@(() => productoActual.Nombre)" />
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label">Descripción</label>
                                <InputTextArea class="form-control" @bind-Value="productoActual.Descripcion" rows="2" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Categoría</label>
                                <InputText class="form-control" @bind-Value="productoActual.Categoria" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Unidad</label>
                                <InputText class="form-control" @bind-Value="productoActual.Unidad" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Precio Compra *</label>
                                <InputNumber class="form-control" @bind-Value="productoActual.PrecioCompra" />
                                <ValidationMessage For="@(() => productoActual.PrecioCompra)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Precio Venta *</label>
                                <InputNumber class="form-control" @bind-Value="productoActual.PrecioVenta" />
                                <ValidationMessage For="@(() => productoActual.PrecioVenta)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Stock *</label>
                                <InputNumber class="form-control" @bind-Value="productoActual.Stock" />
                                <ValidationMessage For="@(() => productoActual.Stock)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Stock Mínimo *</label>
                                <InputNumber class="form-control" @bind-Value="productoActual.StockMinimo" />
                                <ValidationMessage For="@(() => productoActual.StockMinimo)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="productoActual.Activo" />
                                    <label class="form-check-label">Activo</label>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Producto> productos = new();
    private Producto productoActual = new();
    private bool loading = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroCategoria = "todas";
    private string filtroStock = "todos";
    private string mensajeError = "";
    private List<string> categorias = new();

    private IEnumerable<Producto> ProductosFiltrados
    {
        get
        {
            return productos.Where(p =>
                (string.IsNullOrEmpty(terminoBusqueda) ||
                 p.Codigo.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                 p.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) &&
                (filtroCategoria == "todas" || p.Categoria == filtroCategoria) &&
                (filtroStock == "todos" ||
                 (filtroStock == "disponible" && p.Stock > p.StockMinimo) ||
                 (filtroStock == "bajo" && p.Stock <= p.StockMinimo && p.Stock > 0) ||
                 (filtroStock == "agotado" && p.Stock == 0))
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        loading = false;
    }

    private async Task CargarProductos()
    {
        try
        {
            productos = await ProductoHttpService.GetProductosAsync();
            categorias = productos.Where(p => !string.IsNullOrEmpty(p.Categoria))
                                 .Select(p => p.Categoria!)
                                 .Distinct()
                                 .OrderBy(c => c)
                                 .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
    }

    private void MostrarModalNuevo()
    {
        productoActual = new Producto
        {
            Activo = true,
            StockMinimo = 5,
            Unidad = "Pieza"
        };
        mensajeError = "";
        mostrarModal = true;
    }

    private void EditarProducto(Producto producto)
    {
        productoActual = new Producto
        {
            Id = producto.Id,
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            PrecioCompra = producto.PrecioCompra,
            PrecioVenta = producto.PrecioVenta,
            Stock = producto.Stock,
            StockMinimo = producto.StockMinimo,
            Categoria = producto.Categoria,
            Unidad = producto.Unidad,
            Activo = producto.Activo
        };
        mensajeError = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        productoActual = new();
        mensajeError = "";
    }

    private async Task GuardarProducto()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (productoActual.Id == 0)
            {
                await ProductoHttpService.CreateProductoAsync(productoActual);
            }
            else
            {
                await ProductoHttpService.UpdateProductoAsync(productoActual);
            }

            await CargarProductos();
            CerrarModal();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarProducto(int id)
    {
        try
        {
            var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
                "¿Está seguro de eliminar este producto?");

            if (confirmado)
            {
                await ProductoHttpService.DeleteProductoAsync(id);
                await CargarProductos();
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
    }

    private string GetBadgeStock(Producto producto)
    {
        if (producto.Stock == 0) return "bg-danger";
        if (producto.Stock <= producto.StockMinimo) return "bg-warning text-dark";
        return "bg-success";
    }
}