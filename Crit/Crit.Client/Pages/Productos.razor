        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='rgba%280, 0, 0, 0.25%29'/%3e%3c/svg%3e");
    }
</style>

@code {
    private List<Proveedor> proveedores = new();
    private List<Producto> productos = new();
    private Producto productoActual = new();
    private bool loading = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroCategoria = "todas";
    private string filtroStock = "todos";
    private string mensajeError = "";
    private List<string> categorias = new();

    protected override async Task LoadDataAsync()
    {
        loading = true;
        mensajeError = "";
        proveedores = await ProveedorHttpService.GetAsync() ?? new();

        try
        {
            await CargarProductos();
        }
        finally
        {
            loading = false;
        }
    }

    protected override bool ShouldRetryInitialLoad() => !productos.Any();

    private IEnumerable<Producto> ProductosFiltrados => productos.Where(p =>
        (string.IsNullOrEmpty(terminoBusqueda) ||
         p.Codigo.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
         p.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) &&
        (filtroCategoria == "todas" || p.Categoria == filtroCategoria) &&
        (filtroStock == "todos" ||
         (filtroStock == "disponible" && p.Stock > p.StockMinimo) ||
         (filtroStock == "bajo" && p.Stock <= p.StockMinimo && p.Stock > 0) ||
         (filtroStock == "agotado" && p.Stock == 0))
    );

    private async Task CargarProductos()
    {
        try
        {
            productos = await ProductoHttpService.GetProductosAsync();
            categorias = productos.Where(p => !string.IsNullOrWhiteSpace(p.Categoria))
                .Select(p => p.Categoria!)
                .Distinct()
                .OrderBy(x => x)
                .ToList();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void MostrarModalNuevo()
    {
        productoActual = new Producto
        {
            Activo = true,
            StockMinimo = 5,
            Unidad = "Pieza",
            ProveedorId = null
        };

        mensajeError = "";
        mostrarModal = true;
    }

    private void EditarProducto(Producto producto)
    {
        productoActual = new Producto
        {
            Id = producto.Id,
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            PrecioCompra = producto.PrecioCompra,
            PrecioVenta = producto.PrecioVenta,
            Stock = producto.Stock,
            StockMinimo = producto.StockMinimo,
            Categoria = producto.Categoria,
            Unidad = producto.Unidad,
            Activo = producto.Activo,
            ProveedorId = producto.ProveedorId,
            Proveedor = producto.Proveedor
        };

        mensajeError = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        productoActual = new();
        mensajeError = "";
    }

    private async Task GuardarProducto()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (productoActual.Id == 0)
                await ProductoHttpService.CreateProductoAsync(productoActual);
            else
                await ProductoHttpService.UpdateProductoAsync(productoActual);

            await CargarProductos();
            CerrarModal();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarProducto(int id)
    {
        try
        {
            var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar producto?");
            if (!confirmado)
                return;

            await ProductoHttpService.DeleteProductoAsync(id);
            await CargarProductos();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }
}
