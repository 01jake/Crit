@page "/productos/{Id:int}"
@using Crit.Client.Services
@using Crit.Shared.DTOs
@using Crit.Shared.Models
@inject ProductoHttpService ProductoHttpService
@inject InventarioAlmacenHttpService InventarioAlmacenHttpService
@inject KardexHttpService KardexHttpService
@inject ReabastecimientoHttpService ReabastecimientoHttpService
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject NavigationManager Navigation

<PageTitle>Detalle de Producto</PageTitle>

<div class="pos-container px-4 py-4">
    @if (cargando)
    {
        <div class="d-flex justify-content-center align-items-center py-5" style="min-height: 300px;">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (producto is null)
    {
        <div class="alert alert-warning rounded-3 shadow-sm d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
            <div>
                <h6 class="mb-1 fw-bold">Producto no encontrado</h6>
                <p class="mb-0 small">El identificador no corresponde a ningún registro.</p>
            </div>
        </div>
    }
    else
    {
        @* --- ENCABEZADO --- *@
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3 page-header-magic p-3 rounded-4 bg-white shadow-sm border border-light">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-soft-dark text-dark rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="bi bi-box-seam fs-2"></i>
                </div>
                <div>
                    <h2 class="page-title mb-0 fw-bold text-dark">@producto.Nombre</h2>
                    <span class="text-muted font-monospace bg-light px-2 py-1 rounded small border">@producto.Codigo</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-white text-dark border fw-semibold" href="/kardex?productoId=@producto.Id">
                    <i class="bi bi-journal-text me-2 text-primary"></i>Historial Completo
                </a>
                <button class="btn btn-light border fw-semibold shadow-sm" @onclick="Volver">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </button>
            </div>
        </div>

        @* --- RESUMEN DE INDICADORES (KPIs) --- *@
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="card kpi-card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Stock Global</div>
                        <h2 class="fw-bolder @(producto.Stock <= producto.StockMinimo ? "text-danger" : "text-primary") mb-0">
                            @producto.Stock.ToString("N2")
                        </h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card kpi-card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Stock Mínimo</div>
                        <h2 class="fw-bolder text-warning mb-0">@producto.StockMinimo.ToString("N2")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card kpi-card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Costo Promedio</div>
                        <h2 class="fw-bolder text-dark mb-0">@producto.PrecioCompra.ToString("C")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card kpi-card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-muted small text-uppercase fw-bold mb-2">Precio de Venta</div>
                        <h2 class="fw-bolder text-success mb-0">@producto.PrecioVenta.ToString("C")</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            @* COLUMNA PRINCIPAL (TABLAS) *@
            <div class="col-lg-8">
                @* Inventario por Almacén *@
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4 bg-white">
                    <div class="card-header bg-white border-bottom-0 py-3 px-4">
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-geo-alt me-2 text-primary"></i>Ubicación en Almacenes</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-table">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Almacén</th>
                                    <th class="text-end">Stock</th>
                                    <th class="text-end">Mínimo</th>
                                    <th class="text-end pe-4">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in inventarioPorAlmacen)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.Almacen?.Nombre</td>
                                        <td class="text-end fw-bold">
                                            <span class="@(item.Stock <= item.StockMinimo ? "text-danger" : "text-primary")">
                                                @item.Stock.ToString("N2")
                                            </span>
                                        </td>
                                        <td class="text-end text-muted">@item.StockMinimo.ToString("N2")</td>
                                        <td class="text-end pe-4">
                                            @if (item.Stock <= 0)
                                            {
                                                <span class="dot bg-danger"></span>
                                            }
                                            else if (item.Stock <= item.StockMinimo)
                                            {

                                                <span class="dot bg-warning"></span>
                                            }
                                            else
                                            {

                                                <span class="dot bg-success"></span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Kardex Reciente (Sin conceptos) *@
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                    <div class="card-header bg-white border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Kardex Reciente</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-table">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Fecha Movimiento</th>
                                    <th>Almacén</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end pe-4">Balance Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in kardexReciente)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold text-dark">@mov.Fecha.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@mov.Fecha.ToString("HH:mm")</div>
                                        </td>
                                        <td class="text-secondary">@mov.Almacen</td>
                                        <td class="text-end fw-bold @(mov.Cantidad < 0 ? "text-danger" : "text-success")">
                                            @(mov.Cantidad > 0 ? "+" : "")@mov.Cantidad.ToString("N2")
                                        </td>
                                        <td class="text-end pe-4 text-dark fw-bold">@mov.StockNuevo.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* COLUMNA LATERAL (DATOS FIJOS) *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 mb-4 information-card bg-white">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <h6 class="mb-0 fw-bold text-dark">Información General</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="info-block mb-3">
                            <label>Nombre del Producto</label>
                            <p class="fw-semibold text-dark">@producto.Nombre</p>
                        </div>
                        <div class="info-block mb-3">
                            <label>Código Interno</label>
                            <p class="text-muted">@producto.Codigo</p>
                        </div>
                        <div class="info-block pt-3 border-top">
                            <label>Estatus</label>
                            <span class="@(producto.Activo ? "badge-status status-active" : "badge-status status-inactive")">
                                <i class="bi bi-circle-fill me-2" style="font-size: 8px;"></i> @(producto.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>
                    </div>
                </div>

                @* Reabastecimiento Card *@
                <div class="card shadow-sm border-0 rounded-4 bg-warning-subtle border-warning border">
                    <div class="card-body p-4 text-center">
                        <h6 class="fw-bold text-warning-emphasis mb-3">Reabastecimiento</h6>
                        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 mb-3 border border-warning">
                            <span class="text-muted small">Pendientes:</span>
                            <span class="fw-bold fs-4 text-dark">@ordenesReabastecimiento.Count</span>
                        </div>
                        <a class="btn btn-warning w-100 fw-bold text-warning-emphasis" href="/reabastecimiento">
                            Ir a Reabastecimiento
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pos-container {
        background-color: #f8f9fa;
        min-height: 100vh;
        font-family: 'Segoe UI', Roboto, sans-serif;
    }

    /* Soft Colors */
    .bg-soft-dark {
        background-color: #f0f2f5;
    }

    .btn-white {
        background-color: #ffffff;
    }

    /* KPI Cards */
    .kpi-card {
        border: 1px solid rgba(0,0,0,.05);
    }

    /* Info Blocks (Ficha Técnica) */
    .info-block label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 700;
        color: #99a1b7;
        margin-bottom: 2px;
    }

    .info-block p {
        margin-bottom: 0;
        font-size: 14px;
    }

    /* Tables */
    .custom-table thead th {
        border: none;
        font-size: 11px;
        color: #7e8299;
        padding: 15px 10px;
    }

    .custom-table tbody td {
        border-color: #f4f4f4;
        padding: 12px 10px;
        font-size: 13.5px;
    }

    /* Badges & Dots */
    .dot {
        height: 8px;
        width: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .badge-status {
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
    }

    .status-active {
        background-color: #e8fff3;
        color: #50cd89;
    }

    .status-inactive {
        background-color: #fff5f8;
        color: #f1416c;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Producto? producto;
    private List<InventarioPorAlmacen> inventarioPorAlmacen = new();
    private List<KardexMovimientoDto> kardexReciente = new();
    private List<OrdenReabastecimiento> ordenesReabastecimiento = new();
    private bool cargando = true;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        producto = await ProductoHttpService.GetProductoAsync(Id);
        inventarioPorAlmacen = await InventarioAlmacenHttpService.GetPorProductoAsync(Id);
        kardexReciente = await KardexHttpService.GetAsync(productoId: Id);
        ordenesReabastecimiento = (await ReabastecimientoHttpService.GetAsync())
            .Where(x => x.ProductoId == Id && x.Estado != "Completada" && x.Estado != "Cancelada")
            .ToList();

        kardexReciente = kardexReciente
            .OrderByDescending(x => x.Fecha)
            .Take(8)
            .ToList();

        cargando = false;
    }

    private void Volver()
    {
        Navigation.NavigateTo("/productos");
    }
    private string ObtenerBadgeConcepto(string concepto)
    {
        return "badge-concepto-entrada"; // Clase CSS dummy definida arriba
    }
    private static string ObtenerBadge(string? tipo) => tipo switch
    {
        "EntradaCompra" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "SalidaVenta" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        "TraspasoEntrada" => "badge rounded-pill text-bg-info-subtle text-info border border-info",
        "TraspasoSalida" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        _ => "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary"
    };
}
