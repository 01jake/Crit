@page "/productos/{Id:int}"
@using Crit.Client.Services
@using Crit.Shared.DTOs
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor,Usuario")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ProductoHttpService ProductoHttpService
@inject InventarioAlmacenHttpService InventarioAlmacenHttpService
@inject KardexHttpService KardexHttpService
@inject ReabastecimientoHttpService ReabastecimientoHttpService
@inject NavigationManager Navigation

<PageTitle>Detalle de Producto</PageTitle>

<div class="pos-container px-5 py-4">
    @if (cargando)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">Cargando detalle del producto...</p>
        </div>
    }
    else if (producto is null)
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-box-seam fs-1 text-warning mb-3"></i>
                <h4 class="text-muted">Producto no encontrado</h4>
                <button class="btn btn-outline-primary mt-3" @onclick="Volver">Regresar</button>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="product-avatar shadow-sm">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h2 class="page-title mb-0">@producto.Nombre</h2>
                    <div class="d-flex flex-wrap gap-2 mt-1">
                        <span class="badge bg-light text-dark border fw-semibold">@producto.Codigo</span>
                        <span class="@(producto.Activo ? "badge rounded-pill text-bg-success-subtle text-success border border-success" : "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary")">
                            @(producto.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a class="btn btn-light border shadow-sm" href="/kardex?productoId=@producto.Id">
                    <i class="bi bi-journal-text me-2 text-primary"></i>Historial Completo
                </a>
                <button class="btn btn-light border shadow-sm" @onclick="Volver">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </button>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon @(producto.Stock <= producto.StockMinimo ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") me-3">
                                <i class="bi bi-boxes"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Stock Global</span>
                        </div>
                        <h3 class="fw-bold mb-0 @(producto.Stock <= producto.StockMinimo ? "text-danger" : "text-primary")">
                            @producto.Stock.ToString("N2")
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-warning-subtle text-warning me-3">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Stock Mínimo</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-warning">@producto.StockMinimo.ToString("N2")</h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-secondary-subtle text-secondary me-3">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Costo Promedio</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-dark">@producto.PrecioCompra.ToString("C")</h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-success-subtle text-success me-3">
                                <i class="bi bi-tags"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Precio Venta</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-success">@producto.PrecioVenta.ToString("C")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white border-bottom-0 py-3 px-4">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-geo-alt me-2 text-primary"></i>Ubicación en Almacenes
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8fafc;">
                                <tr>
                                    <th class="ps-4">Almacén</th>
                                    <th class="text-end">Stock</th>
                                    <th class="text-end">Mínimo</th>
                                    <th class="text-center pe-4">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in inventarioPorAlmacen)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@item.Almacen?.Nombre</td>
                                        <td class="text-end fw-bold @(item.Stock <= item.StockMinimo ? "text-danger" : "text-primary")">
                                            @item.Stock.ToString("N2")
                                        </td>
                                        <td class="text-end text-muted">@item.StockMinimo.ToString("N2")</td>
                                        <td class="text-center pe-4">
                                            @if (item.Stock <= 0)
                                            {
                                                <span class="inventory-dot bg-danger"></span>
                                            }
                                            else if (item.Stock <= item.StockMinimo)
                                            {
                                                <span class="inventory-dot bg-warning"></span>
                                            }
                                            else
                                            {
                                                <span class="inventory-dot bg-success"></span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-lg-none mb-4">
                    @foreach (var item in inventarioPorAlmacen)
                    {
                        <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">@item.Almacen?.Nombre</h6>
                                        <span class="extra-small text-muted">Inventario por almacén</span>
                                    </div>
                                    <span class="inventory-dot-label @(item.Stock <= 0 ? "bg-danger-subtle text-danger" : item.Stock <= item.StockMinimo ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success")">
                                        @(item.Stock <= 0 ? "Sin stock" : item.Stock <= item.StockMinimo ? "Bajo" : "Correcto")
                                    </span>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="text-muted extra-small">Stock</div>
                                        <div class="small fw-bold @(item.Stock <= item.StockMinimo ? "text-danger" : "text-primary")">
                                            @item.Stock.ToString("N2")
                                        </div>
                                    </div>
                                    <div class="col-6 text-end">
                                        <div class="text-muted extra-small">Mínimo</div>
                                        <div class="small text-dark">@item.StockMinimo.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 py-3 px-4">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-clock-history me-2 text-primary"></i>Kardex Reciente
                        </h6>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8fafc;">
                                <tr>
                                    <th class="ps-4">Fecha Movimiento</th>
                                    <th>Almacén</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end pe-4">Balance Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in kardexReciente)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold text-dark">@mov.Fecha.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@mov.Fecha.ToString("HH:mm")</div>
                                        </td>
                                        <td class="text-secondary">@mov.Almacen</td>
                                        <td class="text-end fw-bold @(mov.Cantidad < 0 ? "text-danger" : "text-success")">
                                            @(mov.Cantidad > 0 ? "+" : "")@mov.Cantidad.ToString("N2")
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-dark">@mov.StockNuevo.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-lg-none">
                    @foreach (var mov in kardexReciente)
                    {
                        <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">@mov.Almacen</h6>
                                        <span class="extra-small text-muted">@mov.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="fw-bold @(mov.Cantidad < 0 ? "text-danger" : "text-success")">
                                        @(mov.Cantidad > 0 ? "+" : "")@mov.Cantidad.ToString("N2")
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="text-muted extra-small">Movimiento</div>
                                        <div class="small">Stock</div>
                                    </div>
                                    <div class="col-6 text-end">
                                        <div class="text-muted extra-small">Balance</div>
                                        <div class="small fw-bold text-dark">@mov.StockNuevo.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header text-white border-0 py-3 px-4" style="background-color: #1F2A44;">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-info-circle me-2"></i>Información General
                        </h6>
                    </div>

                    <div class="card-body p-4">
                        <div class="info-block mb-3">
                            <label>Nombre del Producto</label>
                            <p class="fw-semibold text-dark">@producto.Nombre</p>
                        </div>

                        <div class="info-block mb-3">
                            <label>Código Interno</label>
                            <p class="text-muted">@producto.Codigo</p>
                        </div>

                        <div class="info-block mb-3">
                            <label>Costo Promedio</label>
                            <p class="text-dark">@producto.PrecioCompra.ToString("C")</p>
                        </div>

                        <div class="info-block mb-3">
                            <label>Precio de Venta</label>
                            <p class="text-success fw-bold">@producto.PrecioVenta.ToString("C")</p>
                        </div>

                        <div class="info-block pt-3 border-top">
                            <label>Estatus</label>
                            <span class="@(producto.Activo ? "badge rounded-pill text-bg-success-subtle text-success border border-success" : "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary")">
                                @(producto.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4 reabastecimiento-card">
                    <div class="card-header border-0 py-3 px-4">
                        <h6 class="mb-0 fw-bold text-warning-emphasis">
                            <i class="bi bi-arrow-repeat me-2"></i>Reabastecimiento
                        </h6>
                    </div>

                    <div class="card-body p-4">
                        <div class="summary-box-soft mb-3">
                            <div class="text-muted small">Pendientes</div>
                            <div class="fw-bold fs-3 text-dark">@ordenesReabastecimiento.Count</div>
                        </div>

                        <a class="btn btn-warning w-100 fw-bold text-warning-emphasis" href="/reabastecimiento">
                            Ir a Reabastecimiento
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }

    .product-avatar {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .stat-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
        }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.3rem;
    }

    .table thead th {
        font-weight: 600;
        letter-spacing: 0.5px;
        border-top: none;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .detail-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
    }

    .inventory-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        display: inline-block;
    }

    .inventory-dot-label {
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .info-block label {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #94a3b8;
        margin-bottom: 0.25rem;
    }

    .info-block p {
        margin-bottom: 0;
        font-size: 0.98rem;
    }

    .summary-box-soft {
        background: rgba(255,255,255,0.7);
        border: 1px solid rgba(161,98,7,0.18);
        border-radius: 1rem;
        padding: 1rem;
        text-align: center;
    }

    .reabastecimiento-card {
        background: #fef3c7;
        border: 1px solid #fde68a !important;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Producto? producto;
    private List<InventarioPorAlmacen> inventarioPorAlmacen = new();
    private List<KardexMovimientoDto> kardexReciente = new();
    private List<OrdenReabastecimiento> ordenesReabastecimiento = new();
    private bool cargando = true;

    protected override async Task LoadDataAsync()
    {
        await CargarProductoAsync();
    }

    protected override bool ShouldRetryInitialLoad() => producto is null;

    private async Task CargarProductoAsync()
    {
        cargando = true;

        try
        {
            producto = await ProductoHttpService.GetProductoAsync(Id);
            inventarioPorAlmacen = await InventarioAlmacenHttpService.GetPorProductoAsync(Id);
            kardexReciente = await KardexHttpService.GetAsync(productoId: Id);
            ordenesReabastecimiento = (await ReabastecimientoHttpService.GetAsync())
                .Where(x => x.ProductoId == Id && x.Estado != "Completada" && x.Estado != "Cancelada")
                .ToList();

            kardexReciente = kardexReciente
                .OrderByDescending(x => x.Fecha)
                .Take(8)
                .ToList();
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsLoading)
        {
            await CargarProductoAsync();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/productos");
    }
}
