@page "/compras/{Id:int}"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject CompraHttpService CompraHttpService
@inject NavigationManager Navigation
@inject PdfHttpService PdfHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Detalle de Compra</PageTitle>

<div class="pos-container px-5 py-4">
    @if (cargando)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">Cargando detalle de la compra...</p>
        </div>
    }
    else if (compra is null)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x fs-1 text-warning mb-3"></i>
            <h4 class="text-muted">Compra no encontrada</h4>
            <button class="btn btn-outline-primary mt-3" @onclick="Volver">Regresar al listado</button>
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 56px; height: 56px; font-size: 1.5rem;">
                    <i class="bi bi-bag-check"></i>
                </div>
                <div>
                    <h2 class="page-title mb-0">Compra @((compra.SerieFactura ?? "") + " " + (compra.FolioFactura ?? ""))</h2>
                    <p class="text-muted small mb-0">Registro de entrada de mercancía e insumos</p>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-light border shadow-sm" @onclick="Volver">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </button>
                <button class="btn btn-danger shadow-sm" @onclick="DescargarPdf">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
                </button>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-primary-subtle text-primary me-3">
                                <i class="bi bi-truck"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Proveedor</span>
                        </div>
                        <h4 class="fw-bold mb-0 text-truncate fs-5" title="@(compra.Proveedor?.Nombre)">
                            @(compra.Proveedor?.Nombre ?? "N/A")
                        </h4>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-info-subtle text-info me-3">
                                <i class="bi bi-calendar-check"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Fecha Registro</span>
                        </div>
                        <h4 class="fw-bold mb-0 fs-5">@compra.Fecha.ToString("dd/MM/yyyy")</h4>
                        <div class="text-muted small">@compra.Fecha.ToString("HH:mm") hrs</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-secondary-subtle text-secondary me-3">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Estado</span>
                        </div>
                        <div class="mt-2">
                            <span class="@ObtenerBadgeEstado(compra.Estado) px-3 py-2 fs-6">@compra.Estado</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-success-subtle text-success me-3">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Total Compra</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-success">@compra.Total.ToString("C")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-white border-bottom-0 py-3 px-4">
                <h6 class="fw-bold mb-0 text-dark">Información General</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="info-box">
                            <div class="info-label">Serie / Folio</div>
                            <div class="info-value">@((compra.SerieFactura ?? "S/S") + " " + (compra.FolioFactura ?? "S/F"))</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-box">
                            <div class="info-label">RFC Proveedor</div>
                            <div class="info-value">@(string.IsNullOrWhiteSpace(compra.RFCProveedor) ? "N/A" : compra.RFCProveedor)</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-box">
                            <div class="info-label">Fecha Factura</div>
                            <div class="info-value">@((compra.FechaFactura == default ? "-" : compra.FechaFactura.ToString("dd/MM/yyyy")))</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-box">
                            <div class="info-label">Tipo de Compra</div>
                            <div class="info-value">@(compra.EsCredito ? "Crédito" : "Contado")</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-box">
                            <div class="info-label">Días de Crédito</div>
                            <div class="info-value">@(compra.DiasCredito?.ToString() ?? "-")</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="info-box">
                            <div class="info-label">Productos</div>
                            <div class="info-value">@compra.Detalles.Count</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom-0 py-3 px-4">
                <h6 class="fw-bold mb-0 text-dark">Detalle de Productos</h6>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th class="ps-4">Producto</th>
                            <th class="text-end">Cantidad</th>
                            <th class="text-end">Precio Unitario</th>
                            <th class="text-end pe-4">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in compra.Detalles)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@detalle.Producto?.Nombre</div>
                                    <div class="small text-muted">@detalle.Producto?.Codigo</div>
                                </td>
                                <td class="text-end fw-semibold">@detalle.Cantidad.ToString("N2")</td>
                                <td class="text-end">@detalle.PrecioUnitario.ToString("C")</td>
                                <td class="text-end pe-4 fw-bold text-primary">@detalle.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-lg-none mb-4">
            @foreach (var detalle in compra.Detalles)
            {
                <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                    <div class="card-body p-3">
                        <div class="fw-bold text-dark">@detalle.Producto?.Nombre</div>
                        <div class="small text-muted mb-3">@detalle.Producto?.Codigo</div>

                        <div class="row g-2">
                            <div class="col-4">
                                <div class="text-muted extra-small">Cantidad</div>
                                <div class="small fw-semibold">@detalle.Cantidad.ToString("N2")</div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="text-muted extra-small">P. Unitario</div>
                                <div class="small">@detalle.PrecioUnitario.ToString("C")</div>
                            </div>
                            <div class="col-4 text-end">
                                <div class="text-muted extra-small">Subtotal</div>
                                <div class="small fw-bold text-primary">@detalle.Subtotal.ToString("C")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 py-3 px-4">
                <h6 class="fw-bold mb-0 text-dark">Resumen Financiero</h6>
            </div>
            <div class="card-body p-4">
                <div class="summary-box">
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>@compra.Subtotal.ToString("C")</span>
                    </div>
                    <div class="summary-row">
                        <span>IVA</span>
                        <span>@compra.IVA.ToString("C")</span>
                    </div>
                    <div class="summary-total">
                        <span>Total</span>
                        <span>@compra.Total.ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.4rem;
    }

    .stat-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
        }

    .table thead th {
        font-weight: 600;
        letter-spacing: 0.5px;
        border-top: none;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.9rem;
        padding: 1rem;
        height: 100%;
    }

    .info-label {
        font-size: 0.72rem;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
    }

    .info-value {
        font-weight: 600;
        color: #0f172a;
    }

    .summary-box {
        max-width: 420px;
        margin-left: auto;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.65rem;
        color: #64748b;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px dashed #cbd5e1;
        font-weight: 800;
        font-size: 1.1rem;
        color: #0f172a;
    }

    .detail-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Compra? compra;
    private bool cargando = true;

    protected override async Task LoadDataAsync()
    {
        await CargarCompraAsync();
    }

    protected override bool ShouldRetryInitialLoad() => compra is null;

    private async Task CargarCompraAsync()
    {
        cargando = true;

        try
        {
            compra = await CompraHttpService.GetCompraAsync(Id);
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsLoading)
        {
            await CargarCompraAsync();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/compras");
    }

    private async Task DescargarPdf()
    {
        try
        {
            await PdfHttpService.DescargarCompraPdfAsync(Id);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al descargar PDF: {ex.Message}");
        }
    }

    private static string ObtenerBadgeEstado(string? estado) => estado switch
    {
        "Completada" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "Pendiente" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        "Cancelada" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        _ => "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary"
    };
}
