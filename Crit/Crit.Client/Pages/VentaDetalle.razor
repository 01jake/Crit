@page "/ventas/{Id:int}"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor,Usuario")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject VentaHttpService VentaHttpService
@inject PdfHttpService PdfHttpService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Detalle de Venta</PageTitle>

<div class="pos-container px-5 py-4">
    @if (cargando)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">Cargando detalle de la venta...</p>
        </div>
    }
    else if (venta is null)
    {
        <div class="text-center py-5">
            <i class="bi bi-receipt-cutoff fs-1 text-warning mb-3"></i>
            <h4 class="text-muted">Venta no encontrada</h4>
            <button class="btn btn-outline-primary mt-3" @onclick="Volver">Regresar al listado</button>
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="sale-avatar shadow-sm">
                    <i class="bi bi-cart-check"></i>
                </div>
                <div>
                    <h2 class="page-title mb-0">Venta @venta.NumeroVenta</h2>
                    <p class="text-muted small mb-0">Detalle completo de la operación</p>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-light border shadow-sm" @onclick="Volver">
                    <i class="bi bi-arrow-left me-2"></i>Volver
                </button>
                <button class="btn btn-danger shadow-sm" @onclick="DescargarPdf">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Descargar PDF
                </button>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-primary-subtle text-primary me-3">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Cliente</span>
                        </div>
                        <h4 class="fw-bold mb-0 text-truncate fs-5" title="@((venta.Cliente?.Nombre) ?? "Público General")">
                            @((venta.Cliente?.Nombre) ?? "Público General")
                        </h4>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-info-subtle text-info me-3">
                                <i class="bi bi-calendar-event"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Fecha</span>
                        </div>
                        <h4 class="fw-bold mb-0 fs-5">@venta.Fecha.ToString("dd/MM/yyyy")</h4>
                        <div class="text-muted small">@venta.Fecha.ToString("HH:mm") hrs</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-secondary-subtle text-secondary me-3">
                                <i class="bi bi-activity"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Estado</span>
                        </div>
                        <div class="mt-2">
                            <span class="@ObtenerBadgeEstado(venta.Estado) px-3 py-2 fs-6">@venta.Estado</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-success-subtle text-success me-3">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Total</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-success">@venta.Total.ToString("C")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 py-3 px-4">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-box-seam me-2 text-primary"></i>Productos Vendidos
                        </h6>
                    </div>

                    @if (!venta.Detalles.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted mb-0">No hay detalles registrados para esta venta.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background-color: #f8fafc;">
                                    <tr>
                                        <th class="ps-4">Producto</th>
                                        <th class="text-center">Cant.</th>
                                        <th class="text-end">Precio Unit.</th>
                                        <th class="text-end pe-4">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in venta.Detalles)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@detalle.Producto?.Nombre</div>
                                                <div class="text-muted small">
                                                    <i class="bi bi-upc-scan me-1"></i>@detalle.Producto?.Codigo
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-2 py-1">@detalle.Cantidad</span>
                                            </td>
                                            <td class="text-end text-muted">@detalle.PrecioUnitario.ToString("C")</td>
                                            <td class="text-end pe-4 fw-bold text-dark">@detalle.Subtotal.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="d-lg-none">
                    @if (!venta.Detalles.Any())
                    {
                        <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                            <p class="text-muted mb-0">No hay detalles registrados para esta venta.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var detalle in venta.Detalles)
                        {
                            <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div style="max-width: 70%;">
                                            <h6 class="fw-bold mb-0 text-dark">@detalle.Producto?.Nombre</h6>
                                            <span class="extra-small text-muted">
                                                <i class="bi bi-upc-scan me-1"></i>@detalle.Producto?.Codigo
                                            </span>
                                        </div>
                                        <div class="fw-bold text-dark">@detalle.Subtotal.ToString("C")</div>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="text-muted extra-small">Cantidad</div>
                                            <div class="small fw-semibold">@detalle.Cantidad</div>
                                        </div>
                                        <div class="col-6 text-end">
                                            <div class="text-muted extra-small">P. Unitario</div>
                                            <div class="small text-muted">@detalle.PrecioUnitario.ToString("C")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-header text-white border-0 py-3 px-4" style="background-color: #1F2A44;">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-calculator me-2"></i>Resumen Financiero
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="ticket-summary">
                            <div class="summary-row">
                                <span>Subtotal</span>
                                <span>@venta.Subtotal.ToString("C")</span>
                            </div>
                            <div class="summary-row">
                                <span>Descuento</span>
                                <span class="text-danger">@venta.Descuento.ToString("C")</span>
                            </div>
                            <div class="summary-row">
                                <span>I.V.A.</span>
                                <span>@venta.IVA.ToString("C")</span>
                            </div>
                            <div class="summary-total">
                                <span>Total</span>
                                <span>@venta.Total.ToString("C")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-header text-white border-0 py-3 px-4" style="background-color: #2563eb;">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-credit-card me-2"></i>Datos de Facturación y Pago
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-xl-12">
                                <div class="detail-box">
                                    <div class="detail-label">Método de pago</div>
                                    <div class="detail-value">@((venta.MetodoPago) ?? "-")</div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6 col-xl-12">
                                <div class="detail-box">
                                    <div class="detail-label">Forma de pago</div>
                                    <div class="detail-value">@((venta.FormaPago) ?? "-")</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="detail-box">
                                    <div class="detail-label">Uso CFDI</div>
                                    <div class="detail-value">@((venta.UsoCFDI) ?? "-")</div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="notes-box">
                                    <div class="detail-label text-warning-emphasis">
                                        <i class="bi bi-journal-text me-1"></i>Notas internas
                                    </div>
                                    <div class="small text-dark">@((venta.Notas) ?? "Sin notas adicionales en esta venta.")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }

    .sale-avatar {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: #ecfdf5;
        color: #16a34a;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.4rem;
    }

    .stat-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
        }

    .table thead th {
        font-weight: 600;
        letter-spacing: 0.5px;
        border-top: none;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .detail-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
    }

    .ticket-summary {
        border-top: 1px solid #e5e7eb;
        padding-top: 1rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.6rem;
        color: #64748b;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-top: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px dashed #cbd5e1;
        font-weight: 800;
        font-size: 1.1rem;
        color: #0f172a;
    }

    .detail-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1rem;
    }

    .detail-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #94a3b8;
        margin-bottom: 0.35rem;
    }

    .detail-value {
        color: #0f172a;
        font-weight: 600;
    }

    .notes-box {
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 1rem;
        padding: 1rem;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Venta? venta;
    private bool cargando = true;

    protected override async Task LoadDataAsync()
    {
        await CargarVentaAsync();
    }

    protected override bool ShouldRetryInitialLoad() => venta is null;

    private async Task CargarVentaAsync()
    {
        cargando = true;

        try
        {
            venta = await VentaHttpService.GetVentaConDetallesAsync(Id);
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsLoading)
        {
            await CargarVentaAsync();
        }
    }

    private async Task DescargarPdf()
    {
        if (venta is null)
            return;

        try
        {
            await PdfHttpService.DescargarVentaPdfAsync(venta.Id);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al descargar PDF: {ex.Message}");
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/ventas");
    }

    private static string ObtenerBadgeEstado(string? estado) => estado switch
    {
        "Completada" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "Pendiente" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        "Cancelada" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        _ => "badge rounded-pill text-bg-primary-subtle text-primary border border-primary"
    };
}
