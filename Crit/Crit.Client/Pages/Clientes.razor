@page "/clientes"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject ClienteHttpService ClienteHttpService

@inject IJSRuntime JSRuntime

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Clientes</h2>
        <button class="btn btn-primary" @onclick="MostrarModalNuevo">
            <i class="bi bi-plus-circle"></i> Nuevo Cliente
        </button>
    </div>

    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <!-- Buscador -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control" placeholder="Buscar cliente..."
                               @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" @bind="filtroEstado">
                            <option value="todos">Todos</option>
                            <option value="activos">Activos</option>
                            <option value="inactivos">Inactivos</option>
                        </select>
                    </div>
                </div>

                <!-- Tabla -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>RFC</th>
                                <th>Fecha Registro</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in ClientesFiltrados)
                            {
                                <tr>
                                    <td>@cliente.Nombre</td>
                                    <td>@cliente.Email</td>
                                    <td>@cliente.Telefono</td>
                                    <td>@cliente.RFC</td>
                                    <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @(cliente.Activo ? "bg-success" : "bg-secondary")">
                                            @(cliente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => EditarCliente(cliente)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarCliente(cliente.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal para Crear/Editar Cliente -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(clienteActual.Id == 0 ? "Nuevo Cliente" : "Editar Cliente")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="clienteActual" OnValidSubmit="GuardarCliente">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre *</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Nombre" />
                                <ValidationMessage For="@(() => clienteActual.Nombre)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email *</label>
                                <InputText type="email" class="form-control" @bind-Value="clienteActual.Email" />
                                <ValidationMessage For="@(() => clienteActual.Email)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control" @bind-Value="clienteActual.Telefono" />
                                <ValidationMessage For="@(() => clienteActual.Telefono)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">RFC</label>
                                <InputText class="form-control" @bind-Value="clienteActual.RFC" />
                                <ValidationMessage For="@(() => clienteActual.RFC)" />
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label">Dirección</label>
                                <InputTextArea class="form-control" @bind-Value="clienteActual.Direccion" rows="3" />
                                <ValidationMessage For="@(() => clienteActual.Direccion)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="clienteActual.Activo" />
                                    <label class="form-check-label">Activo</label>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger">@mensajeError</div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {

    private List<Cliente> clientes = new();
    private Cliente clienteActual = new();
    private bool loading = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroEstado = "todos";
    private string mensajeError = "";

    private IEnumerable<Cliente> ClientesFiltrados =>
        clientes.Where(c =>
            (string.IsNullOrEmpty(terminoBusqueda) ||
             c.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
             c.Email.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) &&
            (filtroEstado == "todos" ||
             (filtroEstado == "activos" && c.Activo) ||
             (filtroEstado == "inactivos" && !c.Activo))
        );

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
        loading = false;
    }

    private async Task CargarClientes()
    {
        try
        {
            clientes = await ClienteHttpService.GetClientesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
        }
    }

    private void MostrarModalNuevo()
    {
        clienteActual = new Cliente { Activo = true };
        mensajeError = "";
        mostrarModal = true;
    }

    private void EditarCliente(Cliente cliente)
    {
        clienteActual = new Cliente
        {
            Id = cliente.Id,
            Nombre = cliente.Nombre,
            Email = cliente.Email,
            Telefono = cliente.Telefono,
            RFC = cliente.RFC,
            Direccion = cliente.Direccion,
            Activo = cliente.Activo,
            FechaRegistro = cliente.FechaRegistro
        };
        mensajeError = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        clienteActual = new();
        mensajeError = "";
    }

    private async Task GuardarCliente()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (clienteActual.Id == 0)
            {
                await ClienteHttpService.CreateClienteAsync(clienteActual);
            }
            else
            {
                await ClienteHttpService.UpdateClienteAsync(clienteActual);
            }

            await CargarClientes();
            CerrarModal();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCliente(int id)
    {
        try
        {
            var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar este cliente?");
            if (confirmado)
            {
                await ClienteHttpService.DeleteClienteAsync(id);
                await CargarClientes();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar cliente: {ex.Message}");
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
    }
}
