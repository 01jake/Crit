@page "/clientes"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor,Usuario")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject CuentaPorCobrarHttpService CuentaPorCobrarHttpService
@inject ClienteHttpService ClienteHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Gestion de Clientes</PageTitle>

<div class="pos-container px-5 py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
        <div>
            <h2 class="page-title mb-0">Gestion de Clientes</h2>
            <p class="text-muted small mb-0">Administra la base de clientes y sus datos fiscales</p>
        </div>

        <button class="btn saas-btn-primary shadow-sm px-4 py-2" @onclick="MostrarModalNuevo">
            <i class="bi bi-plus-lg me-2"></i><span>Nuevo Cliente</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-6">
                    <div class="search-box-container">
                        <i class="bi bi-search"></i>
                        <input class="form-control" placeholder="Buscar por nombre o RFC..."
                               @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select class="form-select border-light-subtle" @bind="filtroEstado">
                        <option value="todos">Todos los estados</option>
                        <option value="activos">Solo Activos</option>
                        <option value="inactivos">Inactivos</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 text-md-end text-muted small">
                    Mostrando: <strong>@ClientesFiltrados.Count()</strong> clientes
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (!ClientesFiltrados.Any())
    {
        <div class="card shadow-sm border-0 text-center py-5">
            <i class="bi bi-people fs-1 text-muted mb-3"></i>
            <h5 class="fw-bold text-dark">Sin resultados</h5>
            <p class="text-muted mb-0">No hay clientes con los filtros actuales.</p>
        </div>
    }
    else
    {
        <div class="d-none d-lg-block card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc;">
                        <tr>
                            <th class="ps-4">Cliente / Razon Social</th>
                            <th>Contacto</th>
                            <th>Datos Fiscales</th>
                            <th>Estado</th>
                            <th>Saldo Pendiente</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in ClientesFiltrados)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@c.Nombre</div>
                                    <div class="text-muted extra-small">@c.Direccion</div>
                                </td>
                                <td>
                                    <div class="text-dark small"><i class="bi bi-envelope me-1"></i> @c.Email</div>
                                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i> @(c.Telefono ?? "S/N")</div>
                                </td>
                                <td>
                                    <div class="fw-bold small text-secondary">RFC: @(c.RFC ?? "XAXX010101000")</div>
                                    <div class="text-muted extra-small">CP: @(c.CodigoPostal ?? "S/N")</div>
                                </td>
                                <td>
                                    <span class="status-badge @(c.Activo ? "status-active" : "status-inactive")">
                                        @(c.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var saldo = ObtenerSaldoCliente(c.Id);
                                        var vencida = TieneVencidasCliente(c.Id);
                                    }
                                    <div class="fw-bold @(vencida ? "text-danger" : "text-primary")">@saldo.ToString()</div>
                                    @if (vencida)
                                    {
                                        <div class="extra-small text-danger fw-semibold">Con vencidas</div>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <button type="button" class="btn btn-white btn-sm" title="Editar" @onclick="() => EditarCliente(c)">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                        <a class="btn btn-white btn-sm" href="/cuentas-por-cobrar?clienteId=@c.Id" title="Cuentas por cobrar">
                                            <i class="bi bi-wallet2 text-warning"></i>
                                        </a>
                                        <button type="button" class="btn btn-white btn-sm" title="Eliminar" @onclick="() => EliminarCliente(c.Id)">
                                            <i class="bi bi-trash3 text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-lg-none">
            @foreach (var c in ClientesFiltrados)
            {
                <div class="card shadow-sm border-0 mb-3 customer-mobile-card">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div style="max-width: 70%;">
                                <h6 class="fw-bold mb-0 text-dark text-truncate">@c.Nombre</h6>
                                <span class="extra-small text-muted text-uppercase">RFC: @(c.RFC ?? "S/N")</span>
                            </div>
                            <span class="status-badge @(c.Activo ? "status-active" : "status-inactive")">
                                @(c.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="text-muted extra-small">Contacto</div>
                                <div class="small text-dark text-truncate">@c.Email</div>
                                <div class="small text-muted">@(c.Telefono ?? "S/N")</div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-muted extra-small">Saldo Pendiente</div>
                                @{
                                    var saldoM = ObtenerSaldoCliente(c.Id);
                                    var vencidaM = TieneVencidasCliente(c.Id);
                                }
                                <div class="fw-bold @(vencidaM ? "text-danger" : "text-primary")">@saldoM.ToString("C")</div>
                                @if (vencidaM)
                                {
                                    <div class="extra-small text-danger fw-bold">VENCIDO</div>
                                }
                            </div>
                        </div>

                        <div class="d-flex gap-2 border-top pt-3">
                            <button type="button" class="btn btn-light-primary btn-sm flex-fill" @onclick="() => EditarCliente(c)">
                                <i class="bi bi-pencil-square me-1"></i>Editar
                            </button>
                            <a class="btn btn-light-warning btn-sm flex-fill text-center" href="/cuentas-por-cobrar?clienteId=@c.Id">
                                <i class="bi bi-wallet2 me-1"></i>Cuentas
                            </a>
                            <button type="button" class="btn btn-light-danger btn-sm px-3" @onclick="() => EliminarCliente(c.Id)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block saas-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1">
                            <i class="bi @(clienteActual.Id == 0 ? "bi-person-plus" : "bi-pencil-square") me-2 text-primary"></i>
                            @(clienteActual.Id == 0 ? "Nuevo Cliente" : "Editar Cliente")
                        </h5>
                        <p class="text-muted small mb-0">Actualiza la informacion fiscal y de contacto.</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <EditForm Model="clienteActual" OnValidSubmit="GuardarCliente">
                        <DataAnnotationsValidator />

                        <div class="p-3 mb-4 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <h6 class="fw-bold mb-3" style="color: #334155;"><i class="bi bi-person-lines-fill me-2"></i>Informacion de Contacto</h6>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="saas-label">NOMBRE O RAZON SOCIAL <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.Nombre" placeholder="Ej. Constructora del Norte S.A." />
                                    <ValidationMessage For="@(() => clienteActual.Nombre)" class="saas-validation-message" />
                                </div>
                                <div class="col-md-4">
                                    <label class="saas-label">TELEFONO</label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.Telefono" placeholder="10 digitos" />
                                </div>
                                <div class="col-md-12">
                                    <label class="saas-label">CORREO ELECTRONICO <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.Email" placeholder="contacto@empresa.com" />
                                    <ValidationMessage For="@(() => clienteActual.Email)" class="saas-validation-message" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 mb-4 rounded-3" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                            <h6 class="fw-bold mb-3" style="color: #166534;"><i class="bi bi-file-earmark-text me-2"></i>Datos Fiscales (SAT)</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="saas-label">RFC <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input fw-bold"
                                               @bind-Value="clienteActual.RFC"
                                               @onblur="NormalizarRFC"
                                               placeholder="ABCD000000XXX"
                                               style="text-transform: uppercase;" />
                                    <ValidationMessage For="@(() => clienteActual.RFC)" class="saas-validation-message" />
                                </div>
                                <div class="col-md-6">
                                    <label class="saas-label">CODIGO POSTAL <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.CodigoPostal" maxlength="5" placeholder="00000" />
                                    <ValidationMessage For="@(() => clienteActual.CodigoPostal)" class="saas-validation-message" />
                                </div>
                                <div class="col-md-6">
                                    <label class="saas-label">REGIMEN FISCAL</label>
                                    <InputSelect class="form-select saas-input" @bind-Value="clienteActual.RegimenFiscal">
                                        <option value="">Seleccione...</option>
                                        <option value="601">601 - General de Ley Personas Morales</option>
                                        <option value="612">612 - Actividades Empresariales y Prof.</option>
                                        <option value="626">626 - Regimen Simplificado de Confianza</option>
                                        <option value="605">605 - Sueldos y Salarios</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="saas-label">USO CFDI</label>
                                    <InputSelect class="form-select saas-input" @bind-Value="clienteActual.UsoCFDI">
                                        <option value="">Seleccione...</option>
                                        <option value="G03">G03 - Gastos en general</option>
                                        <option value="G01">G01 - Adquisicion de mercancias</option>
                                        <option value="I01">I01 - Construcciones</option>
                                        <option value="S01">S01 - Sin efectos fiscales</option>
                                    </InputSelect>
                                </div>

                                <div class="col-12">
                                    <label class="saas-label">DIRECCION FISCAL / ENTREGA</label>
                                    <InputTextArea class="form-control saas-input" @bind-Value="clienteActual.Direccion" rows="2" placeholder="Calle, Numero, Colonia..." />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center p-3 rounded-3 mb-3" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                            <div class="form-check form-switch m-0 d-flex align-items-center p-0">
                                <InputCheckbox class="form-check-input saas-switch m-0" @bind-Value="clienteActual.Activo" id="chkActivoCliente" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                                <label class="form-check-label ms-3 fw-bold text-dark" for="chkActivoCliente" style="cursor: pointer;">
                                    Cliente habilitado para operaciones
                                    <span class="d-block text-muted fw-normal small">Si se desactiva, no se podran crear nuevas ventas.</span>
                                </label>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mensajeError))
                        {
                            <div class="alert saas-alert-error py-2 small shadow-sm">
                                <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                            </div>
                        }

                        <div class="row g-3">
                            <button type="button" class="btn btn-light text-muted fw-semibold shadow-sm px-4" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn saas-btn-primary px-4 shadow-sm" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-save me-2"></i>Guardar Cliente</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    :root {
        --polynex-navy: #1F2A44;
    }

    .saas-btn-primary {
        background-color: var(--polynex-navy);
        color: white;
        border: none;
        transition: all 0.2s;
    }

        .saas-btn-primary:hover {
            background-color: #2a3a5e;
            color: white;
            transform: translateY(-1px);
        }

    .customer-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
        transition: transform 0.2s;
    }

        .customer-mobile-card:active {
            transform: scale(0.98);
        }

    .btn-light-primary {
        background: #eff6ff;
        color: #2563eb;
        border: none;
    }

        .btn-light-primary:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .btn-light-warning {
        background: #fffbeb;
        color: #d97706;
        border: none;
    }

        .btn-light-warning:hover {
            background: #fef3c7;
            color: #b45309;
        }

    .btn-light-danger {
        background: #fef2f2;
        color: #dc2626;
        border: none;
    }

        .btn-light-danger:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    .extra-small {
        font-size: 0.75rem;
    }

    .status-badge {
        padding: 0.25rem 0.6rem;
        border-radius: 50rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-inactive {
        background-color: #f1f5f9;
        color: #475569;
    }

    .btn-white {
        background: #fff;
        border: 1px solid #e2e8f0;
    }

        .btn-white:hover {
            background: #f8fafc;
        }

    .pos-container {
        padding-bottom: 80px;
    }

    .saas-switch:checked {
        background-color: #3b82f6;
        border-color: #3b82f6;
    }

    .saas-switch:focus {
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='rgba%280, 0, 0, 0.25%29'/%3e%3c/svg%3e");
    }
</style>

@code {
    private List<Cliente> clientes = new();
    private Cliente clienteActual = new();
    private bool loading = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroEstado = "todos";
    private string mensajeError = "";
    private List<CuentaPorCobrar> cuentasPorCobrar = new();
    private Dictionary<int, List<CuentaPorCobrar>> cuentasPorCliente = new();

    protected override async Task LoadDataAsync()
    {
        loading = true;
        mensajeError = "";

        try
        {
            await CargarClientes();
            await CargarCuentasPorCobrar();
        }
        finally
        {
            loading = false;
        }
    }

    protected override bool ShouldRetryInitialLoad() => !clientes.Any();

    private IEnumerable<Cliente> ClientesFiltrados => clientes.Where(c =>
        (string.IsNullOrEmpty(terminoBusqueda) ||
         c.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
         (c.RFC?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (filtroEstado == "todos" || (filtroEstado == "activos" && c.Activo) || (filtroEstado == "inactivos" && !c.Activo))
    );

    private async Task CargarClientes()
    {
        try
        {
            clientes = await ClienteHttpService.GetClientesAsync();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void MostrarModalNuevo()
    {
        clienteActual = new Cliente { Activo = true };
        mensajeError = "";
        mostrarModal = true;
    }

    private void NormalizarRFC()
    {
        if (!string.IsNullOrEmpty(clienteActual.RFC))
            clienteActual.RFC = clienteActual.RFC.ToUpper().Trim();
    }

    private void EditarCliente(Cliente cliente)
    {
        clienteActual = new Cliente
        {
            Id = cliente.Id,
            Nombre = cliente.Nombre,
            Email = cliente.Email,
            Telefono = cliente.Telefono,
            RFC = cliente.RFC,
            CodigoPostal = cliente.CodigoPostal,
            RegimenFiscal = cliente.RegimenFiscal,
            UsoCFDI = cliente.UsoCFDI,
            Direccion = cliente.Direccion,
            Activo = cliente.Activo,
            FechaRegistro = cliente.FechaRegistro
        };
        mensajeError = "";
        mostrarModal = true;
    }

    private async Task GuardarCliente()
    {
        try
        {
            guardando = true;
            mensajeError = "";

            if (clienteActual.Id == 0)
                await ClienteHttpService.CreateClienteAsync(clienteActual);
            else
                await ClienteHttpService.UpdateClienteAsync(clienteActual);

            await CargarClientes();
            CerrarModal();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        clienteActual = new();
        mensajeError = "";
    }

    private async Task EliminarCliente(int id)
    {
        try
        {
            var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar cliente?");
            if (!confirm)
                return;

            await ClienteHttpService.DeleteClienteAsync(id);
            await CargarClientes();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task CargarCuentasPorCobrar()
    {
        cuentasPorCobrar = await CuentaPorCobrarHttpService.GetAsync();

        cuentasPorCliente = cuentasPorCobrar
            .Where(x => x.ClienteId > 0)
            .GroupBy(x => x.ClienteId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private decimal ObtenerSaldoCliente(int clienteId)
    {
        if (!cuentasPorCliente.TryGetValue(clienteId, out var cuentas))
            return 0m;

        return cuentas.Where(x => x.Activa && x.Saldo > 0).Sum(x => x.Saldo);
    }

    private int ObtenerPendientesCliente(int clienteId)
    {
        if (!cuentasPorCliente.TryGetValue(clienteId, out var cuentas))
            return 0;

        return cuentas.Count(x => x.Activa && x.Saldo > 0);
    }

    private bool TieneVencidasCliente(int clienteId)
    {
        if (!cuentasPorCliente.TryGetValue(clienteId, out var cuentas))
            return false;

        return cuentas.Any(x => x.Activa && x.EstaVencida && x.Saldo > 0);
    }
}
