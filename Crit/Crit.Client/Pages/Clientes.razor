@page "/clientes"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject CuentaPorCobrarHttpService CuentaPorCobrarHttpService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ClienteHttpService ClienteHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Gestión de Clientes</PageTitle>

<div class="container-fluid py-4 saas-page-container">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1e293b;">Gestión de Clientes</h2>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Administra la base de datos de compradores y sus datos fiscales para pre-facturación.</p>
        </div>

        <button class="btn saas-btn-primary shadow-sm px-4" @onclick="MostrarModalNuevo">
            <i class="bi bi-person-plus-fill me-2"></i>Nuevo Cliente
        </button>
    </div>

    <div class="card saas-card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 15px; transform: translateY(-50%);"></i>
                        <input type="text" class="form-control saas-input ps-5" placeholder="Buscar por nombre, email o RFC..."
                               @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select saas-input" @bind="filtroEstado">
                        <option value="todos">Todos los estados</option>
                        <option value="activos">Solo Activos</option>
                        <option value="inactivos">Solo Inactivos</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-content-center py-5 text-muted">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            Cargando cartera de clientes...
        </div>
    }
    else
    {
        <div class="card saas-card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 saas-table">
                    <thead>
                        <tr>
                            <th class="ps-4">CLIENTE</th>
                            <th>CONTACTO</th>
                            <th>DATOS FISCALES</th>
                            <th>ESTADO</th>
                            <th>RESUMEN CXC</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!ClientesFiltrados.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-building fs-2 d-block mb-2 text-black-50"></i>
                                    No se encontraron clientes con los filtros actuales.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var cliente in ClientesFiltrados)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle bg-light text-secondary fw-bold rounded-circle d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px; min-width: 40px;">
                                                @cliente.Nombre.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@cliente.Nombre</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">ID: #@cliente.Id</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="text-dark" style="font-size: 0.85rem;">
                                            <i class="bi bi-envelope me-1 text-muted"></i> @cliente.Email
                                        </div>
                                        <div class="text-muted" style="font-size: 0.85rem;">
                                            <i class="bi bi-telephone me-1 text-muted"></i> @(cliente.Telefono ?? "S/N")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="fw-bold" style="font-size: 0.85rem; color: #475569;">
                                            RFC: @(string.IsNullOrEmpty(cliente.RFC) ? "XAXX010101000" : cliente.RFC)
                                        </div>
                                        <div class="text-muted" style="font-size: 0.8rem;">CP: @(cliente.CodigoPostal ?? "S/N")</div>
                                    </td>

                                    <td>
                                      
                                        <span class="status-badge @(cliente.Activo ? "status-active" : "status-inactive")">
                                            @(cliente.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>

                                    <td>
                                        @{
                                            var saldo = ObtenerSaldoCliente(cliente.Id);
                                            var pendientes = ObtenerPendientesCliente(cliente.Id);
                                            var vencida = TieneVencidasCliente(cliente.Id);
                                        }

                                        @if (saldo > 0)
                                        {
                                            <div class="fw-bold @(vencida ? "text-danger" : "text-primary")" style="font-size: 0.95rem;">
                                                @saldo.ToString("C")
                                            </div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@pendientes cuenta(s)</div>

                                            @if (vencida)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle mt-1" style="font-size: 0.7rem;">Con vencidas</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 0.85rem;"><i class="bi bi-check2-all me-1"></i>Sin saldo</span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <a class="btn btn-sm btn-light text-success border-0 shadow-none hover-bg-success" href="/cuentas-por-cobrar?clienteId=@cliente.Id" title="Cuentas por cobrar">
                                                <i class="bi bi-cash-coin"></i>
                                            </a>
                                            <a class="btn btn-sm btn-light text-dark border-0 shadow-none hover-bg-dark" href="/clientes/@cliente.Id" title="Ver ficha">
                                                <i class="bi bi-person-vcard"></i>
                                            </a>
                                            <button class="btn btn-sm btn-light text-primary border-0 shadow-none hover-bg-primary" @onclick="() => EditarCliente(cliente)" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-sm btn-light text-danger border-0 shadow-none hover-bg-danger" @onclick="() => EliminarCliente(cliente.Id)" title="Eliminar">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block saas-modal-backdrop" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-1">
                            <i class="bi @(clienteActual.Id == 0 ? "bi-person-plus" : "bi-person-gear") text-primary me-2"></i>
                            @(clienteActual.Id == 0 ? "Registrar Nuevo Cliente" : "Editar Cliente")
                        </h5>
                        <p class="text-muted small mb-0">Completa la información de contacto y fiscalización.</p>
                    </div>
                    <button type="button" class="btn-close shadow-none" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body px-4 py-4">
                    <EditForm Model="clienteActual" OnValidSubmit="GuardarCliente">
                        <DataAnnotationsValidator />

                        <div class="p-3 mb-4 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                            <h6 class="fw-bold mb-3" style="color: #334155;"><i class="bi bi-person-lines-fill me-2"></i>Información de Contacto</h6>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="saas-label">NOMBRE O RAZÓN SOCIAL <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.Nombre" placeholder="Ej. Constructora del Norte S.A." />
                                    <ValidationMessage For="@(() => clienteActual.Nombre)" class="saas-validation-message" />
                                </div>
                                <div class="col-md-4">
                                    <label class="saas-label">TELÉFONO</label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.Telefono" placeholder="10 dígitos" />
                                </div>
                                <div class="col-md-12">
                                    <label class="saas-label">CORREO ELECTRÓNICO <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.Email" placeholder="contacto@empresa.com" />
                                    <ValidationMessage For="@(() => clienteActual.Email)" class="saas-validation-message" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 mb-4 rounded-3" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                            <h6 class="fw-bold mb-3" style="color: #166534;"><i class="bi bi-file-earmark-text me-2"></i>Datos Fiscales (SAT)</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="saas-label">RFC <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input fw-bold"
                                               @bind-Value="clienteActual.RFC"
                                               @onblur="NormalizarRFC"
                                               placeholder="ABCD000000XXX"
                                               style="text-transform: uppercase;" />
                                    <ValidationMessage For="@(() => clienteActual.RFC)" class="saas-validation-message" />
                                </div>
                                <div class="col-md-6">
                                    <label class="saas-label">CÓDIGO POSTAL <span class="text-danger">*</span></label>
                                    <InputText class="form-control saas-input" @bind-Value="clienteActual.CodigoPostal" maxlength="5" placeholder="00000" />
                                    <ValidationMessage For="@(() => clienteActual.CodigoPostal)" class="saas-validation-message" />
                                </div>
                                <div class="col-md-6">
                                    <label class="saas-label">RÉGIMEN FISCAL</label>
                                    <InputSelect class="form-select saas-input" @bind-Value="clienteActual.RegimenFiscal">
                                        <option value="">Seleccione...</option>
                                        <option value="601">601 - General de Ley Personas Morales</option>
                                        <option value="612">612 - Actividades Empresariales y Prof.</option>
                                        <option value="626">626 - Régimen Simplificado de Confianza</option>
                                        <option value="605">605 - Sueldos y Salarios</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="saas-label">USO DE CFDI</label>
                                    <InputSelect class="form-select saas-input" @bind-Value="clienteActual.UsoCFDI">
                                        <option value="">Seleccione...</option>
                                        <option value="G03">G03 - Gastos en general</option>
                                        <option value="G01">G01 - Adquisición de mercancías</option>
                                        <option value="I01">I01 - Construcciones</option>
                                        <option value="S01">S01 - Sin efectos fiscales</option>
                                    </InputSelect>
                                </div>
                                <div class="col-12">
                                    <label class="saas-label">DIRECCIÓN FISCAL / ENTREGA</label>
                                    <InputTextArea class="form-control saas-input" @bind-Value="clienteActual.Direccion" rows="2" placeholder="Calle, Número, Colonia..." />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center p-3 rounded-3 mb-3" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                            <div class="form-check form-switch m-0 d-flex align-items-center p-0">
                                <InputCheckbox class="form-check-input saas-switch m-0" @bind-Value="clienteActual.Activo" id="chkActivo" style="width: 2.5em; height: 1.25em; cursor: pointer;" />
                                <label class="form-check-label ms-3 fw-bold text-dark" for="chkActivo" style="cursor: pointer;">
                                    Cliente habilitado para operaciones
                                    <span class="d-block text-muted fw-normal small">Si se desactiva, no se podrán crear nuevas ventas.</span>
                                </label>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert saas-alert-error py-2 small shadow-sm">
                                <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                            </div>
                        }

                        <div class="modal-footer border-top-0 px-0 pb-0 pt-3">
                            <button type="button" class="btn btn-light text-muted fw-semibold shadow-sm px-4" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn saas-btn-primary px-4 shadow-sm" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-save me-2"></i>Guardar Cliente</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
