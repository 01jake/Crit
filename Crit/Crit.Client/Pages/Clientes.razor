<style>
    .hover-bg-primary:hover {
        background-color: #eff6ff !important;
        color: #2563eb !important;
    }

    .hover-bg-danger:hover {
        background-color: #fef2f2 !important;
        color: #dc2626 !important;
    }

    .hover-bg-success:hover {
        background-color: #f0fdf4 !important;
        color: #16a34a !important;
    }

    .hover-bg-dark:hover {
        background-color: #f1f5f9 !important;
        color: #0f172a !important;
    }

    /* Estilo para el switch/toggle en el modal */
    .saas-switch:checked {
        background-color: #3b82f6;
        border-color: #3b82f6;
    }

    .saas-switch:focus {
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='rgba%280, 0, 0, 0.25%29'/%3e%3c/svg%3e");
    }
</style>
@code {
    private List<Cliente> clientes = new();
    private Cliente clienteActual = new();
    private bool loading = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroEstado = "todos";
    private string mensajeError = "";
    private List<CuentaPorCobrar> cuentasPorCobrar = new();
    private Dictionary<int, List<CuentaPorCobrar>> cuentasPorCliente = new();

    private IEnumerable<Cliente> ClientesFiltrados => clientes.Where(c =>
        (string.IsNullOrEmpty(terminoBusqueda) ||
         c.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
         (c.RFC?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (filtroEstado == "todos" || (filtroEstado == "activos" && c.Activo) || (filtroEstado == "inactivos" && !c.Activo))
    );

protected override async Task OnInitializedAsync()
{
    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    if (user.Identity?.IsAuthenticated != true)
        return;

    await CargarDatos();

    if (!clientes.Any())
    {
        await Task.Delay(300);
        await CargarDatos();
    }
}



    private async Task CargarClientes() => clientes = await ClienteHttpService.GetClientesAsync();

    private void MostrarModalNuevo()
    {
        clienteActual = new Cliente { Activo = true };
        mensajeError = "";
        mostrarModal = true;
    }

    private void NormalizarRFC()
    {
        if (!string.IsNullOrEmpty(clienteActual.RFC))
            clienteActual.RFC = clienteActual.RFC.ToUpper().Trim();
    }

    private void EditarCliente(Cliente cliente)
    {
        clienteActual = new Cliente
        {
            Id = cliente.Id,
            Nombre = cliente.Nombre,
            Email = cliente.Email,
            Telefono = cliente.Telefono,
            RFC = cliente.RFC,
            CodigoPostal = cliente.CodigoPostal,
            RegimenFiscal = cliente.RegimenFiscal,
            UsoCFDI = cliente.UsoCFDI,
            Direccion = cliente.Direccion,
            Activo = cliente.Activo,
            FechaRegistro = cliente.FechaRegistro
        };
        mostrarModal = true;
    }

    private async Task GuardarCliente()
    {
        try
        {
            guardando = true;
            if (clienteActual.Id == 0) await ClienteHttpService.CreateClienteAsync(clienteActual);
            else await ClienteHttpService.UpdateClienteAsync(clienteActual);
            await CargarClientes();
            CerrarModal();
        }
        catch (Exception ex) { mensajeError = ex.Message; }
        finally { guardando = false; }
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task EliminarCliente(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar cliente?"))
        {
            await ClienteHttpService.DeleteClienteAsync(id);
            await CargarClientes();
        }
    }
    private async Task CargarCuentasPorCobrar()
    {
        cuentasPorCobrar = await CuentaPorCobrarHttpService.GetAsync();

        cuentasPorCliente = cuentasPorCobrar
            .Where(x => x.ClienteId > 0)
            .GroupBy(x => x.ClienteId)
            .ToDictionary(g => g.Key, g => g.ToList());
    }
    private decimal ObtenerSaldoCliente(int clienteId)
    {
        if (!cuentasPorCliente.TryGetValue(clienteId, out var cuentas))
            return 0m;

        return cuentas.Where(x => x.Activa && x.Saldo > 0).Sum(x => x.Saldo);
    }

    private int ObtenerPendientesCliente(int clienteId)
    {
        if (!cuentasPorCliente.TryGetValue(clienteId, out var cuentas))
            return 0;

        return cuentas.Count(x => x.Activa && x.Saldo > 0);
    }

    private bool TieneVencidasCliente(int clienteId)
    {
        if (!cuentasPorCliente.TryGetValue(clienteId, out var cuentas))
            return false;

        return cuentas.Any(x => x.Activa && x.EstaVencida && x.Saldo > 0);
    }
    private async Task CargarDatos()
    {
        loading = true;
        mensajeError = "";

        try
        {
            await CargarClientes();
            await CargarCuentasPorCobrar();
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

}