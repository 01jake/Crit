@page "/admin/asignar-quejas"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject AdminService AdminService
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Administrador")]

<PageTitle>Asignar Quejas</PageTitle>

<div class="min-vh-100 bg-light">
    <div class="container-fluid py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col">
                <h1 class="h2 text-dark mb-2">Asignación de Quejas</h1>
                <p class="text-muted">Asigna quejas pendientes a usuarios disponibles</p>
            </div>
        </div>

        <!-- Success Alert -->
        @if (mostrarExito)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                Queja asignada exitosamente a @(usuarioAsignado?.UserName ?? "usuario")
                <button type="button" class="btn-close" @onclick="() => mostrarExito = false"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-3 text-muted">Cargando información...</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Panel 1: Quejas Pendientes -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="card-title text-dark mb-3">
                                <i class="bi bi-inbox me-2"></i>
                                Quejas Pendientes
                            </h5>

                            <!-- Búsqueda -->
                            <div class="mb-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-light border">
                                        <i class="bi bi-search text-muted"></i>
                                    </span>
                                    <input type="text" 
                                           class="form-control border"
                                           placeholder="Buscar quejas..."
                                           @bind="searchQueja"
                                           @oninput="OnSearchQuejaChanged" />
                                </div>
                            </div>

                            <!-- Filtro de Prioridad -->
                            <select class="form-select border"
                                    @bind="filterPrioridad">
                                <option value="all">Todas las prioridades</option>
                                <option value="Alta">Alta</option>
                                <option value="Media">Media</option>
                                <option value="Baja">Baja</option>
                            </select>
                        </div>

                        <div class="card-body p-0" style="max-height: calc(100vh - 340px); overflow-y: auto;">
                            @if (quejasFiltradas.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-inbox display-4 text-muted"></i>
                                    <p class="text-muted mt-3">No hay quejas pendientes</p>
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var queja in quejasFiltradas)
                                    {
                                        <button class="list-group-item list-group-item-action border-0 @(quejaSeleccionada?.Id == queja.Id ? "active" : "")"
                                                @onclick="() => SeleccionarQueja(queja)">
                                            <div class="d-flex w-100 justify-content-between align-items-start mb-2">
                                                <h6 class="mb-1 text-truncate">@queja.Titulo</h6>
                                                <span class="@GetPrioridadBadgeClass(queja.Prioridad)">
                                                    @GetPrioridadText(queja.Prioridad)
                                                </span>
                                            </div>
                                            <p class="mb-2 small text-muted text-truncate">@queja.DescripcionQueja</p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="bi bi-tag me-1"></i>@queja.Categoria
                                                </small>
                                                <small class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>@queja.Fecha.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Panel 2: Detalles de la Queja -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="card-title text-dark mb-0">
                                <i class="bi bi-file-text me-2"></i>
                                Detalles de la Queja
                            </h5>
                        </div>

                        <div class="card-body">
                            @if (quejaSeleccionada != null)
                            {
                                <div>
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h4 class="text-dark">@quejaSeleccionada.Titulo</h4>
                                            <span class="@GetPrioridadBadgeClass(quejaSeleccionada.Prioridad)">
                                                @GetPrioridadText(quejaSeleccionada.Prioridad)
                                            </span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label text-muted small fw-bold">DESCRIPCIÓN</label>
                                            <p class="text-dark">@quejaSeleccionada.DescripcionQueja</p>
                                        </div>

                                        <div class="row g-3 mb-3">
                                            <div class="col-6">
                                                <label class="form-label text-muted small fw-bold">CATEGORÍA</label>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-tag text-primary me-2"></i>
                                                    <span class="text-dark">@quejaSeleccionada.Categoria</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label text-muted small fw-bold">FECHA</label>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-calendar text-primary me-2"></i>
                                                    <span class="text-dark">@quejaSeleccionada.Fecha.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label text-muted small fw-bold">REPORTADO POR</label>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-envelope text-primary me-2"></i>
                                                <span class="text-dark">@quejaSeleccionada.Correo</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label text-muted small fw-bold">CLIENTE</label>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-person-circle text-primary me-2"></i>
                                                <span class="text-dark">@quejaSeleccionada.NombreCliente</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="border-top pt-4">
                                        <h6 class="text-dark mb-3 fw-bold">Asignar a Usuario</h6>
                                        @if (usuarioSeleccionado != null)
                                        {
                                            <div class="alert alert-info d-flex justify-content-between align-items-center">
                                                <div>
                                                    <i class="bi bi-person-check me-2"></i>
                                                    <strong>@usuarioSeleccionado.UserName</strong>
                                                    <br />
                                                    <small>@usuarioSeleccionado.Email</small>
                                                </div>
                                                <button class="btn btn-sm btn-outline-secondary" 
                                                        @onclick="() => usuarioSeleccionado = null">
                                                    Cambiar
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted small">Selecciona un usuario de la lista de la derecha</p>
                                        }

                                        <button class="btn btn-primary w-100" 
                                                disabled="@(usuarioSeleccionado == null || asignando)"
                                                @onclick="AsignarQueja">
                                            @if (asignando)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                            }
                                            <i class="bi bi-check-circle me-2"></i>
                                            Asignar Queja
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-file-text display-4 text-muted"></i>
                                    <p class="text-muted mt-3">Selecciona una queja para ver los detalles</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Panel 3: Usuarios Disponibles -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="card-title text-dark mb-0">
                                <i class="bi bi-people me-2"></i>
                                Usuarios Disponibles
                            </h5>
                        </div>

                        <div class="card-body p-0" style="max-height: calc(100vh - 300px); overflow-y: auto;">
                            @if (usuarios.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-person-x display-4 text-muted"></i>
                                    <p class="text-muted mt-3">No hay usuarios disponibles</p>
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var usuario in usuarios)
                                    {
                                        <div class="list-group-item border-0 @(usuarioSeleccionado?.Id == usuario.Id ? "bg-primary bg-opacity-10" : "")">
                                            <div class="d-flex align-items-start">
                                                <div class="flex-shrink-0">
                                                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                                                         style="width: 48px; height: 48px;">
                                                        <i class="bi bi-person text-primary fs-5"></i>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1 ms-3">
                                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                                        <h6 class="mb-0 text-dark">@usuario.UserName</h6>
                                                        @if (usuario.QuejasAsignadas > 0)
                                                        {
                                                            <span class="badge bg-primary rounded-pill">@usuario.QuejasAsignadas</span>
                                                        }
                                                    </div>
                                                    <p class="mb-2 small text-muted">
                                                        <i class="bi bi-briefcase me-1"></i>
                                                        @usuario.QuejasEnProceso en proceso | @usuario.QuejasResueltas resueltas
                                                    </p>
                                                    <p class="mb-2 small text-muted">
                                                        <i class="bi bi-envelope me-1"></i>
                                                        @usuario.Email
                                                    </p>
                                                    <div class="d-flex gap-2">
                                                        <button class="btn btn-sm btn-primary flex-grow-1"
                                                                @onclick="() => SeleccionarUsuario(usuario)"
                                                                disabled="@(quejaSeleccionada == null)">
                                                            <i class="bi bi-arrow-left-circle me-1"></i>
                                                            Seleccionar
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-info"
                                                                @onclick="() => VerEstadisticas(usuario.Id)">
                                                            <i class="bi bi-bar-chart me-1"></i>
                                                            Ver
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Modal de estadísticas del usuario -->
        @if (mostrarEstadisticas && estadisticasUsuario != null)
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title">
                                <i class="bi bi-graph-up me-2"></i>
                                Estadísticas de @estadisticasUsuario.UsuarioNombre
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CerrarEstadisticas"></button>
                        </div>
                        <div class="modal-body">
                            <!-- Información del usuario -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <h6 class="text-muted mb-3">Información del Usuario</h6>
                                            <p class="mb-2"><strong>Nombre:</strong> @estadisticasUsuario.UsuarioNombre</p>
                                            <p class="mb-0"><strong>Email:</strong> @estadisticasUsuario.UsuarioEmail</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="card text-center bg-primary text-white border-0">
                                                <div class="card-body p-3">
                                                    <h4 class="mb-0">@estadisticasUsuario.TotalAsignadas</h4>
                                                    <small>Total Asignadas</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card text-center bg-secondary text-white border-0">
                                                <div class="card-body p-3">
                                                    <h4 class="mb-0">@estadisticasUsuario.Pendientes</h4>
                                                    <small>Pendientes</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card text-center bg-warning text-dark border-0">
                                                <div class="card-body p-3">
                                                    <h4 class="mb-0">@estadisticasUsuario.EnProceso</h4>
                                                    <small>En Proceso</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="card text-center bg-success text-white border-0">
                                                <div class="card-body p-3">
                                                    <h4 class="mb-0">@estadisticasUsuario.Resueltas</h4>
                                                    <small>Resueltas</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Lista de quejas del usuario -->
                            <h6 class="mb-3 fw-bold">Historial de Quejas Asignadas</h6>
                            @if (estadisticasUsuario.Quejas.Count == 0)
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox display-4"></i>
                                    <p class="mt-3">Este usuario no tiene quejas asignadas</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Título</th>
                                                <th>Categoría</th>
                                                <th>Cliente</th>
                                                <th>Prioridad</th>
                                                <th>Estado</th>
                                                <th>Fecha Asignación</th>
                                                <th>Fecha Resolución</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var queja in estadisticasUsuario.Quejas)
                                            {
                                                <tr>
                                                    <td>
                                                        <strong>@queja.Titulo</strong>
                                                        <br>
                                                        <small class="text-muted">@(queja.DescripcionQueja.Length > 50 ? queja.DescripcionQueja.Substring(0, 50) + "..." : queja.DescripcionQueja)</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">@queja.Categoria</span>
                                                    </td>
                                                    <td>@queja.NombreCliente</td>
                                                    <td>
                                                        <span class="@GetPrioridadBadgeClass(queja.Prioridad)">
                                                            @GetPrioridadText(queja.Prioridad)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="@GetEstatusBadgeClass(queja.Estatus)">
                                                            @GetEstatusText(queja.Estatus)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <small>@(queja.FechaAsignacion?.ToString("dd/MM/yyyy") ?? "N/A")</small>
                                                    </td>
                                                    <td>
                                                        <small>@(queja.FechaResolucion?.ToString("dd/MM/yyyy") ?? "Pendiente")</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarEstadisticas">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Queja> quejasPendientes = new();
    private List<Queja> quejasFiltradas = new();
    private List<UsuarioDto> usuarios = new();
    private UsuarioEstadisticasDto? estadisticasUsuario = null;
    
    private Queja? quejaSeleccionada = null;
    private UsuarioDto? usuarioSeleccionado = null;
    private UsuarioDto? usuarioAsignado = null;
    
    private bool isLoading = true;
    private bool asignando = false;
    private bool mostrarExito = false;
    private bool mostrarEstadisticas = false;
    
    private string searchQueja = string.Empty;
    private string filterPrioridad = "all";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        isLoading = true;
        
        var todasQuejas = await AdminService.GetAllQuejasAsync();
        quejasPendientes = todasQuejas.Where(q => q.EmpleadoAsignadoId == null).ToList();
        
        usuarios = await AdminService.GetUsuariosAsync();
        
        FiltrarQuejas();
        isLoading = false;
    }

    private void FiltrarQuejas()
    {
        quejasFiltradas = quejasPendientes.Where(q =>
        {
            var matchesSearch = string.IsNullOrEmpty(searchQueja) ||
                q.Titulo.Contains(searchQueja, StringComparison.OrdinalIgnoreCase) ||
                q.DescripcionQueja.Contains(searchQueja, StringComparison.OrdinalIgnoreCase);

            var matchesPrioridad = filterPrioridad == "all" ||
                GetPrioridadText(q.Prioridad).Equals(filterPrioridad, StringComparison.OrdinalIgnoreCase);

            return matchesSearch && matchesPrioridad;
        }).OrderByDescending(q => q.Prioridad).ThenByDescending(q => q.Fecha).ToList();
    }

    private void OnSearchQuejaChanged(ChangeEventArgs e)
    {
        searchQueja = e.Value?.ToString() ?? string.Empty;
        FiltrarQuejas();
    }

    private void OnFilterChanged(ChangeEventArgs e)
    {
        filterPrioridad = e.Value?.ToString() ?? "all";
        FiltrarQuejas();
    }

    private void SeleccionarQueja(Queja queja)
    {
        quejaSeleccionada = queja;
        usuarioSeleccionado = null;
    }

    private void SeleccionarUsuario(UsuarioDto usuario)
    {
        if (quejaSeleccionada == null) return;
        usuarioSeleccionado = usuario;
    }

    private async Task VerEstadisticas(string usuarioId)
    {
        estadisticasUsuario = await AdminService.GetEstadisticasUsuarioAsync(usuarioId);
        mostrarEstadisticas = true;
    }

    private void CerrarEstadisticas()
    {
        mostrarEstadisticas = false;
        estadisticasUsuario = null;
    }

    private async Task AsignarQueja()
    {
        if (quejaSeleccionada == null || usuarioSeleccionado == null) return;

        asignando = true;
        
        bool exito = await AdminService.AsignarQuejaAsync(quejaSeleccionada.Id, usuarioSeleccionado.Id);
        
        if (exito)
        {
            usuarioAsignado = usuarioSeleccionado;
            mostrarExito = true;
            
            // Ocultar el mensaje después de 3 segundos
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                mostrarExito = false;
                await InvokeAsync(StateHasChanged);
            });
            
            quejaSeleccionada = null;
            usuarioSeleccionado = null;
            
            await CargarDatos();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error al asignar la queja");
        }
        
        asignando = false;
    }

    private string GetPrioridadText(PrioridadQueja prioridad) => prioridad switch
    {
        PrioridadQueja.Baja => "Baja",
        PrioridadQueja.Media => "Media",
        PrioridadQueja.Alta => "Alta",
        _ => "Desconocida"
    };

    private string GetEstatusText(EstatusQueja estatus) => estatus switch
    {
        EstatusQueja.Pendiente => "Pendiente",
        EstatusQueja.Atendida => "En Proceso",
        EstatusQueja.Cerrada => "Resuelta",
        _ => "Desconocido"
    };

    private string GetPrioridadBadgeClass(PrioridadQueja prioridad) => prioridad switch
    {
        PrioridadQueja.Alta => "badge bg-danger",
        PrioridadQueja.Media => "badge bg-warning text-dark",
        PrioridadQueja.Baja => "badge bg-success",
        _ => "badge bg-secondary"
    };

    private string GetEstatusBadgeClass(EstatusQueja estatus) => estatus switch
    {
        EstatusQueja.Pendiente => "badge bg-secondary",
        EstatusQueja.Atendida => "badge bg-warning text-dark",
        EstatusQueja.Cerrada => "badge bg-success",
        _ => "badge bg-secondary"
    };
}