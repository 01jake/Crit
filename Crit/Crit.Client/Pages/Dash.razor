@page "/Dash"
@using Crit.Client.Services
@using Crit.Shared.Models
@using System
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(false)]
@rendermode InteractiveWebAssembly
@inject VentaHttpService VentaHttpService
@inject ProductoHttpService ProductoHttpService
@inject ClienteHttpService ClienteHttpService
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid dashboard">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Dashboard</h2>
            <small class="text-muted">Resumen general del negocio</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/ventas" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nueva Venta
            </a>
            <a href="/clientes" class="btn btn-outline-secondary">
                <i class="bi bi-person-plus"></i> Cliente
            </a>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <!-- KPI CARDS -->
        <div class="row g-4 mb-4">

            <!-- Ventas -->
            <div class="col-md-3">
                <div class="card kpi-card bg-gradient-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <small>Ventas del Mes</small>
                                <h3>$@totalVentasMes.ToString("N0")</h3>
                            </div>
                            <i class="bi bi-cash-stack fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clientes -->
            <div class="col-md-3">
                <div class="card kpi-card bg-gradient-success">
                    <div class="card-body">
                        <small>Clientes</small>
                        <h3>@totalClientes</h3>
                    </div>
                </div>
            </div>

            <!-- Productos -->
            <div class="col-md-3">
                <div class="card kpi-card bg-gradient-info">
                    <div class="card-body">
                        <small>Productos</small>
                        <h3>@totalProductos</h3>
                    </div>
                </div>
            </div>

            <!-- Stock -->
            <div class="col-md-3">
                <div class="card kpi-card bg-gradient-warning">
                    <div class="card-body">
                        <small>Stock Bajo</small>
                        <h3>@productosBajoStock</h3>
                    </div>
                </div>
            </div>

        </div>

        <!-- GRÁFICAS -->
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <strong>Ventas (6 meses)</strong>
                    </div>
                    <div class="card-body">
                        <canvas id="ventasChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <strong>Top Productos</strong>
                    </div>
                    <div class="card-body">
                        <canvas id="productosChart"></canvas>
                    </div>
                </div>
            </div>

        </div>

        <!-- TABLA -->
        @if (productosBajoStockLista.Any())
        {
            <div class="card mt-4 border-0 shadow-sm">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-exclamation-triangle"></i> Stock Bajo
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Stock</th>
                                <th>Mínimo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in productosBajoStockLista.Take(5))
                            {
                                <tr>
                                    <td>@p.Nombre</td>
                                    <td><span class="badge bg-danger">@p.Stock</span></td>
                                    <td>@p.StockMinimo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool loading = true;
    private decimal totalVentasMes;
    private int totalClientes;
    private int totalProductos;
    private int productosBajoStock;
    private List<Producto> productosBajoStockLista = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarGraficas();
        }
    }

    private async Task CargarDatos()
    {
        var mesActual = DateTime.Now.Month;
        var añoActual = DateTime.Now.Year;
        // Reemplaza la línea problemática por una llamada sin argumentos, ya que CountAsync no acepta un predicado.
        // Si necesitas filtrar por "Activo", deberás obtener la lista y filtrar manualmente, o modificar el servicio para aceptar un predicado.
        totalClientes = await ClienteHttpService.GetClientesCountAsync();
        totalVentasMes = await VentaHttpService.GetTotalVentasMesAsync(mesActual, añoActual);
        totalProductos = await ProductoHttpService.GetProductosCountAsync();

        productosBajoStockLista = (await ProductoHttpService.GetProductosBajoStockAsync()).ToList();
        productosBajoStock = productosBajoStockLista.Count;
    }

    private async Task CargarGraficas()
    {


        var ventasPorMes = new List<decimal>();
        var meses = new List<string>();

        for (int i = 5; i >= 0; i--)
        {
            var fecha = DateTime.Now.AddMonths(-i);
            var total = await VentaHttpService.GetTotalVentasMesAsync(fecha.Month, fecha.Year);
            ventasPorMes.Add(total);
            meses.Add(fecha.ToString("MMM yyyy"));
        }


    }
}
