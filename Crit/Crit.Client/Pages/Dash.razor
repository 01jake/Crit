@page "/Dash"
@using ApexCharts
@using Crit.Client.Services
@using Crit.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [StreamRendering(false)]
@rendermode InteractiveWebAssembly
@inject Dashboardhttpservice DashboardService
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid dashboard">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Dashboard Financiero</h2>
            <small class="text-muted">Resumen general del negocio</small>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <!-- KPI -->
        <div class="row g-4 mb-4">

            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <small>Ingresos Mes</small>
                        <h3>$@stats.IngresosMes.ToString("N0")</h3>
                        <span class="text-success">Flujo positivo</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <small>Costos</small>
                        <h3 class="text-danger">$@stats.CostoVentasMes.ToString("N0")</h3>
                        <span class="text-muted">Mercancía</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <small>Utilidad</small>
                        <h3 class="text-success">$@stats.UtilidadBrutaMes.ToString("N0")</h3>
                        <span>@stats.MargenBrutoMes.ToString("N1")%</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card kpi-card">
                    <div class="card-body">
                        <small>Inventario</small>
                        <h3>$@stats.ValorInventario.ToString("N0")</h3>
                        <span>@stats.TotalProductos productos</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- GRÁFICAS -->
        <div class="row g-4 mb-4">

            <!-- CASH FLOW -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <strong>Cash Flow (últimos 6 meses)</strong>
                    </div>

                    <div class="card-body">

                        @if (cashFlow.Any())
                        {
                            <ApexChart TItem="CashFlowDto"
                                       Options="cashFlowOptions"
                                       @key="cashFlow.Count">

                                <ApexPointSeries TItem="CashFlowDto"
                                                 Items="cashFlow"
                                                 Name="Ingresos"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(e => e.Mes)"
                                                 YValue="@(e => e.Ingresos)" />

                                <ApexPointSeries TItem="CashFlowDto"
                                                 Items="cashFlow"
                                                 Name="Costos"
                                                 SeriesType="SeriesType.Bar"
                                                 XValue="@(e => e.Mes)"
                                                 YValue="@(e => e.CostoMercancia)" />

                                <ApexPointSeries TItem="CashFlowDto"
                                                 Items="cashFlow"
                                                 Name="Utilidad"
                                                 SeriesType="SeriesType.Line"
                                                 XValue="@(e => e.Mes)"
                                                 YValue="@(e => e.UtilidadBruta)" />

                            </ApexChart>
                        }
                        else
                        {
                            <p class="text-muted">No hay datos disponibles</p>
                        }

                    </div>
                </div>
            </div>

            <!-- TOP PRODUCTOS -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <strong>Top Productos</strong>
                    </div>

                    <div class="card-body">

                        @if (topProductos.Any())
                        {
                            <ApexChart TItem="ProductoMasVendidoDto"
                                       Options="topProductosOptions"
                                       @key="topProductos.Count">

                                <ApexPointSeries TItem="ProductoMasVendidoDto"
                                                 Items="topProductos"
                                                 Name="Cantidad"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="@(e => e.Nombre)"
                                                 YValue="@(e => e.CantidadVendida)" />

                            </ApexChart>
                        }
                        else
                        {
                            <p class="text-muted">Sin datos</p>
                        }

                    </div>
                </div>
            </div>

        </div>

        <!-- TABLAS -->
        <div class="row g-4">

            <!-- VENTAS -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <strong>Ventas Recientes</strong>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var v in ventasRecientes)
                                {
                                    <tr>
                                        <td>@v.NumeroVenta</td>
                                        <td>@v.Cliente</td>
                                        <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>$@v.Total.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <!-- STOCK -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <strong>Stock Bajo</strong>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th>Stock</th>
                                    <th>Mínimo</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var p in productosBajoStock)
                                {
                                    <tr>
                                        <td><code>@p.Codigo</code></td>
                                        <td>@p.Nombre</td>
                                        <td class="text-danger">@p.Stock</td>
                                        <td>@p.StockMinimo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    }
</div>

<style>
    .kpi-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
        transition: all 0.2s ease;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.1);
        }

    .card {
        border-radius: 16px;
    }
</style>

@code {

    private bool loading = true;

    private DashboardStatsDto stats = new();
    private List<CashFlowDto> cashFlow = new();
    private List<ProductoMasVendidoDto> topProductos = new();
    private List<VentaRecienteDto> ventasRecientes = new();
    private List<ProductoBajoStockDto> productosBajoStock = new();

    private ApexChartOptions<CashFlowDto> cashFlowOptions = new()
    {
        Chart = new Chart { Height = 340, Type = ChartType.Bar },
        Colors = new List<string> { "#3B82F6", "#EF4444", "#10B981" },
        Stroke = new Stroke { Width = new List<double> { 0, 0, 3 }, Curve = Curve.Smooth },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                BorderRadius = 6,
                ColumnWidth = "40%"
            }
        },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Position = LegendPosition.Top }
    };

    private ApexChartOptions<ProductoMasVendidoDto> topProductosOptions = new()
    {
        Chart = new Chart { Height = 300, Type = ChartType.Donut },
        Legend = new Legend { Position = LegendPosition.Bottom }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        loading = false;
    }

    private async Task CargarDatos()
    {
        stats = await DashboardService.GetStatsAsync();
        cashFlow = await DashboardService.GetCashFlowAsync(6);
        topProductos = await DashboardService.GetProductosMasVendidosAsync(5);
        ventasRecientes = await DashboardService.GetVentasRecientesAsync(5);

        var alertas = await DashboardService.GetAlertasAsync();
        productosBajoStock = alertas.ProductosBajoStock;
    }
}