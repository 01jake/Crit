@page "/Dash"
@using ApexCharts
@using Crit.Client.Services
@using Crit.Shared.DTOs
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@attribute [StreamRendering(false)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject Dashboardhttpservice DashboardService
@inject CajaHttpService CajaHttpService

<PageTitle>Panel de Control | Crit</PageTitle>

<div class="dashboard-shell px-3 py-4">
    <div class="dashboard-hero card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                <div>
                    <div class="eyebrow mb-2">Panel Ejecutivo</div>
                    <h2 class="page-title mb-1">Dashboard Financiero</h2>
                    <p class="text-muted mb-0">Resumen general del rendimiento y flujo operativo del negocio</p>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="dropdown">
                        <button class="btn btn-white shadow-sm dropdown-toggle fw-bold border rounded-3 px-3 py-2"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                disabled="@loading">
                            <i class="bi bi-calendar3 text-primary me-2"></i>@RangoSeleccionadoTexto
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-4">
                            <li><h6 class="dropdown-header">Rango de datos</h6></li>
                            <li><button class="dropdown-item @(rangoSeleccionado == "hoy" ? "active bg-primary-subtle text-primary fw-bold" : "")" @onclick="@(() => CambiarRango("hoy"))">Hoy</button></li>
                            <li><button class="dropdown-item @(rangoSeleccionado == "7dias" ? "active bg-primary-subtle text-primary fw-bold" : "")" @onclick="@(() => CambiarRango("7dias"))">Últimos 7 días</button></li>
                            <li><button class="dropdown-item @(rangoSeleccionado == "mes" ? "active bg-primary-subtle text-primary fw-bold" : "")" @onclick="@(() => CambiarRango("mes"))">Este Mes</button></li>
                            <li><button class="dropdown-item @(rangoSeleccionado == "anio" ? "active bg-primary-subtle text-primary fw-bold" : "")" @onclick="@(() => CambiarRango("anio"))">Este Año</button></li>
                        </ul>
                    </div>

                    <button class="btn saas-btn-primary shadow-sm rounded-3 px-3 py-2 d-none d-sm-block fw-bold">
                        <i class="bi bi-download me-2"></i>Reporte
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5" style="min-height: 50vh;">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted fw-bold">Actualizando métricas...</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 text-white h-100 kpi-feature kpi-feature-primary">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="small fw-bold text-uppercase opacity-75">Utilidad Bruta</span>
                            <div class="kpi-badge-dark">
                                <i class="bi bi-piggy-bank"></i>
                            </div>
                        </div>
                        <h2 class="fw-black mb-1">$@stats.UtilidadBrutaMes.ToString("N0")</h2>
                        <span class="small opacity-75 fw-semibold">
                            <i class="bi bi-graph-up-arrow me-1"></i>Margen: @stats.MargenBrutoMes.ToString("N1")%
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card-clean">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="text-muted small fw-bold text-uppercase">Ingresos (@RangoSeleccionadoTexto)</span>
                            <div class="icon-box bg-success-subtle text-success">
                                <i class="bi bi-wallet2"></i>
                            </div>
                        </div>
                        <h2 class="fw-black mb-1 text-dark">$@stats.IngresosMes.ToString("N0")</h2>
                        <span class="text-success small fw-bold"><i class="bi bi-arrow-up-right"></i> Flujo Positivo</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card-clean">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="text-muted small fw-bold text-uppercase">Cuentas por Cobrar</span>
                            <div class="icon-box bg-warning-subtle text-warning">
                                <i class="bi bi-cash-coin"></i>
                            </div>
                        </div>
                        <h2 class="fw-black mb-1 text-primary">$@finanzas.TotalPorCobrar.ToString("N0")</h2>
                        <span class="text-muted small">@finanzas.CuentasPorCobrarPendientes cuenta(s) activa(s)</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card-clean">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="text-muted small fw-bold text-uppercase">Saldo en Caja</span>
                            <div class="icon-box @(cajaResumen.CajaAbierta ? "bg-info-subtle text-info" : "bg-danger-subtle text-danger")">
                                <i class="bi bi-safe2"></i>
                            </div>
                        </div>
                        <h2 class="fw-black mb-1 text-dark">$@cajaResumen.SaldoActual.ToString("N0")</h2>
                        <span class="small fw-bold @(cajaResumen.CajaAbierta ? "text-success" : "text-danger")">
                            Estado: @(cajaResumen.CajaAbierta ? "Abierta" : "Cerrada")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
            <div class="card-body p-3">
                <div class="row text-center g-3 operational-strip">
                    <div class="col-6 col-md-2">
                        <span class="d-block text-muted smaller text-uppercase fw-bold">Costo Ventas</span>
                        <span class="fw-bold text-danger">$@stats.CostoVentasMes.ToString("N0")</span>
                    </div>
                    <div class="col-6 col-md-2">
                        <span class="d-block text-muted smaller text-uppercase fw-bold">Val. Inventario</span>
                        <span class="fw-bold text-dark">$@stats.ValorInventario.ToString("N0")</span>
                    </div>
                    <div class="col-6 col-md-2">
                        <span class="d-block text-muted smaller text-uppercase fw-bold">Por Pagar</span>
                        <span class="fw-bold text-danger">$@finanzas.TotalPorPagar.ToString("N0")</span>
                    </div>
                    <div class="col-6 col-md-2">
                        <span class="d-block text-muted smaller text-uppercase fw-bold">Cobrado Mes</span>
                        <span class="fw-bold text-success">$@finanzas.TotalCobradoMes.ToString("N0")</span>
                    </div>
                    <div class="col-6 col-md-2">
                        <span class="d-block text-muted smaller text-uppercase fw-bold">Ingresos Hoy</span>
                        <span class="fw-bold text-success">$@cajaResumen.IngresosHoy.ToString("N0")</span>
                    </div>
                    <div class="col-6 col-md-2">
                        <span class="d-block text-muted smaller text-uppercase fw-bold">Egresos Hoy</span>
                        <span class="fw-bold text-danger">$@cajaResumen.EgresosHoy.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line text-primary me-2"></i>Cash Flow Histórico</h6>
                        <span class="badge bg-light text-muted fw-normal px-3 py-2 border">Últimos meses</span>
                    </div>

                    @if (cashFlow.Any())
                    {
                        <ApexChart TItem="CashFlowDto" Options="cashFlowOptions" @key="cashFlow.Count">
                            <ApexPointSeries TItem="CashFlowDto" Items="cashFlow" Name="Ingresos" SeriesType="SeriesType.Bar" XValue="@(e => e.Mes)" YValue="@(e => e.Ingresos)" />
                            <ApexPointSeries TItem="CashFlowDto" Items="cashFlow" Name="Costos" SeriesType="SeriesType.Bar" XValue="@(e => e.Mes)" YValue="@(e => e.CostoMercancia)" />
                            <ApexPointSeries TItem="CashFlowDto" Items="cashFlow" Name="Utilidad" SeriesType="SeriesType.Line" XValue="@(e => e.Mes)" YValue="@(e => e.UtilidadBruta)" />
                        </ApexChart>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light rounded-4 empty-chart">
                            <span class="text-muted">No hay datos suficientes</span>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-white stock-alert-card">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-octagon-fill me-2"></i>Alertas de Stock</h6>
                            <p class="text-muted smaller mb-0 mt-1">Productos para reponer</p>
                        </div>
                        <a href="/productos" class="btn btn-sm btn-light text-primary fw-bold">Ver todo</a>
                    </div>
                    <div class="card-body px-3 pt-2">
                        <div class="alert-list">
                            @if (productosBajoStock.Any())
                            {
                                @foreach (var p in productosBajoStock)
                                {
                                    <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-3 bg-danger-subtle border-start border-4 border-danger mx-1">
                                        <div>
                                            <span class="fw-bold d-block small text-dark">@p.Nombre</span>
                                            <span class="text-muted smaller">Cód: @p.Codigo</span>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @(p.Stock == 0 ? "bg-danger" : "bg-warning text-dark") fs-6">@p.Stock</span>
                                            <span class="d-block smaller text-muted mt-1">Mín: @p.StockMinimo</span>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-check-circle fs-3 text-success mb-2 d-block"></i>
                                    Stock en niveles óptimos
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h6 class="fw-bold mb-4 text-dark"><i class="bi bi-cash-coin text-success me-2"></i>Cash Flow Real</h6>
                    @if (cashFlowReal.Any())
                    {
                        <ApexChart TItem="FlujoCajaRealDto" Options="cashFlowRealOptions" @key="cashFlowReal.Count">
                            <ApexPointSeries TItem="FlujoCajaRealDto" Items="cashFlowReal" Name="Ingresos" SeriesType="SeriesType.Bar" XValue="@(e => e.Periodo)" YValue="@(e => e.Ingresos)" />
                            <ApexPointSeries TItem="FlujoCajaRealDto" Items="cashFlowReal" Name="Egresos" SeriesType="SeriesType.Bar" XValue="@(e => e.Periodo)" YValue="@(e => e.Egresos)" />
                            <ApexPointSeries TItem="FlujoCajaRealDto" Items="cashFlowReal" Name="Neto" SeriesType="SeriesType.Line" XValue="@(e => e.Periodo)" YValue="@(e => e.Neto)" />
                        </ApexChart>
                    }
                    else
                    {
                        <div class="empty-state text-muted text-center py-5 bg-light rounded-4">No hay movimientos suficientes.</div>
                    }
                </div>

                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                    <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark">Últimas Ventas</h6>
                        <a href="/ventas" class="text-primary text-decoration-none small fw-bold">Ver todas</a>
                    </div>

                    <div class="d-none d-lg-block">
                        <div class="table-responsive">
                            <table class="table table-borderless table-hover align-middle mb-0">
                                <thead style="background-color: #f8fafc;">
                                    <tr class="text-muted smaller text-uppercase">
                                        <th class="ps-4">Folio</th>
                                        <th>Cliente</th>
                                        <th>Fecha</th>
                                        <th class="text-end pe-4">Total</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @foreach (var v in ventasRecientes)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3"><span class="badge bg-light text-dark border">@v.NumeroVenta</span></td>
                                            <td class="fw-semibold">@v.Cliente</td>
                                            <td class="text-muted">@v.Fecha.ToString("dd MMM, yyyy")</td>
                                            <td class="text-end pe-4 fw-bold text-success">$@v.Total.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-lg-none p-3">
                        @foreach (var v in ventasRecientes)
                        {
                            <div class="card border-0 shadow-sm mb-3 sales-mobile-card">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <div class="fw-bold text-dark">#@v.NumeroVenta</div>
                                            <div class="small text-muted">@v.Cliente</div>
                                        </div>
                                        <div class="fw-bold text-success">$@v.Total.ToString("N2")</div>
                                    </div>
                                    <div class="small text-muted">@v.Fecha.ToString("dd MMM, yyyy")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <h6 class="fw-bold mb-4 text-dark"><i class="bi bi-pie-chart text-primary me-2"></i>Top Vendidos</h6>
                    <div class="d-flex align-items-center justify-content-center h-100 pb-4">
                        @if (topProductos.Any())
                        {
                            <div class="w-100">
                                <ApexChart TItem="ProductoMasVendidoDto" Options="topProductosOptions" @key="topProductos.Count">
                                    <ApexPointSeries TItem="ProductoMasVendidoDto" Items="topProductos" Name="Cantidad" SeriesType="SeriesType.Donut" XValue="@(e => e.Nombre)" YValue="@(e => e.CantidadVendida)" />
                                </ApexChart>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state text-muted text-center">Aún no hay ventas registradas en este periodo</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    private bool loading = true;
    private string rangoSeleccionado = "mes";
    private DashboardStatsDto stats = new();
    private List<CashFlowDto> cashFlow = new();
    private List<ProductoMasVendidoDto> topProductos = new();
    private List<VentaRecienteDto> ventasRecientes = new();
    private List<ProductoBajoStockDto> productosBajoStock = new();
    private FinanzasResumenDto finanzas = new();
    private CajaResumenDto cajaResumen = new();
    private List<FlujoCajaRealDto> cashFlowReal = new();

    private ApexChartOptions<CashFlowDto> cashFlowOptions = new()
    {
        Chart = new Chart { Height = 340, Type = ChartType.Bar, Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "#4f46e5", "#f87171", "#10b981" },
        Stroke = new Stroke { Width = new List<double> { 0, 0, 4 }, Curve = Curve.Smooth },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 4, ColumnWidth = "45%" } },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Position = LegendPosition.Top, HorizontalAlign = Align.Right }
    };

    private ApexChartOptions<ProductoMasVendidoDto> topProductosOptions = new()
    {
        Chart = new Chart { Height = 320, Type = ChartType.Donut },
        Colors = new List<string> { "#4f46e5", "#6366f1", "#818cf8", "#a5b4fc", "#c7d2fe" },
        Legend = new Legend { Position = LegendPosition.Bottom },
        Stroke = new Stroke { Show = false }
    };

    private ApexChartOptions<FlujoCajaRealDto> cashFlowRealOptions = new()
    {
        Chart = new Chart { Height = 340, Type = ChartType.Bar, Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "#10b981", "#ef4444", "#0ea5e9" },
        Stroke = new Stroke { Width = new List<double> { 0, 0, 4 }, Curve = Curve.Smooth },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 4, ColumnWidth = "45%" } },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Position = LegendPosition.Top, HorizontalAlign = Align.Right }
    };

    protected override async Task LoadDataAsync()
    {
        await CargarDatos();
        loading = false;
    }

    protected override bool ShouldRetryInitialLoad()
        => !cashFlow.Any() && !ventasRecientes.Any() && !topProductos.Any();

    private async Task CargarDatos()
    {
        stats = await DashboardService.GetStatsAsync();
        cashFlow = await DashboardService.GetCashFlowAsync(6);
        topProductos = await DashboardService.GetProductosMasVendidosAsync(5);
        ventasRecientes = await DashboardService.GetVentasRecientesAsync(5);
        cajaResumen = await CajaHttpService.GetResumenAsync();
        cashFlowReal = await CajaHttpService.GetCashFlowRealAsync(6);
        finanzas = await DashboardService.GetFinanzasResumenAsync();
        var alertas = await DashboardService.GetAlertasAsync();
        productosBajoStock = alertas.ProductosBajoStock;
    }

    private string RangoSeleccionadoTexto => rangoSeleccionado switch
    {
        "hoy" => "Hoy",
        "7dias" => "Últimos 7 días",
        "mes" => "Este Mes",
        "anio" => "Este Año",
        _ => "Este Mes"
    };

    private async Task CambiarRango(string nuevoRango)
    {
        if (rangoSeleccionado == nuevoRango) return;

        rangoSeleccionado = nuevoRango;
        loading = true;
        StateHasChanged();
        await Task.Delay(50);
        await CargarDatos(rangoSeleccionado);
    }

    private async Task CargarDatos(string rango)
    {
        DateTime? fechaFiltro = null;
        DateTime hoy = DateTime.Today;
        cajaResumen = await CajaHttpService.GetResumenAsync();
        cashFlowReal = await CajaHttpService.GetCashFlowRealAsync(6);

        switch (rango)
        {
            case "hoy": fechaFiltro = hoy; break;
            case "7dias": fechaFiltro = hoy.AddDays(-7); break;
            case "mes": fechaFiltro = new DateTime(hoy.Year, hoy.Month, 1); break;
        }

        Console.WriteLine($"Cargando rango: {rango} - Fecha Inicio: {fechaFiltro?.ToString("yyyy-MM-dd")}");

        stats = await DashboardService.GetStatsAsync(fechaFiltro);
        cashFlow = await DashboardService.GetCashFlowAsync(6);
        topProductos = await DashboardService.GetProductosMasVendidosAsync(5);
        ventasRecientes = await DashboardService.GetVentasRecientesAsync(5);
        finanzas = await DashboardService.GetFinanzasResumenAsync();
        var alertas = await DashboardService.GetAlertasAsync();
        productosBajoStock = alertas.ProductosBajoStock;

        loading = false;
        StateHasChanged();
    }
}
