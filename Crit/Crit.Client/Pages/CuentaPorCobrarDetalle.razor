@page "/cuentas-por-cobrar/{Id:int}"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@attribute [StreamRendering(true)]
@rendermode @(new InteractiveWebAssemblyRenderMode(false))
@inject CuentaPorCobrarHttpService CuentaPorCobrarService
@inject NavigationManager Navigation

<PageTitle>Detalle Cuenta · @(cuenta?.Folio ?? "Cargando...")</PageTitle>

<div class="pos-container px-5 py-4">
    @if (cargando)
    {
        <div class="vh-100 d-flex flex-column justify-content-center align-items-center">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">Cargando detalles de la cuenta...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger shadow-sm border-start border-4 border-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @error
            <button class="btn btn-sm btn-outline-danger ms-3" @onclick="Volver">Regresar</button>
        </div>
    }
    else if (cuenta is not null)
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/cuentas-por-cobrar" class="text-decoration-none">Cuentas por Cobrar</a></li>
                        <li class="breadcrumb-item active">Detalle</li>
                    </ol>
                </nav>
                <h2 class="page-title mb-0">
                    <i class="bi bi-file-earmark-medical me-2 text-primary"></i>
                    @(string.IsNullOrWhiteSpace(cuenta.Folio) ? "Sin Folio" : cuenta.Folio)
                </h2>
                <span class="text-muted">Cliente: @cuenta.Cliente?.Nombre</span>
            </div>

            <button class="btn saas-btn-primary shadow-sm px-4 py-2" @onclick="Volver">
                <i class="bi bi-arrow-left me-2"></i>Volver al Listado
            </button>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm mb-4 rounded-4">
                    <div class="card-header bg-white py-3 border-bottom-0 px-4">
                        <h5 class="card-title mb-0 fw-bold">Resumen de Cuenta</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="row g-4">
                            <div class="col-6 col-md-3">
                                <label class="extra-small text-uppercase fw-bold text-muted d-block">Emisión</label>
                                <span class="fw-semibold">@cuenta.FechaEmision.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="extra-small text-uppercase fw-bold text-muted d-block">Vencimiento</label>
                                <span class="fw-semibold @(cuenta.EstaVencida ? "text-danger" : "")">
                                    @(cuenta.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "N/A")
                                </span>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="extra-small text-uppercase fw-bold text-muted d-block">Estado</label>
                                <span class="@ObtenerBadgeEstado(cuenta.Estado)">@cuenta.Estado</span>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="extra-small text-uppercase fw-bold text-muted d-block">Días Vencidos</label>
                                <span class="fw-bold @(cuenta.EstaVencida ? "text-danger" : "text-success")">
                                    @(cuenta.EstaVencida? cuenta.DiasVencidos: 0) días
                                </span>
                            </div>

                            <div class="col-12 mt-2">
                                <hr class="text-secondary opacity-25" />
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="summary-stat summary-stat-neutral">
                                    <label class="extra-small text-uppercase fw-bold text-muted d-block">Total Factura</label>
                                    <span class="summary-stat-value text-dark">@cuenta.Total.ToString("C")</span>
                                </div>
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="summary-stat summary-stat-success">
                                    <label class="extra-small text-uppercase fw-bold text-success d-block">Abonado</label>
                                    <span class="summary-stat-value text-success">@cuenta.TotalPagado.ToString("C")</span>
                                </div>
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="summary-stat summary-stat-primary">
                                    <label class="extra-small text-uppercase fw-bold text-primary d-block">Saldo Pendiente</label>
                                    <span class="summary-stat-value text-primary">@cuenta.Saldo.ToString("C")</span>
                                </div>
                            </div>
                        </div>

                        @if (cuenta.EstaVencida)
                        {
                            <div class="alert alert-warning mt-4 mb-0 border-0 shadow-sm d-flex align-items-center">
                                <i class="bi bi-clock-history fs-4 me-3"></i>
                                <div>
                                    <strong>Atención:</strong> Esta cuenta superó su fecha límite de pago por @cuenta.DiasVencidos días.
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-none d-lg-block card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Historial de abonos</h5>

                        @if (cuenta.Pagos is null || !cuenta.Pagos.Any(p => p.Activo))
                        {
                            <div class="text-muted">No hay abonos registrados.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Método</th>
                                            <th>Referencia</th>
                                            <th class="text-end">Monto</th>
                                            <th class="text-end">Saldo anterior</th>
                                            <th class="text-end">Saldo posterior</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var pago in cuenta.Pagos.Where(x => x.Activo).OrderByDescending(x => x.FechaPago))
                                        {
                                            <tr>
                                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@(string.IsNullOrWhiteSpace(pago.MetodoPago) ? "-" : pago.MetodoPago)</td>
                                                <td>@(string.IsNullOrWhiteSpace(pago.Referencia) ? "-" : pago.Referencia)</td>
                                                <td class="text-end fw-semibold text-success">@pago.Monto.ToString("C")</td>
                                                <td class="text-end">@pago.SaldoAnterior.ToString("C")</td>
                                                <td class="text-end">@pago.SaldoPosterior.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-lg-none">
                    @if (cuenta.Pagos is null || !cuenta.Pagos.Any(p => p.Activo))
                    {
                        <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                            <p class="text-muted mb-0">No hay abonos registrados.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var pago in cuenta.Pagos.Where(x => x.Activo).OrderByDescending(x => x.FechaPago))
                        {
                            <div class="card shadow-sm border-0 mb-3 receivable-mobile-card">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">@pago.MetodoPago</h6>
                                            <span class="extra-small text-muted">@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        <div class="fw-bold text-success">@pago.Monto.ToString("C")</div>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="text-muted extra-small">Referencia</div>
                                            <div class="small text-dark">@(string.IsNullOrWhiteSpace(pago.Referencia) ? "-" : pago.Referencia)</div>
                                        </div>
                                        <div class="col-6 text-end">
                                            <div class="text-muted extra-small">Saldo Posterior</div>
                                            <div class="small text-dark">@pago.SaldoPosterior.ToString("C")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 rounded-4 sticky-top payment-ticket-card">
                    <div class="card-header text-white border-0 py-3 px-4 payment-ticket-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-cash-coin me-2"></i>Registrar Nuevo Abono
                            </h6>
                            <span class="badge payment-badge">@cuenta.Saldo.ToString("C")</span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        @if (!string.IsNullOrWhiteSpace(mensaje))
                        {
                            <div class="alert alert-success border-0 shadow-sm mb-3">
                                <i class="bi bi-check-circle-fill me-2"></i> @mensaje
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(errorPago))
                        {
                            <div class="alert alert-danger border-0 shadow-sm mb-3">
                                <i class="bi bi-x-circle-fill me-2"></i> @errorPago
                            </div>
                        }

                        @if (cuenta.Estado == "Pagada" || cuenta.Estado == "Cancelada")
                        {
                            <div class="text-center py-4">
                                <div class="display-6 text-muted mb-2"><i class="bi bi-lock-fill"></i></div>
                                <p class="text-muted fw-bold">Esta cuenta está @cuenta.Estado.ToLower() y no admite más abonos.</p>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="nuevoPago" OnSubmit="RegistrarPagoManualAsync">
                                <DataAnnotationsValidator />

                                <div class="payment-form">
                                    <div class="mb-3">
                                        <label class="payment-label">Fecha del Pago</label>
                                        <InputDate class="form-control payment-input" @bind-Value="nuevoPago.FechaPago" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="payment-label">Monto a Abonar</label>
                                        <div class="input-group payment-money-group">
                                            <span class="input-group-text bg-white border-end-0 text-success fw-bold">$</span>
                                            <InputNumber class="form-control border-start-0 payment-money-input fw-bold"
                                                         @bind-Value="nuevoPago.Monto"
                                                         placeholder="0.00" />
                                        </div>
                                        <div class="form-text extra-small text-end mt-1">
                                            Saldo pendiente: <strong>@cuenta.Saldo.ToString("C")</strong>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="payment-label">Método de Pago</label>
                                        <InputSelect class="form-select payment-input" @bind-Value="nuevoPago.MetodoPago">
                                            <option value="">Seleccione...</option>
                                            <option value="Efectivo">Efectivo</option>
                                            <option value="Transferencia">Transferencia</option>
                                            <option value="Tarjeta">Tarjeta de Crédito/Débito</option>
                                            <option value="Cheque">Cheque</option>
                                        </InputSelect>
                                    </div>

                                    <div class="mb-3">
                                        <label class="payment-label">Referencia / Folio Pago</label>
                                        <InputText class="form-control payment-input" @bind-Value="nuevoPago.Referencia" placeholder="Opcional..." />
                                    </div>

                                    <div class="mb-4">
                                        <label class="payment-label">Observaciones</label>
                                        <InputTextArea class="form-control payment-input" @bind-Value="nuevoPago.Observaciones" rows="2" />
                                    </div>

                                    <button type="submit" class="btn saas-btn-primary w-100 payment-submit shadow-sm fw-bold" disabled="@guardandoPago">
                                        @if (guardandoPago)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Procesando...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check2-circle me-2"></i>
                                            <span>Confirmar Abono</span>
                                        }
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter] public int Id { get; set; }

    private CuentaPorCobrar? cuenta;
    private bool cargando = true;
    private bool guardandoPago;
    private string? error;
    private string? errorPago;
    private string? mensaje;

    private PagoCliente nuevoPago = new() { FechaPago = DateTime.Today };

    protected override async Task LoadDataAsync()
    {
        await CargarCuentaAsync();
    }

    protected override bool ShouldRetryInitialLoad() => cuenta is null && string.IsNullOrWhiteSpace(error);

    protected override async Task OnParametersSetAsync()
    {
        if (!IsLoading)
        {
            await CargarCuentaAsync();
        }
    }

    private async Task CargarCuentaAsync()
    {
        cargando = true;
        error = null;
        mensaje = null;
        errorPago = null;

        try
        {
            cuenta = await CuentaPorCobrarService.GetByIdAsync(Id);
            if (cuenta is null) error = "La cuenta no fue encontrada.";
        }
        catch (Exception ex)
        {
            error = $"Error al cargar: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task RegistrarPagoManualAsync(EditContext _)
    {
        if (cuenta is null) return;

        errorPago = null;
        mensaje = null;

        if (nuevoPago.Monto <= 0)
        {
            errorPago = "El monto debe ser mayor a cero.";
            return;
        }

        if (nuevoPago.Monto > cuenta.Saldo)
        {
            errorPago = "El abono excede el saldo pendiente.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoPago.MetodoPago))
        {
            errorPago = "Seleccione un método de pago.";
            return;
        }

        try
        {
            guardandoPago = true;
            var ok = await CuentaPorCobrarService.RegistrarPagoAsync(cuenta.Id, nuevoPago);

            if (!ok)
            {
                errorPago = "No se pudo procesar el pago.";
                return;
            }

            mensaje = "¡Abono registrado con éxito!";
            nuevoPago = new PagoCliente
            {
                FechaPago = DateTime.Today
            };

            await CargarCuentaAsync();
        }
        catch (Exception ex)
        {
            errorPago = $"Error: {ex.Message}";
        }
        finally
        {
            guardandoPago = false;
        }
    }

    private void Volver() => Navigation.NavigateTo("/cuentas-por-cobrar");

    private static string ObtenerBadgeEstado(string? estado) => estado switch
    {
        "Pagada" => "badge rounded-pill text-bg-success-subtle text-success border border-success",
        "Parcial" => "badge rounded-pill text-bg-warning-subtle text-warning-emphasis border border-warning",
        "Vencida" => "badge rounded-pill text-bg-danger-subtle text-danger border border-danger",
        "Cancelada" => "badge rounded-pill text-bg-secondary-subtle text-secondary border border-secondary",
        _ => "badge rounded-pill text-bg-primary-subtle text-primary border border-primary"
    };
}
