@page "/proveedores/{Id:int}"
@using Crit.Client.Services
@using Crit.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inherits ProtectedPageBase
@attribute [Authorize(Roles = "Admin,Supervisor")]
@inject ProveedorHttpService ProveedorHttpService
@inject CompraHttpService CompraHttpService
@inject CuentaPorPagarHttpService CuentaPorPagarHttpService
@inject NavigationManager Navigation

<PageTitle>Detalle Proveedor</PageTitle>

<div class="pos-container px-5 py-4">
    @if (cargando)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">Cargando expediente del proveedor...</p>
        </div>
    }
    else if (proveedor is null)
    {
        <div class="text-center py-5">
            <i class="bi bi-building-x fs-1 text-warning mb-3"></i>
            <h4 class="text-muted">Proveedor no encontrado</h4>
            <button class="btn btn-outline-primary mt-3" @onclick="Volver">Regresar al listado</button>
        </div>
    }
    else
    {
        <div class="hero-card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4 p-lg-5">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="supplier-avatar shadow-sm">
                            <i class="bi bi-buildings"></i>
                        </div>

                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h2 class="page-title mb-0">@proveedor.Nombre</h2>
                                <span class="status-pill @(proveedor.Activo ? "status-pill-active" : "status-pill-inactive")">
                                    @(proveedor.Activo ? "Activo" : "Inactivo")
                                </span>
                            </div>

                            <p class="text-muted mb-2">
                                @(string.IsNullOrWhiteSpace(proveedor.RazonSocial) ? "Proveedor registrado en el directorio" : proveedor.RazonSocial)
                            </p>

                            <div class="d-flex flex-wrap gap-3 supplier-meta">
                                <span>
                                    <i class="bi bi-envelope me-2"></i>@(string.IsNullOrWhiteSpace(proveedor.Email) ? "Sin correo registrado" : proveedor.Email)
                                </span>
                                <span>
                                    <i class="bi bi-telephone me-2"></i>@(string.IsNullOrWhiteSpace(proveedor.Telefono) ? "Sin teléfono" : proveedor.Telefono)
                                </span>
                                <span>
                                    <i class="bi bi-upc-scan me-2"></i>@(string.IsNullOrWhiteSpace(proveedor.RFC) ? "RFC no capturado" : proveedor.RFC)
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-soft-warning shadow-sm" href="/cuentas-por-pagar?proveedorId=@proveedor.Id">
                            <i class="bi bi-wallet2 me-2"></i>Cuentas por pagar
                        </a>
                        <button class="btn btn-light border shadow-sm" @onclick="Volver">
                            <i class="bi bi-arrow-left me-2"></i>Volver
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-danger-subtle text-danger me-3">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Saldo por pagar</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-danger">@saldoTotal.ToString("C")</h3>
                        <div class="extra-small text-muted mt-2">Compromiso actual con este proveedor</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-info-subtle text-info me-3">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Cuentas activas</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-info">@cuentasActivas</h3>
                        <div class="extra-small text-muted mt-2">Facturas con saldo pendiente</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-warning-subtle text-warning me-3">
                                <i class="bi bi-exclamation-octagon"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Vencidas</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-warning">@cuentasVencidas</h3>
                        <div class="extra-small text-muted mt-2">Cuentas que ya rebasaron vencimiento</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="card stat-card border-0 shadow-sm h-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stat-icon bg-success-subtle text-success me-3">
                                <i class="bi bi-bag-check"></i>
                            </div>
                            <span class="text-muted fw-bold small text-uppercase">Total Compras</span>
                        </div>
                        <h3 class="fw-bold mb-0 text-success">@compras.Count</h3>
                        <div class="extra-small text-muted mt-2">Operaciones registradas con este proveedor</div>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-pills custom-pills mb-4 gap-2">
            <li class="nav-item">
                <button class="nav-link @(tab == "datos" ? "active shadow-sm" : "")" @onclick='() => tab = "datos"'>
                    <i class="bi bi-card-text me-2"></i>Datos Generales
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tab == "compras" ? "active shadow-sm" : "")" @onclick='() => tab = "compras"'>
                    <i class="bi bi-cart4 me-2"></i>Compras
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tab == "cxp" ? "active shadow-sm" : "")" @onclick='() => tab = "cxp"'>
                    <i class="bi bi-wallet2 me-2"></i>Cuentas por pagar
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tab == "pagos" ? "active shadow-sm" : "")" @onclick='() => tab = "pagos"'>
                    <i class="bi bi-check2-circle me-2"></i>Pagos Realizados
                </button>
            </li>
        </ul>

        @if (tab == "datos")
        {
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 border-bottom-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-info-circle me-2"></i>Información Fiscal y de Contacto</h6>
                </div>

                <div class="card-body px-4 pb-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="detail-box">
                                <span class="detail-label">RFC</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(proveedor.RFC) ? "N/A" : proveedor.RFC)</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="detail-box">
                                <span class="detail-label">Teléfono</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(proveedor.Telefono) ? "N/A" : proveedor.Telefono)</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="detail-box">
                                <span class="detail-label">Contacto Principal</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(proveedor.Contacto) ? "N/A" : proveedor.Contacto)</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="detail-box">
                                <span class="detail-label">Régimen Fiscal</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(proveedor.RegimenFiscal) ? "N/A" : proveedor.RegimenFiscal)</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="detail-box">
                                <span class="detail-label">Dirección Completa</span>
                                <div class="detail-value">
                                    <i class="bi bi-geo-alt text-primary me-2"></i>@(string.IsNullOrWhiteSpace(proveedor.Direccion) ? "Sin dirección registrada" : proveedor.Direccion)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (tab == "compras")
        {
            <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
                @if (!compras.Any())
                {
                    <div class="text-center py-5">
                        <p class="text-muted mb-0">No hay compras registradas para este proveedor.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8fafc;">
                                <tr>
                                    <th class="ps-4">Factura</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var compra in compras.OrderByDescending(x => x.Fecha))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-light text-dark border fw-bold">
                                                <i class="bi bi-file-earmark-text text-primary me-1"></i>@compra.SerieFactura-@compra.FolioFactura
                                            </span>
                                        </td>
                                        <td class="small">@compra.Fecha.ToString("dd MMM yyyy")</td>
                                        <td class="fw-semibold">@compra.Total.ToString("C")</td>
                                        <td>
                                            <span class="badge rounded-pill text-bg-light border">@compra.Estado</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="d-lg-none">
                @if (!compras.Any())
                {
                    <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                        <p class="text-muted mb-0">No hay compras registradas para este proveedor.</p>
                    </div>
                }
                else
                {
                    @foreach (var compra in compras.OrderByDescending(x => x.Fecha))
                    {
                        <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div style="max-width: 70%;">
                                        <h6 class="fw-bold mb-0 text-dark">@compra.SerieFactura-@compra.FolioFactura</h6>
                                        <span class="extra-small text-muted">@compra.Fecha.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <span class="badge rounded-pill text-bg-light border">@compra.Estado</span>
                                </div>

                                <div class="fw-bold text-success">@compra.Total.ToString("C")</div>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @if (tab == "cxp")
        {
            <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
                @if (!cuentas.Any())
                {
                    <div class="text-center py-5">
                        <p class="text-muted mb-0">No hay cuentas por pagar registradas.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8fafc;">
                                <tr>
                                    <th class="ps-4">Folio Factura</th>
                                    <th>Emisión</th>
                                    <th>Vencimiento</th>
                                    <th>Total</th>
                                    <th>Pagado</th>
                                    <th>Saldo</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cuenta in cuentas.OrderByDescending(x => x.FechaEmision))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <a class="text-decoration-none fw-bold" href="/cuentas-por-pagar/@cuenta.Id">
                                                <i class="bi bi-box-arrow-up-right me-1 small"></i>@cuenta.FolioFactura
                                            </a>
                                        </td>
                                        <td class="small">@cuenta.FechaEmision.ToString("dd/MM/yyyy")</td>
                                        <td class="small @(cuenta.EstaVencida ? "text-danger fw-bold" : "")">
                                            @(cuenta.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "-")
                                        </td>
                                        <td class="fw-semibold">@cuenta.Total.ToString("C")</td>
                                        <td class="text-success">@cuenta.TotalPagado.ToString("C")</td>
                                        <td>
                                            <span class="fw-bold @(cuenta.Saldo > 0 ? "text-danger" : "text-muted")">
                                                @cuenta.Saldo.ToString("C")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill text-bg-light border">@cuenta.Estado</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="d-lg-none">
                @if (!cuentas.Any())
                {
                    <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                        <p class="text-muted mb-0">No hay cuentas por pagar registradas.</p>
                    </div>
                }
                else
                {
                    @foreach (var cuenta in cuentas.OrderByDescending(x => x.FechaEmision))
                    {
                        <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div style="max-width: 70%;">
                                        <h6 class="fw-bold mb-0 text-dark">@cuenta.FolioFactura</h6>
                                        <span class="extra-small text-muted">@cuenta.FechaEmision.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <span class="badge rounded-pill text-bg-light border">@cuenta.Estado</span>
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-4">
                                        <div class="text-muted extra-small">Total</div>
                                        <div class="small fw-semibold">@cuenta.Total.ToString("C")</div>
                                    </div>
                                    <div class="col-4 text-center">
                                        <div class="text-muted extra-small">Pagado</div>
                                        <div class="small text-success">@cuenta.TotalPagado.ToString("C")</div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="text-muted extra-small">Saldo</div>
                                        <div class="small fw-bold text-danger">@cuenta.Saldo.ToString("C")</div>
                                    </div>
                                </div>

                                @if (cuenta.EstaVencida)
                                {
                                    <div class="extra-small text-danger fw-bold">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Cuenta vencida
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @if (tab == "pagos")
        {
            <div class="d-none d-lg-block card shadow-sm border-0 rounded-4 overflow-hidden">
                @if (!pagosProveedor.Any())
                {
                    <div class="text-center py-5">
                        <p class="text-muted mb-0">No se han registrado pagos para este proveedor.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background-color: #f8fafc;">
                                <tr>
                                    <th class="ps-4">Fecha y Hora</th>
                                    <th>Método</th>
                                    <th>Referencia</th>
                                    <th>Monto</th>
                                    <th>ID Cuenta (CXP)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in pagosProveedor)
                                {
                                    <tr>
                                        <td class="ps-4 small">
                                            <i class="bi bi-calendar-check text-success me-2"></i>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@pago.MetodoPago</span>
                                        </td>
                                        <td class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(pago.Referencia) ? "Sin referencia" : pago.Referencia)
                                        </td>
                                        <td class="text-success fw-bold">@pago.Monto.ToString("C")</td>
                                        <td>
                                            <a href="/cuentas-por-pagar/@pago.CuentaPorPagarId" class="text-decoration-none">
                                                <i class="bi bi-link-45deg"></i> Ver CXP
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="d-lg-none">
                @if (!pagosProveedor.Any())
                {
                    <div class="card shadow-sm border-0 text-center py-5 rounded-4">
                        <p class="text-muted mb-0">No se han registrado pagos para este proveedor.</p>
                    </div>
                }
                else
                {
                    @foreach (var pago in pagosProveedor)
                    {
                        <div class="card shadow-sm border-0 mb-3 detail-mobile-card">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div style="max-width: 70%;">
                                        <h6 class="fw-bold mb-0 text-dark">@pago.MetodoPago</h6>
                                        <span class="extra-small text-muted">@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <div class="fw-bold text-success">@pago.Monto.ToString("C")</div>
                                </div>

                                <div class="small text-muted mb-2">
                                    @(string.IsNullOrWhiteSpace(pago.Referencia) ? "Sin referencia" : pago.Referencia)
                                </div>

                                <a href="/cuentas-por-pagar/@pago.CuentaPorPagarId" class="text-decoration-none small">
                                    <i class="bi bi-link-45deg"></i> Ver CXP
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<style>
    .pos-container {
        min-height: 100vh;
        padding-bottom: 80px;
    }

    .hero-card {
        background: radial-gradient(circle at top right, rgba(59,130,246,0.10), transparent 28%), linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    }

    .supplier-avatar {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.65rem;
        flex-shrink: 0;
    }

    .supplier-meta {
        color: #64748b;
        font-size: 0.92rem;
    }

        .supplier-meta span {
            display: inline-flex;
            align-items: center;
        }

    .status-pill {
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .status-pill-active {
        background: #dcfce7;
        color: #166534;
    }

    .status-pill-inactive {
        background: #e2e8f0;
        color: #475569;
    }

    .btn-soft-warning {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

        .btn-soft-warning:hover {
            background: #fef3c7;
            color: #92400e;
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.4rem;
    }

    .stat-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.06) !important;
        }

    .custom-pills .nav-link {
        border-radius: 999px;
        font-weight: 600;
        color: #334155;
        background: #fff;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

        .custom-pills .nav-link:hover:not(.active) {
            background: #f8fafc;
        }

        .custom-pills .nav-link.active {
            background: #1F2A44;
            color: #fff;
            border-color: #1F2A44;
        }

    .detail-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        padding: 1rem;
        height: 100%;
    }

    .detail-label {
        display: block;
        font-size: 0.72rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #94a3b8;
        margin-bottom: 0.35rem;
    }

    .detail-value {
        color: #0f172a;
        font-weight: 600;
    }

    .table thead th {
        font-weight: 600;
        letter-spacing: 0.5px;
        border-top: none;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .detail-mobile-card {
        border-left: 4px solid #e2e8f0 !important;
    }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private Proveedor? proveedor;
    private List<Compra> compras = new();
    private List<CuentaPorPagar> cuentas = new();
    private List<PagoProveedor> pagosProveedor = new();
    private bool cargando = true;
    private string tab = "datos";

    private decimal saldoTotal => cuentas.Where(x => x.Activa && x.Saldo > 0).Sum(x => x.Saldo);
    private int cuentasActivas => cuentas.Count(x => x.Activa && x.Saldo > 0);
    private int cuentasVencidas => cuentas.Count(x => x.Activa && x.EstaVencida && x.Saldo > 0);

    protected override async Task LoadDataAsync()
    {
        await CargarProveedorAsync();
    }

    protected override bool ShouldRetryInitialLoad() => proveedor is null;

    private async Task CargarProveedorAsync()
    {
        cargando = true;

        try
        {
            proveedor = await ProveedorHttpService.GetByIdAsync(Id);
            compras = await CompraHttpService.GetByProveedorAsync(Id);
            cuentas = await CuentaPorPagarHttpService.GetByProveedorAsync(Id);

            pagosProveedor = cuentas
                .SelectMany(x => x.Pagos ?? new List<PagoProveedor>())
                .Where(x => x.Activo)
                .OrderByDescending(x => x.FechaPago)
                .ToList();
        }
        finally
        {
            cargando = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsLoading)
        {
            await CargarProveedorAsync();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/proveedores");
    }
}
